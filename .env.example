# Copy to `.env` and set your real production URL (no trailing slash).
# Used at build time for `site`, sitemap absolute URLs, and canonical resolution.
PUBLIC_SITE_URL=https://example.com

# Gallery photographer login (set in Vercel project env + local .env / .env.local)
GALLERY_PASSWORD=change-me
# Long random string, e.g. openssl rand -hex 32
GALLERY_SESSION_SECRET=replace-with-long-random-secret

# Vercel Blob — usually pulled via `vercel env pull` after connecting a Public Blob store
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Protects Vercel Cron routes (/api/cron/digest, /api/cron/sync-brackets).
# Vercel sends `Authorization: Bearer $CRON_SECRET` on scheduled invocations.
# Required for the 5-minute live bracket sync. Pro plan is also required:
# Hobby only allows daily crons, and `*/5 * * * *` will fail the deploy.
# CRON_SECRET=

# Player accounts (Supabase): project URL + anon key are public; service role stays server-only.
# The code also accepts SUPABASE_URL / SUPABASE_ANON_KEY / SERVICE_ROLE_KEY (the names used in Vercel).
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails that get the /admin queue and gallery upload rights.
ADMIN_EMAILS=info@thebrobot.com
