---
import Seo from '../components/seo/Seo.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	canonical?: string;
	ogImage?: string;
	noindex?: boolean;
	siteName?: string;
	/** Full-width pages (no narrow main column); use for marketing/landing layouts */
	fullBleed?: boolean;
	/** Early-fetch LCP-related images (paths under /public) */
	imagePreloads?: string[];
}

const { fullBleed = false, imagePreloads = [], ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<Seo {...seo} />
		{imagePreloads.map((href) => <link rel="preload" href={href} as="image" />)}
		{
			fullBleed && (
				<>
					<meta name="theme-color" content="#0a1628" />
					<link rel="preconnect" href="https://fonts.googleapis.com" />
					<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
					<link
						href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@400;500;600&display=swap"
						rel="stylesheet"
					/>
					<script src="../scripts/grand-prix-client.ts"></script>
				</>
			)
		}
	</head>
	<body class:list={[{ 'site-fullbleed': fullBleed }]}>
		<main>
			<slot />
		</main>
	</body>
</html>
