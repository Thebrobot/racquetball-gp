---
import BaseLayout from './BaseLayout.astro';
import '../styles/grand-prix.css';
import GrandPrixNav from '../components/grand-prix/GrandPrixNav.astro';
import TournamentWeekendPromo from '../components/grand-prix/TournamentWeekendPromo.astro';
import LeaderboardUpdateModal from '../components/grand-prix/LeaderboardUpdateModal.astro';
import GrandPrixFooter from '../components/grand-prix/GrandPrixFooter.astro';
import SponsorSpotlight from '../components/grand-prix/SponsorSpotlight.astro';

interface Props {
	title: string;
	description: string;
	siteName?: string;
	ogImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	spotlightName?: string;
	spotlightBlurb?: string;
	spotlightLabel?: string;
	spotlightLogoUrl?: string;
	imagePreloads?: string[];
	hideSponsorSpotlight?: boolean;
	noindex?: boolean;
}

const {
	title,
	description,
	siteName = 'Florida Racquetball Grand Prix',
	ogImage = '/images/og-default.webp',
	ogImageWidth = 1200,
	ogImageHeight = 630,
	spotlightName,
	spotlightBlurb,
	spotlightLabel,
	spotlightLogoUrl,
	imagePreloads,
	hideSponsorSpotlight = false,
	noindex = false,
} = Astro.props;
---

<BaseLayout {title} {description} {siteName} {ogImage} {ogImageWidth} {ogImageHeight} {noindex} fullBleed imagePreloads={imagePreloads}>
	<div class="gp-site">
		<GrandPrixNav />
		<TournamentWeekendPromo />
		<LeaderboardUpdateModal />
		<slot />
		{
			!hideSponsorSpotlight && spotlightName && spotlightBlurb && (
				<SponsorSpotlight
					label={spotlightLabel}
					name={spotlightName}
					blurb={spotlightBlurb}
					logoUrl={spotlightLogoUrl}
				/>
			)
		}
		<GrandPrixFooter />
	</div>
</BaseLayout>
