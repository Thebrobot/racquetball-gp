---
import { titleSponsor } from '../../data/ocala-sponsors';
---

<section class="title-sponsor-intro" aria-labelledby="title-sponsor-heading">
	<div class="title-sponsor-intro-shell">
		<div class="title-sponsor-intro-media title-sponsor-intro-media--banner">
			<img
				class="title-sponsor-team-photo"
				src="/images/rapha/team.webp"
				alt="Rapha International team at a ribbon-cutting celebration"
				width="1600"
				height="900"
				loading="lazy"
				decoding="async"
			/>
			<div class="title-sponsor-banner-scrim" aria-hidden="true"></div>
			<div class="title-sponsor-banner-content">
				<div class="title-sponsor-hero-row title-sponsor-hero-row--overlay">
					<a
						class="title-sponsor-logo-link"
						href={titleSponsor.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`${titleSponsor.name}, visit ${titleSponsor.url}`}
					>
						<img
							class="title-sponsor-logo"
							src="/images/rapha/logo.webp"
							alt=""
							width="256"
							height="256"
							decoding="async"
						/>
					</a>
					<div class="title-sponsor-hero-text">
						<p class="title-sponsor-kicker">Title sponsor</p>
						<h2 id="title-sponsor-heading" class="title-sponsor-name">
							Rapha <span class="title-sponsor-name-light">International</span>
						</h2>
					</div>
				</div>
			</div>
		</div>

		<div class="title-sponsor-intro-body">
			<p class="title-sponsor-thanks">
				We are deeply grateful to Rapha International for standing with the Florida Racquetball Grand Prix.
				Their partnership helps us invest in players, events, and visibility for the sport across the state,
				and we are honored to align our series with an organization devoted to healing, hope, and freedom for
				vulnerable children and families.
			</p>

			<div class="title-sponsor-mv-grid">
				<div class="title-sponsor-mv-card">
					<h3 class="title-sponsor-mv-label">Mission</h3>
					<p class="title-sponsor-mv-text">
						Rapha combats child trafficking and sexual abuse through holistic care for survivors, prevention
						services for vulnerable children, and support for families and communities, with high-quality
						programs in Cambodia, Thailand, Haiti, and the United States.
					</p>
				</div>
				<div class="title-sponsor-mv-card">
					<h3 class="title-sponsor-mv-label">Vision</h3>
					<p class="title-sponsor-mv-text">
						Rapha is a movement to protect children, promote healing, and build stronger families and
						communities. A vision rooted in the name <em>Rapha</em>, &ldquo;healing&rdquo; in Hebrew, and
						in the belief that lasting change happens through compassion, dignity, and sustained care.
					</p>
				</div>
			</div>

			<div class="title-sponsor-actions">
				<a
					class="title-sponsor-cta title-sponsor-cta-primary"
					href={titleSponsor.url}
					target="_blank"
					rel="noopener noreferrer"
				>
					Visit Rapha International →
				</a>
				<a class="title-sponsor-cta" href="/sponsors">Partner with the Grand Prix →</a>
			</div>
		</div>
	</div>
</section>
