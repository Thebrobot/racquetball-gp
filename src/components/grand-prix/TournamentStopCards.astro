---
import { SEASON_STOPS, TOUR_STOP_COUNT } from '../../data/season-stops';

function pill(kind: (typeof SEASON_STOPS)[number]['kind']) {
	if (kind === 'done') return { cls: 'pill-done', label: 'Completed' };
	if (kind === 'next') return { cls: 'pill-next', label: 'Register Now' };
	return { cls: 'pill-pending', label: 'Registration Pending' };
}

function registerCtaLabel(url: string): string {
	return url.includes('r2sports.com') ? 'Register on R2' : 'Register →';
}
---

<div class="tournaments-grid tournaments-grid--tiles">
	{
		SEASON_STOPS.map((stop, index) => {
			const p = pill(stop.kind);
			const n = index + 1;
			const badge =
				stop.kind === 'next'
					? `Stop ${n} of ${TOUR_STOP_COUNT} · Marquee`
					: `Stop ${n} of ${TOUR_STOP_COUNT}`;
			const regClosed = stop.kind === 'done';
			const regPending = stop.kind === 'upcoming';
			return (
				<div
					class:list={['t-card', 't-card--with-stop-img', { featured: stop.kind === 'next' }]}
					data-stop-id={stop.id}
					style={{ '--stop-img': `url("${stop.image}")` }}
				>
					<div class="t-card-media" aria-hidden="true">
						<div class="t-card-media-bg" />
					</div>
					<div class="t-card-head">
						<div>
							<div class="t-stop-badge">{badge}</div>
							<div class="t-name">{stop.eventName}</div>
							<div class="t-date">{stop.dateFull}</div>
						</div>
						<span class:list={['t-pill', p.cls]}>{p.label}</span>
					</div>
					<div class="t-body">
					<div class="t-meta">
						<div class="t-meta-item">
							<strong>{stop.venue}</strong>Venue
						</div>
						<div class="t-meta-item">
							<strong>Grand Prix points</strong>Awarded at this stop
						</div>
					</div>
						<div class="t-actions">
						{regClosed ? (
							<span class="btn-register disabled">Registration Closed</span>
						) : regPending ? (
							<a
								href={stop.registerUrl}
								class="btn-register-pending"
								target="_blank"
								rel="noopener noreferrer"
							>
								View on R2
							</a>
						) : (
							<a
								href={stop.registerUrl}
								class="btn-register"
								target={stop.registerUrl.startsWith('http') ? '_blank' : undefined}
								rel={stop.registerUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
							>
								{registerCtaLabel(stop.registerUrl)}
							</a>
						)}
						{stop.bracketsHref ? (
							<a href={stop.bracketsHref} class="btn-brackets">
								Brackets
							</a>
						) : (
							<span class="btn-brackets disabled" aria-disabled="true">Brackets</span>
						)}
						{stop.participantsHref ? (
							<a href={stop.participantsHref} class="btn-participants">
								Participants
							</a>
						) : (
							<span class="btn-participants disabled" aria-disabled="true">Participants</span>
						)}
						</div>
					</div>
	
				</div>
			);
		})
	}
</div>
