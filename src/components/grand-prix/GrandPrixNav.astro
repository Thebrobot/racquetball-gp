---
const raw = Astro.url.pathname.replace(/\/$/, '') || '/';
const path = raw === '' ? '/' : raw;

function active(href: string): string {
	const isHome = href === '/';
	if (isHome) return path === '/' ? 'active' : '';
	if (href === '/leaderboard') {
		return path === '/leaderboard' || path.startsWith('/leaderboard/') ? 'active' : '';
	}
	if (href === '/gallery') {
		return path === '/gallery' || (path.startsWith('/gallery/') && !path.startsWith('/gallery/admin'))
			? 'active'
			: '';
	}
	if (href === '/live') {
		return path === '/live' || path.startsWith('/live/') ? 'active' : '';
	}
	return path === href ? 'active' : '';
}

---

<div class="gp-nav-wrap">
	<div class="nav-drawer-backdrop" aria-hidden="true"></div>
	<nav class="nav-pill" aria-label="Main navigation">
		<a class="nav-brand" href="/">
			<img
				src="/images/website-logo.webp"
				alt="Racquetball Grand Prix"
				width="1000"
				height="200"
				fetchpriority="high"
				decoding="async"
			/>
		</a>
		<button
			type="button"
			class="nav-menu-toggle"
			id="gp-nav-menu-btn"
			aria-expanded="false"
			aria-controls="gp-primary-nav"
		>
			<span class="nav-menu-bars" aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
			</span>
			<span class="visually-hidden">Open menu</span>
		</button>
		<div class="nav-links" id="gp-primary-nav">
			<div class="nav-drawer-head">
				<button type="button" class="nav-drawer-close" id="gp-nav-drawer-close" aria-label="Close menu">
					<span aria-hidden="true">×</span>
				</button>
				<a class="nav-drawer-logo-link" href="/" tabindex="-1" aria-hidden="true">
					<img
						src="/images/website-logo.webp"
						alt=""
						width="1000"
						height="200"
					/>
				</a>
			</div>
			<a href="/" class:list={[active('/')]} data-key="home">Home</a>
			<a href="/tournaments" class:list={[active('/tournaments')]} data-key="tournaments">Tournaments</a>
			<a href="/points" class:list={[active('/points')]} data-key="points">Points</a>
			<a href="/leaderboard" class:list={[active('/leaderboard')]} data-key="leaderboard">Leaderboard</a>
			<a href="/sponsors" class:list={[active('/sponsors')]} data-key="sponsors">Sponsors</a>
			<a href="/gallery" class:list={[active('/gallery')]} data-key="gallery">Gallery</a>
			<a
				href="/live"
				id="gp-nav-live"
				class:list={['nav-live', active('/live')]}
				data-key="live"
				aria-current={path.startsWith('/live') ? 'page' : undefined}
			>
				<span class="nav-live-label">Live</span>
				<span class="nav-live-dot" aria-hidden="true"></span>
			</a>
			<div class="nav-drawer-sep" aria-hidden="true"></div>
			<div class="nav-drawer-footer">
				<div class="nav-drawer-account">
					<a class:list={['nav-account', active('/account')]} href="/account" id="gp-nav-account" data-signed-out-label="Sign in">
						<span class="nav-account-avatar" id="gp-nav-account-avatar" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
						</span>
						<span class="nav-account-label" id="gp-nav-account-label">Sign in</span>
					</a>
					<a class="nav-account-create" id="gp-nav-create" href="/signup">Create account</a>
				</div>
				<a class:list={['nav-register', active('/contact')]} href="/contact">
					<span class="nav-register-long">Get connected with us</span><span class="nav-register-short" aria-hidden="true">Connect</span>
					<svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="nav-register-arrow"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</a>
			</div>
		</div>
	</nav>
</div>

<script>
	// Swap "Sign in" for the signed-in name/initials; pages are prerendered so this runs client-side.
	const link = document.getElementById('gp-nav-account');
	const label = document.getElementById('gp-nav-account-label');
	const avatar = document.getElementById('gp-nav-account-avatar');
	const create = document.getElementById('gp-nav-create');
	if (link && label && avatar) {
		fetch('/api/me', { cache: 'no-store' })
			.then((r) => (r.ok ? r.json() : null))
			.then((me: { configured?: boolean; signedIn?: boolean; name?: string; initials?: string } | null) => {
				if (!me?.configured) {
					link.hidden = true;
					if (create) create.hidden = true;
					return;
				}
				if (me.signedIn) {
					label.textContent = me.name ?? 'Account';
					avatar.textContent = me.initials ?? '';
					avatar.classList.add('is-initials');
					link.classList.add('is-signed-in');
					link.setAttribute('aria-label', `Your account, ${me.name ?? ''}`);
					link.setAttribute('title', me.name ?? 'Account');
					if (create) create.hidden = true;
				}
			})
			.catch(() => undefined);
	}
</script>
