---
const raw = Astro.url.pathname.replace(/\/$/, '') || '/';
const path = raw === '' ? '/' : raw;

function active(href: string): string {
	const isHome = href === '/';
	const match = isHome ? path === '/' : path === href;
	return match ? 'active' : '';
}

function bottomActive(href: string): string {
	const isHome = href === '/';
	const match = isHome ? path === '/' : path.startsWith(href);
	return match ? 'active' : '';
}
---

<div class="gp-nav-wrap">
	<div class="nav-drawer-backdrop" aria-hidden="true"></div>
	<nav class="nav-pill" aria-label="Main navigation">
		<a class="nav-brand" href="/">
			<img
				src="/images/website-logo.webp"
				alt="Racquetball Grand Prix"
				width="1000"
				height="200"
				fetchpriority="high"
				decoding="async"
			/>
		</a>
		<button
			type="button"
			class="nav-menu-toggle"
			id="gp-nav-menu-btn"
			aria-expanded="false"
			aria-controls="gp-primary-nav"
		>
			<span class="nav-menu-bars" aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
			</span>
			<span class="visually-hidden">Open menu</span>
		</button>
		<div class="nav-links" id="gp-primary-nav">
			<div class="nav-drawer-head" aria-hidden="true">
				<a class="nav-drawer-logo-link" href="/" tabindex="-1">
					<img
						src="/images/website-logo.webp"
						alt="Racquetball Grand Prix"
						width="1000"
						height="200"
					/>
				</a>
			</div>
			<a href="/" class:list={[active('/')]} data-key="home">Home</a>
			<a href="/tournaments" class:list={[active('/tournaments')]} data-key="tournaments">Tournaments</a>
			<a href="/points" class:list={[active('/points')]} data-key="points">Points</a>
			<a href="/leaderboard" class:list={[active('/leaderboard')]} data-key="leaderboard">Leaderboard</a>
			<a href="/sponsors" class:list={[active('/sponsors')]} data-key="sponsors">Sponsors</a>
			<div class="nav-drawer-sep" aria-hidden="true"></div>
			<a class:list={['nav-register', active('/contact')]} href="/contact">
				Get connected with us
				<svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="nav-register-arrow"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</a>
		</div>
	</nav>
</div>

<!-- Bottom tab bar — mobile only, rendered via CSS display:none on desktop -->
<nav class="gp-bottom-nav" aria-label="Primary navigation">
	<a href="/" class:list={['gp-bottom-nav-item', bottomActive('/')]} aria-current={path === '/' ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
			<polyline points="9 22 9 12 15 12 15 22"/>
		</svg>
		<span>Home</span>
	</a>
	<a href="/tournaments" class:list={['gp-bottom-nav-item', bottomActive('/tournaments')]} aria-current={path === '/tournaments' ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
			<line x1="16" y1="2" x2="16" y2="6"/>
			<line x1="8" y1="2" x2="8" y2="6"/>
			<line x1="3" y1="10" x2="21" y2="10"/>
		</svg>
		<span>Schedule</span>
	</a>
	<a href="/leaderboard" class:list={['gp-bottom-nav-item', bottomActive('/leaderboard')]} aria-current={path === '/leaderboard' ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<line x1="18" y1="20" x2="18" y2="10"/>
			<line x1="12" y1="20" x2="12" y2="4"/>
			<line x1="6" y1="20" x2="6" y2="14"/>
		</svg>
		<span>Standings</span>
	</a>
	<a href="/points" class:list={['gp-bottom-nav-item', bottomActive('/points')]} aria-current={path === '/points' ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="10"/>
			<line x1="12" y1="8" x2="12" y2="12"/>
			<line x1="12" y1="16" x2="12.01" y2="16"/>
		</svg>
		<span>Points</span>
	</a>
	<a href="/sponsors" class:list={['gp-bottom-nav-item', bottomActive('/sponsors')]} aria-current={path === '/sponsors' ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
		</svg>
		<span>Sponsors</span>
	</a>
	<a href="/contact" class:list={['gp-bottom-nav-item', bottomActive('/contact')]} aria-current={path === '/contact' ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
			<circle cx="8.5" cy="7" r="4"/>
			<line x1="20" y1="8" x2="20" y2="14"/>
			<line x1="23" y1="11" x2="17" y2="11"/>
		</svg>
		<span>Connect</span>
	</a>
</nav>
