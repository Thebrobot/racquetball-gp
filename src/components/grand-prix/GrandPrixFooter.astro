---
import { GRAND_PRIX_FACEBOOK_URL } from '../../data/social';
import { dlrSpotlight } from '../../data/guest-spotlight/dlr';

const year = new Date().getFullYear();
---

<footer>
	<a href="/">
		<img
			src="/images/website-logo.webp"
			alt="Racquetball Grand Prix"
			style="height:44px;width:auto;max-width:min(280px,85vw);margin:0 auto 10px;display:block;opacity:0.85;"
		/>
	</a>
	<div class="footer-sub">A first-of-its-kind season series · Florida {year}</div>
	<div class="footer-links">
		<a href="/tournaments">Schedule</a>
		<a href="/leaderboard">Leaderboard</a>
		<a href="/points">Points</a>
		<a href="/sponsors">Sponsors</a>
		<a href={dlrSpotlight.pageHref}>DLR Guest</a>
		<a href="/contact">Contact</a>
		<a href={GRAND_PRIX_FACEBOOK_URL} target="_blank" rel="noopener noreferrer" aria-label="Florida Racquetball Grand Prix on Facebook">Facebook</a>
	</div>
	<div class="footer-copy">© {year} Florida Racquetball Grand Prix. All rights reserved.</div>
</footer>
