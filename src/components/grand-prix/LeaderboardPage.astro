---
import GrandPrixLayout from '../../layouts/GrandPrixLayout.astro';
import {
	LB_OVERVIEW_CATEGORY_ORDER,
	LB_CATEGORY_HEADING,
	LB_DIVISIONS_BY_CATEGORY,
	DEFAULT_LEADERBOARD_CATEGORY,
	DEFAULT_LEADERBOARD_DIVISION,
	getDivisionLeaders,
	getSortedRows,
	getDivisionDisplayMeta,
	leaderboardDivisionHref,
	leaderboardTotal,
	formatPlayerInitials,
	isPendingPlaceholder,
	type LbCategory,
} from '../../data/leaderboard';
import { getPlayerImageForDisplay } from '../../data/player-images';
import { getPlayerSlug } from '../../data/players';
import { SEASON_STOPS } from '../../data/season-stops';
import { EVENTS } from '../../data/events';
import { titleSponsor } from '../../data/ocala-sponsors';

interface Props {
	initialCategory?: LbCategory;
	initialDivision?: string;
	pageTitle?: string;
	pageDescription?: string;
}

const {
	initialCategory = DEFAULT_LEADERBOARD_CATEGORY,
	initialDivision = DEFAULT_LEADERBOARD_DIVISION,
	pageTitle = 'Leaderboard | Florida Racquetball Grand Prix 2026',
	pageDescription = 'Live season standings for the Florida Racquetball Grand Prix, updated after every stop.',
} = Astro.props;

const stopsComplete = SEASON_STOPS.filter((s) => s.kind === 'done').length;
const totalStops = SEASON_STOPS.filter((s) => s.kind !== 'champ').length;
const registeredCount = new Set(
	EVENTS.flatMap((e) => (e.profiles ?? []).map((p) => p.name))
).size;

const initialRows = getSortedRows(initialCategory, initialDivision, true);
const initialMaxPts = initialRows.length ? leaderboardTotal(initialRows[0]) : 1;
const initialMeta = getDivisionDisplayMeta(initialDivision);
const initialContextLabel = initialMeta
	? `${LB_CATEGORY_HEADING[initialMeta.category]} · ${initialMeta.divisionLabel}`
	: `${LB_CATEGORY_HEADING[initialCategory]} · ${LB_DIVISIONS_BY_CATEGORY[initialCategory][0]?.label ?? 'Open'}`;

const badgeLabel = { q: 'Qualified', pace: 'On Pace', chase: 'Chasing' } as const;
const badgeMap = { q: 'badge-q', pace: 'badge-pace', chase: 'badge-chase' } as const;
function badgeClass(status: keyof typeof badgeLabel): string {
	return status === 'q' ? 'badge-q' : status === 'pace' ? 'badge-pace' : 'badge-chase';
}

const lbInitialState = JSON.stringify({ category: initialCategory, division: initialDivision });
---

<GrandPrixLayout
	title={pageTitle}
	description={pageDescription}
	spotlightLabel="Title sponsor"
	spotlightName={titleSponsor.name}
	spotlightBlurb={titleSponsor.blurb}
	spotlightLogoUrl={titleSponsor.logoUrl}
>
	<script type="application/json" id="lb-initial-state" set:html={lbInitialState} />

	<div class="lb-hero">
		<img
			class="lb-hero-series-img"
			src="/images/series-logo.webp"
			alt="Florida Racquetball Grand Prix series emblem"
			width="1080"
			height="1350"
			decoding="async"
		/>
		<div class="section-label">Season 2026</div>
		<div class="lb-hero-title">Season <span>Standings</span></div>
		<div class="lb-hero-sub">
			Updated after every Grand Prix stop · Season opens May 2026
		</div>
		<div class="lb-stats">
			<div class="lb-stat">
				<span class="lb-stat-val"><em>{stopsComplete}</em> / {totalStops}</span><span class="lb-stat-label">Tour Stops Complete</span>
			</div>
			<div class="lb-stat">
				<span class="lb-stat-val">{registeredCount > 0 ? registeredCount : 'TBD'}</span><span class="lb-stat-label">Players Registered</span>
			</div>
			<div class="lb-stat">
				<span class="lb-stat-val">Dec <em>'26</em></span><span class="lb-stat-label">Last 2026 tour stop</span>
			</div>
		</div>
	</div>

	<div id="lb-detail" class="lb-detail">
		<div class="lb-standings-panel">
			<header class="lb-panel-header">
				<h2 class="lb-panel-title">Full standings</h2>
				<p class="lb-panel-desc">Choose event type and division, then scroll the table for everyone with points.</p>
			</header>

			<div class="lb-detail-toolbar">
				<div class="lb-tabs-row" role="tablist" aria-label="Standings category">
					<button
						class:list={['lb-tab', { active: initialCategory === 'singles' }]}
						type="button"
						data-lb-tab="singles"
						onclick="setLbTab('singles')"
					>
						Singles
					</button>
					<button
						class:list={['lb-tab', { active: initialCategory === 'doubles' }]}
						type="button"
						data-lb-tab="doubles"
						onclick="setLbTab('doubles')"
					>
						Doubles
					</button>
					<button
						class:list={['lb-tab', { active: initialCategory === 'mixed' }]}
						type="button"
						data-lb-tab="mixed"
						onclick="setLbTab('mixed')"
					>
						Mixed Doubles
					</button>
				</div>
				<div class="lb-division-row">
					<label class="lb-division-label" for="divSelect">Division</label>
					<select class="lb-select" id="divSelect" onchange="onLbDivisionChange()">
						{
							LB_DIVISIONS_BY_CATEGORY[initialCategory].map((d) => (
								<option value={d.id} selected={d.id === initialDivision}>{d.label}</option>
							))
						}
					</select>
				</div>
			</div>

			<p class="lb-context" id="lb-context-line" aria-live="polite">
				{initialContextLabel}
			</p>

			<section class="lb-spotlight" aria-label="Top three in selected division" aria-live="polite">
				<div class="lb-spotlight-inner">
					<p class="lb-spotlight-kicker">Top 3 in this bracket</p>
					<div class="lb-spotlight-podium" id="lb-spotlight-cards"></div>
				</div>
			</section>

			<div class="lb-table-wrap">
			<table class="lb-table">
				<thead>
					<tr>
						<th style="width:48px">#</th>
						<th>Player</th>
						<th class="right hide-mobile">Lap 1</th>
						<th class="right hide-mobile">Lap 2</th>
						<th class="right">Total</th>
						<th class="right hide-mobile">Wins</th>
						<th class="right hide-mobile">Place</th>
						<th class="right hide-mobile">Stops</th>
						<th class="right">Status</th>
					</tr>
				</thead>
				<tbody id="lb-tbody">
					{initialRows.map((r, i) => {
						const total = leaderboardTotal(r);
						const pctFill = initialMaxPts > 0 ? Math.round((total / initialMaxPts) * 100) : 0;
						return (
							<tr>
								<td class="lb-rank-cell">
									{i === 0 ? (
										<span class="lb-medal">🥇</span>
									) : i === 1 ? (
										<span class="lb-medal">🥈</span>
									) : i === 2 ? (
										<span class="lb-medal">🥉</span>
									) : (
										<span class="rank-other">{i + 1}</span>
									)}
								</td>
								<td>
									<div class="lb-player-cell">
										{getPlayerImageForDisplay(r.name, 40) ? (
											<img
												class="lb-player-avatar"
												src={getPlayerImageForDisplay(r.name, 40)}
												alt=""
												width="40"
												height="40"
												loading="lazy"
												decoding="async"
											/>
										) : (
											<span class="lb-player-avatar lb-player-avatar--fallback" aria-hidden="true">
												{formatPlayerInitials(r.name)}
											</span>
										)}
										<div class="lb-player-text">
											{isPendingPlaceholder(r) ? (
												<span class="lb-player-name">{r.name}</span>
											) : (
												<a class="lb-player-name lb-player-name-link" href={`/players/${getPlayerSlug(r.name)}`}>{r.name}</a>
											)}
											{r.city && <span class="lb-player-city">{r.city}</span>}
											{r.note && <span style="font-size:13px;color:var(--green);display:block;">{r.note}</span>}
											<div class="lb-progress-bar"><div class="lb-progress-fill" style={`width:${pctFill}%`}></div></div>
										</div>
									</div>
								</td>
								<td class="lb-stops right hide-mobile">{r.s1 || '-'}</td>
								<td class="lb-stops right hide-mobile">{r.s2 || '-'}</td>
								<td class:list={['lb-pts-cell', i === 0 ? 'leader' : '']}>{total}</td>
								<td class="lb-stops right hide-mobile">{r.wins ?? 0}</td>
								<td class="lb-stops right hide-mobile">{r.place ?? '-'}</td>
								<td class="lb-stops right hide-mobile">{r.attendance ?? 0}/4</td>
								<td class="lb-status-cell">
									<span class:list={['lb-badge', badgeMap[r.status]]}>{badgeLabel[r.status]}</span>
								</td>
							</tr>
						);
					})}
				</tbody>
			</table>
			<div class="lb-legend">
				<span
					><span class="lb-badge badge-q" style="font-size:13px;">Qualified</span> · Division leader / strong position</span
				>
				<span
					><span class="lb-badge badge-pace" style="font-size:13px;">On Pace</span> · Projected to qualify</span
				>
				<span><span class="lb-badge badge-chase" style="font-size:13px;">Chasing</span> · Points needed</span>
			</div>
			</div>
		</div>
	</div>

	<section class="lb-overview" id="lb-overview" aria-labelledby="lb-overview-heading">
		<h2 id="lb-overview-heading" class="lb-overview-title">Leaders by division</h2>
		<p class="lb-overview-lede">
			Points are separate for singles, doubles, and mixed; each card highlights a player at the top of that bracket. Tap
			a card to jump to that division's standings.
		</p>
		{
			LB_OVERVIEW_CATEGORY_ORDER.map((cat: LbCategory) => (
				<div class="lb-overview-block">
					<h3 class="lb-overview-cat">{LB_CATEGORY_HEADING[cat]}</h3>
					<div class="lb-overview-grid">
						{LB_DIVISIONS_BY_CATEGORY[cat].flatMap((d) => {
							const leaders = getDivisionLeaders(cat, d.id);
							const label = `${LB_CATEGORY_HEADING[cat]} · ${d.label}`;
							if (!leaders.length) {
								return [{ division: d, leader: null as null, label }];
							}
							return leaders.map((leader) => ({ division: d, leader, label }));
						}).map(({ division: d, leader, label }) => (
								<a
									class="lb-overview-card"
									href={leaderboardDivisionHref(d.id)}
									data-lb-event={cat}
									data-lb-division={d.id}
								>
									<span class="lb-overview-div">{d.label}</span>
									{leader ? (
										<>
											<div class="lb-overview-leader">
												{getPlayerImageForDisplay(leader.name, 36) ? (
													<img
														class="lb-overview-avatar"
														src={getPlayerImageForDisplay(leader.name, 36)}
														alt=""
														width="36"
														height="36"
														loading="lazy"
														decoding="async"
													/>
												) : (
													<span class="lb-overview-avatar lb-overview-avatar--fallback" aria-hidden="true">
														{formatPlayerInitials(leader.name)}
													</span>
												)}
												<span
													class="lb-overview-name lb-overview-name-link"
													onclick={`event.preventDefault(); event.stopPropagation(); window.location.href='/players/${getPlayerSlug(leader.name)}';`}
													role="link"
													tabindex="0"
												>
													{leader.name}
												</span>
											</div>
											<span class="lb-overview-meta">
												<span class="lb-overview-pts">
													<strong>{leaderboardTotal(leader)}</strong> pts
												</span>
												<span class:list={['lb-badge', badgeClass(leader.status)]}>
													{badgeLabel[leader.status]}
												</span>
											</span>
										</>
									) : (
										<span class="lb-overview-empty">No results yet</span>
									)}
									<span class="lb-overview-hint">View standings →</span>
								</a>
						))}
					</div>
				</div>
			))
		}
	</section>
</GrandPrixLayout>
