---
import GrandPrixLayout from '../../layouts/GrandPrixLayout.astro';
import {
	LB_OVERVIEW_CATEGORY_ORDER,
	LB_CATEGORY_HEADING,
	LB_DIVISIONS_BY_CATEGORY,
	DEFAULT_LEADERBOARD_CATEGORY,
	DEFAULT_LEADERBOARD_DIVISION,
	getDivisionLeaders,
	getSortedRows,
	assignLeaderboardPlaces,
	getDivisionDisplayMeta,
	leaderboardDivisionHref,
	leaderboardTotal,
	formatPlayerInitials,
	type LbCategory,
} from '../../data/leaderboard';
import { getPlayerImageForDisplay } from '../../data/player-images';
import { SEASON_STOPS } from '../../data/season-stops';
import { EVENTS } from '../../data/events';
import { renderStandingsRow, renderPodium } from '../../lib/leaderboard-render';
import StopStatusStrip from './StopStatusStrip.astro';

interface Props {
	initialCategory?: LbCategory;
	initialDivision?: string;
	pageTitle?: string;
	pageDescription?: string;
}

const {
	initialCategory = DEFAULT_LEADERBOARD_CATEGORY,
	initialDivision = DEFAULT_LEADERBOARD_DIVISION,
	pageTitle = 'Leaderboard | Florida Racquetball Grand Prix 2026',
	pageDescription = 'Live season standings for the Florida Racquetball Grand Prix, updated after every stop.',
} = Astro.props;

const stopsComplete = SEASON_STOPS.filter((s) => s.kind === 'done').length;
const totalStops = SEASON_STOPS.filter((s) => s.kind !== 'champ').length;
const registeredCount = new Set(
	EVENTS.flatMap((e) => (e.profiles ?? []).map((p) => p.name))
).size;

const initialRows = getSortedRows(initialCategory, initialDivision, true);
const initialMaxPts = initialRows.length ? leaderboardTotal(initialRows[0]) : 1;
const initialMeta = getDivisionDisplayMeta(initialDivision);
const initialContextLabel = initialMeta
	? `${LB_CATEGORY_HEADING[initialMeta.category]} · ${initialMeta.divisionLabel}`
	: `${LB_CATEGORY_HEADING[initialCategory]} · ${LB_DIVISIONS_BY_CATEGORY[initialCategory][0]?.label ?? 'Open'}`;

const badgeLabel = { q: 'Qualified', pace: 'On Pace', chase: 'Chasing' } as const;
function badgeClass(status: keyof typeof badgeLabel): string {
	return status === 'q' ? 'badge-q' : status === 'pace' ? 'badge-pace' : 'badge-chase';
}

const lbInitialState = JSON.stringify({ category: initialCategory, division: initialDivision });

const initialPlaced = assignLeaderboardPlaces(initialRows);
const initialRowsHtml = initialPlaced
	.map((r, i) => renderStandingsRow(r, r.place || i + 1, initialMaxPts))
	.join('');
const initialPodiumHtml = renderPodium(initialPlaced);

/** Division ladder: one row per division, ties collapsed into one entry. */
const ladder = LB_OVERVIEW_CATEGORY_ORDER.map((cat) => ({
	category: cat,
	heading: LB_CATEGORY_HEADING[cat],
	rows: LB_DIVISIONS_BY_CATEGORY[cat].map((d) => {
		const leaders = getDivisionLeaders(cat, d.id);
		return { division: d, leader: leaders[0] ?? null, others: leaders.slice(1) };
	}),
}));
---

<GrandPrixLayout
	title={pageTitle}
	description={pageDescription}
>
	<script type="application/json" id="lb-initial-state" set:html={lbInitialState} />

	<header class="gp-page-head">
		<div class="gp-page-head-inner gp-page-head-inner--split">
			<div>
				<p class="section-label">Season 2026</p>
				<h1 class="gp-title">Season <span>standings</span></h1>
				<p class="gp-sub">Updated after every Grand Prix stop. Points are separate for singles, doubles, and mixed.</p>
				<ul class="gp-stat-row lb-head-stats" aria-label="Season at a glance">
					<li><strong><em>{stopsComplete}</em><span class="gp-stat-of">/{totalStops}</span></strong><span>Stops complete</span></li>
					<li><strong>{registeredCount > 0 ? registeredCount : 'TBD'}</strong><span>Players registered</span></li>
					<li><strong>Dec <em>'26</em></strong><span>Last 2026 stop</span></li>
				</ul>
			</div>
			<div class="lb-head-strip"><StopStatusStrip compact /></div>
		</div>
	</header>

	<div id="lb-detail" class="lb-detail lb2-detail">
		<div class="lb2-panel">
			<div class="lb-detail-toolbar lb2-toolbar">
				<div class="lb-tabs-row" role="tablist" aria-label="Standings category">
					<button class:list={['lb-tab', { active: initialCategory === 'singles' }]} type="button" data-lb-tab="singles" onclick="setLbTab('singles')">Singles</button>
					<button class:list={['lb-tab', { active: initialCategory === 'doubles' }]} type="button" data-lb-tab="doubles" onclick="setLbTab('doubles')">Doubles</button>
					<button class:list={['lb-tab', { active: initialCategory === 'mixed' }]} type="button" data-lb-tab="mixed" onclick="setLbTab('mixed')">Mixed</button>
				</div>
				<div class="lb-division-row">
					<label class="lb-division-label" for="divSelect">Division</label>
					<select class="lb-select" id="divSelect" onchange="onLbDivisionChange()">
						{LB_DIVISIONS_BY_CATEGORY[initialCategory].map((d) => (
							<option value={d.id} selected={d.id === initialDivision}>{d.label}</option>
						))}
					</select>
				</div>
			</div>

			<div class="lb2-panel-body">
				<header class="lb2-panel-head">
					<h2 class="lb2-panel-title" id="lb-context-line" aria-live="polite">{initialContextLabel}</h2>
					<p class="lb2-panel-desc">Season points for this division. Tap a name for the player's profile.</p>
				</header>

				<section class="lb2-podium-wrap" aria-label="Top three in selected division" aria-live="polite">
					<div class="lb2-podium" id="lb-spotlight-cards" set:html={initialPodiumHtml} />
				</section>

				<div class="lb2-table" role="table" aria-label="Full standings">
					<div class="lb2-head" role="row">
						<span role="columnheader">#</span>
						<span role="columnheader">Player</span>
						<span class="lb2-cell--wide" role="columnheader">Lap 1</span>
						<span class="lb2-cell--wide" role="columnheader">Lap 2</span>
						<span role="columnheader">Total</span>
						<span class="lb2-cell--wide" role="columnheader">Wins</span>
						<span class="lb2-cell--wide" role="columnheader">Place</span>
						<span class="lb2-cell--wide" role="columnheader">Stops</span>
						<span class="lb2-cell--wide" role="columnheader">Status</span>
					</div>
					<div class="lb2-rows" id="lb-rows" role="rowgroup" set:html={initialRowsHtml} />
				</div>

				<div class="lb2-legend">
					<span><span class="lb-badge badge-q">Qualified</span> Division leader / strong position</span>
					<span><span class="lb-badge badge-pace">On Pace</span> Projected to qualify</span>
					<span><span class="lb-badge badge-chase">Chasing</span> Points needed</span>
				</div>
			</div>
		</div>

		<div class="lb-strip-mobile"><StopStatusStrip compact /></div>
	</div>

	<section class="gp-band gp-band--navy2 lb2-ladder" id="lb-overview" aria-labelledby="lb-overview-heading">
		<div class="gp-band-inner">
			<p class="section-label">Every division</p>
			<h2 id="lb-overview-heading" class="gp-title lb2-ladder-title">Leaders by <span>division</span></h2>
			<p class="gp-sub">One line per division. Tap a row to load that division's full standings above.</p>
			<div class="lb2-ladder-grid">
				{ladder.map((block) => (
					<div class="lb2-ladder-block">
						<h3 class="lb2-ladder-cat">{block.heading}</h3>
						<ul class="lb2-ladder-list">
							{block.rows.map(({ division: d, leader, others }) => (
								<li>
									<a class="lb2-ladder-row" href={leaderboardDivisionHref(d.id)} data-lb-event={block.category} data-lb-division={d.id}>
										<span class="lb2-ladder-div">{d.label}</span>
										{leader ? (
											<>
												{getPlayerImageForDisplay(leader.name, 36) ? (
													<img class="lb2-ladder-avatar" src={getPlayerImageForDisplay(leader.name, 36)} alt="" width="36" height="36" loading="lazy" decoding="async" />
												) : (
													<span class="lb2-ladder-avatar lb2-ladder-avatar--fallback" aria-hidden="true">{formatPlayerInitials(leader.name)}</span>
												)}
												<span class="lb2-ladder-name">
													{leader.name}
													{others.length > 0 && (
														<small>{others.length + 1}-way tie · {others.map((o) => o.name).join(', ')}</small>
													)}
												</span>
												<span class="lb2-ladder-pts"><b>{leaderboardTotal(leader)}</b> pts</span>
												<span class:list={['lb-badge', badgeClass(leader.status), 'lb2-ladder-badge']}>{badgeLabel[leader.status]}</span>
											</>
										) : (
											<span class="lb2-ladder-name lb2-ladder-name--empty">No results yet</span>
										)}
										<span class="lb2-ladder-chev" aria-hidden="true">›</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
	</section>
</GrandPrixLayout>

<style>
	.lb-head-stats {
		margin-top: 22px;
	}
</style>
