---
import { ocalaSponsors, titleSponsor } from '../../data/ocala-sponsors';

const sponsors = [titleSponsor, ...ocalaSponsors];
const marqueeSponsors = [...sponsors, ...sponsors];
---

<section class="sponsor-logo-marquee" aria-labelledby="sponsor-marquee-heading">
	<h2 id="sponsor-marquee-heading" class="sponsor-logo-marquee-title">Thank you to our sponsors</h2>
	<div class="sponsor-logo-marquee-frame">
		<div class="sponsor-logo-marquee-track">
			{marqueeSponsors.map((sponsor, index) => {
				const Tag = sponsor.url ? 'a' : 'div';
				const repeated = index >= sponsors.length;

				return (
					<Tag
						class="sponsor-logo-marquee-item"
						aria-hidden={repeated ? 'true' : undefined}
						{...(sponsor.url
							? { href: sponsor.url, target: '_blank', rel: 'noopener noreferrer' }
							: {})}
					>
						<img src={sponsor.logoUrl} alt={repeated ? '' : `${sponsor.name} logo`} loading="lazy" />
					</Tag>
				);
			})}
		</div>
	</div>
</section>

<style>
.sponsor-logo-marquee {
	width: min(1240px, calc(100vw - 44px));
	margin: 22px auto 0;
	color: #fff;
}

.sponsor-logo-marquee-title {
	margin: 0 0 12px;
	font-family: 'Barlow Condensed', sans-serif;
	font-size: clamp(22px, 2.6vw, 34px);
	font-weight: 900;
	letter-spacing: 0.06em;
	line-height: 1;
	text-align: center;
	text-transform: uppercase;
	color: #fff;
}

.sponsor-logo-marquee-frame {
	position: relative;
	overflow: hidden;
	border: 1px solid rgba(255, 255, 255, 0.14);
	border-radius: 16px;
	background: rgba(255, 255, 255, 0.06);
	box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.sponsor-logo-marquee-frame::before,
.sponsor-logo-marquee-frame::after {
	content: '';
	position: absolute;
	top: 0;
	bottom: 0;
	z-index: 2;
	width: 72px;
	pointer-events: none;
}

.sponsor-logo-marquee-frame::before {
	left: 0;
	background: linear-gradient(90deg, #0a1628 0%, rgba(10, 22, 40, 0) 100%);
}

.sponsor-logo-marquee-frame::after {
	right: 0;
	background: linear-gradient(270deg, #0a1628 0%, rgba(10, 22, 40, 0) 100%);
}

.sponsor-logo-marquee-track {
	display: flex;
	width: max-content;
	align-items: center;
	gap: 16px;
	padding: 14px 18px;
	animation: sponsorLogoScroll 46s linear infinite;
	will-change: transform;
}

.sponsor-logo-marquee-frame:hover .sponsor-logo-marquee-track {
	animation-play-state: paused;
}

.sponsor-logo-marquee-item {
	display: flex;
	width: 154px;
	height: 72px;
	flex: 0 0 154px;
	align-items: center;
	justify-content: center;
	border: 1px solid rgba(15, 23, 42, 0.08);
	border-radius: 10px;
	background: #fff;
	padding: 10px 14px;
	text-decoration: none;
	box-shadow: 0 8px 18px rgba(0, 0, 0, 0.16);
}

.sponsor-logo-marquee-item img {
	display: block;
	max-width: 100%;
	max-height: 100%;
	object-fit: contain;
}

@keyframes sponsorLogoScroll {
	from {
		transform: translateX(0);
	}

	to {
		transform: translateX(-50%);
	}
}

@media (max-width: 767px) {
	.sponsor-logo-marquee {
		width: calc(100vw - 24px);
		margin-top: 18px;
	}

	.sponsor-logo-marquee-frame {
		border-radius: 14px;
	}

	.sponsor-logo-marquee-frame::before,
	.sponsor-logo-marquee-frame::after {
		width: 42px;
	}

	.sponsor-logo-marquee-track {
		gap: 12px;
		padding: 12px 14px;
		animation-duration: 38s;
	}

	.sponsor-logo-marquee-item {
		width: 132px;
		height: 62px;
		flex-basis: 132px;
		padding: 8px 12px;
	}
}

@media (prefers-reduced-motion: reduce) {
	.sponsor-logo-marquee-track {
		animation: none;
	}
}
</style>
