---

---

<div id="points" class="pts-section">
	<div class="pts-inner">
		<div class="section-label">Points structure</div>
		<div class="section-title">How Points <span style="color:var(--orange)">Work</span></div>
		<p class="section-sub">
			Points are awarded at every stop based on your finish position across singles, doubles, and mixed
			doubles. Partner loyalty is rewarded.
		</p>
		<div class="pts-grid">
			<div class="pts-card">
				<div class="pts-card-head">
					<span class="pts-card-icon">🎯</span>
					<div>
						<div class="pts-card-title">Singles</div>
						<div class="pts-card-sub">All divisions</div>
					</div>
				</div>
				<div class="pts-rows">
					<div class="pts-row"><span class="pts-place">🥇 Champion</span><span class="pts-val gold">100 pts</span></div>
					<div class="pts-row"><span class="pts-place">🥈 Finalist</span><span class="pts-val silver2">75 pts</span></div>
					<div class="pts-row"><span class="pts-place">🥉 Semifinal</span><span class="pts-val bronze">50 pts</span></div>
					<div class="pts-row"><span class="pts-place">Quarterfinal</span><span class="pts-val normal">25 pts</span></div>
					<div class="pts-row"><span class="pts-place">Participation</span><span class="pts-val normal">10 pts</span></div>
				</div>
			</div>
			<div class="pts-card">
				<div class="pts-card-head">
					<span class="pts-card-icon">🤝</span>
					<div>
						<div class="pts-card-title">Doubles: Same Partner</div>
						<div class="pts-card-sub">Doubles &amp; Mixed Doubles · partnership bonus applied</div>
					</div>
				</div>
				<div class="pts-rows">
					<div class="pts-row"><span class="pts-place">🥇 Champion</span><span class="pts-val gold">80 pts ea</span></div>
					<div class="pts-row"><span class="pts-place">🥈 Finalist</span><span class="pts-val silver2">60 pts ea</span></div>
					<div class="pts-row"><span class="pts-place">🥉 Semifinal</span><span class="pts-val bronze">40 pts ea</span></div>
					<div class="pts-row"><span class="pts-place">Quarterfinal</span><span class="pts-val normal">20 pts ea</span></div>
					<div class="pts-row"><span class="pts-place">Participation</span><span class="pts-val normal">10 pts ea</span></div>
				</div>
				<div class="pts-note">Same declared partner across stops earns the partnership bonus rate.</div>
			</div>
			<div class="pts-card">
				<div class="pts-card-head">
					<span class="pts-card-icon">🔄</span>
					<div>
						<div class="pts-card-title">Doubles: New Partner</div>
						<div class="pts-card-sub">Doubles &amp; Mixed Doubles · standard rate</div>
					</div>
				</div>
				<div class="pts-rows">
					<div class="pts-row"><span class="pts-place">🥇 Champion</span><span class="pts-val gold">65 pts ea</span></div>
					<div class="pts-row"><span class="pts-place">🥈 Finalist</span><span class="pts-val silver2">48 pts ea</span></div>
					<div class="pts-row"><span class="pts-place">🥉 Semifinal</span><span class="pts-val bronze">32 pts ea</span></div>
					<div class="pts-row"><span class="pts-place">Quarterfinal</span><span class="pts-val normal">16 pts ea</span></div>
					<div class="pts-row"><span class="pts-place">Participation</span><span class="pts-val normal">10 pts ea</span></div>
				</div>
				<div class="pts-note">Points count toward the season standings at the standard rate at every Grand Prix stop.</div>
			</div>
		</div>
	</div>
</div>
