---

---

<div id="points" class="pts-section">
	<div class="pts-inner">
		<div class="section-label">Points structure</div>
		<div class="section-title">How Points <span style="color:var(--orange)">Work</span></div>
		<p class="section-sub">
			Points are awarded at every stop based on your finish position across singles, doubles, and mixed
			doubles. Partner loyalty is rewarded.
		</p>
		<div class="pts-grid">
			<div class="pts-card">
				<div class="pts-card-head">
					<span class="pts-card-icon-svg" aria-hidden="true">
						<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
							<circle cx="16" cy="11" r="6" stroke="currentColor" stroke-width="2"/>
							<path d="M4 28c0-6.627 5.373-12 12-12s12 5.373 12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
						</svg>
					</span>
					<div>
						<div class="pts-card-title">Singles</div>
						<div class="pts-card-sub">All divisions</div>
					</div>
				</div>
				<div class="pts-rows">
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--1">1</span> Champion</span><span class="pts-val gold">100 pts</span></div>
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--2">2</span> Finalist</span><span class="pts-val silver2">75 pts</span></div>
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--3">3</span> Semifinal</span><span class="pts-val bronze">50 pts</span></div>
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--4">4</span> Quarterfinal</span><span class="pts-val normal">25 pts</span></div>
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--p">P</span> Participation</span><span class="pts-val normal">10 pts</span></div>
				</div>
			</div>
			<div class="pts-card">
				<div class="pts-card-head">
					<span class="pts-card-icon-svg" aria-hidden="true">
						<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
							<circle cx="11" cy="11" r="5" stroke="currentColor" stroke-width="2"/>
							<circle cx="21" cy="11" r="5" stroke="currentColor" stroke-width="2"/>
							<path d="M2 28c0-5.523 4.477-10 10-10h8c5.523 0 10 4.477 10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
						</svg>
					</span>
					<div>
						<div class="pts-card-title">Doubles: Same Partner</div>
						<div class="pts-card-sub">Doubles &amp; Mixed Doubles · partnership bonus applied</div>
					</div>
				</div>
				<div class="pts-rows">
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--1">1</span> Champion</span><span class="pts-val gold">80 pts ea</span></div>
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--2">2</span> Finalist</span><span class="pts-val silver2">60 pts ea</span></div>
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--3">3</span> Semifinal</span><span class="pts-val bronze">40 pts ea</span></div>
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--4">4</span> Quarterfinal</span><span class="pts-val normal">20 pts ea</span></div>
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--p">P</span> Participation</span><span class="pts-val normal">10 pts ea</span></div>
				</div>
				<div class="pts-note">Same declared partner across stops earns the partnership bonus rate.</div>
			</div>
			<div class="pts-card">
				<div class="pts-card-head">
					<span class="pts-card-icon-svg" aria-hidden="true">
						<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
							<circle cx="11" cy="11" r="5" stroke="currentColor" stroke-width="2"/>
							<circle cx="21" cy="11" r="5" stroke="currentColor" stroke-width="2"/>
							<path d="M2 28c0-5.523 4.477-10 10-10h8c5.523 0 10 4.477 10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
							<path d="M22 20l3 3-3 3M25 23h-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</span>
					<div>
						<div class="pts-card-title">Doubles: New Partner</div>
						<div class="pts-card-sub">Doubles &amp; Mixed Doubles · standard rate</div>
					</div>
				</div>
				<div class="pts-rows">
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--1">1</span> Champion</span><span class="pts-val gold">65 pts ea</span></div>
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--2">2</span> Finalist</span><span class="pts-val silver2">48 pts ea</span></div>
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--3">3</span> Semifinal</span><span class="pts-val bronze">32 pts ea</span></div>
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--4">4</span> Quarterfinal</span><span class="pts-val normal">16 pts ea</span></div>
					<div class="pts-row"><span class="pts-place"><span class="pts-rank pts-rank--p">P</span> Participation</span><span class="pts-val normal">10 pts ea</span></div>
				</div>
				<div class="pts-note">Points count toward the season standings at the standard rate at every Grand Prix stop.</div>
			</div>
		</div>
	</div>
</div>

<style>
.pts-card-icon-svg {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 44px;
	height: 44px;
	background: rgba(240, 90, 26, 0.12);
	border-radius: 10px;
	flex-shrink: 0;
	color: var(--orange);
}
.pts-card-icon-svg svg {
	width: 26px;
	height: 26px;
}
.pts-rank {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 20px;
	height: 20px;
	border-radius: 50%;
	font-size: 0.65rem;
	font-weight: 800;
	letter-spacing: 0;
	flex-shrink: 0;
	margin-right: 6px;
}
.pts-rank--1 { background: #c9a84c; color: #1a0e00; }
.pts-rank--2 { background: #a8b0b8; color: #0e1318; }
.pts-rank--3 { background: #b06a3a; color: #fff; }
.pts-rank--4 { background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.8); }
.pts-rank--p { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.55); font-size: 0.6rem; }
</style>
