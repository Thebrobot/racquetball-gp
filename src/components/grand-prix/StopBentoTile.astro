---
import type { SeasonStop } from '../../data/season-stops';

interface Props {
	stop: SeasonStop;
	extraClass?: string;
}

const { stop, extraClass } = Astro.props;
---

<article
	class:list={['stop-bento', `stop-bento--${stop.kind}`, extraClass]}
	data-stop-id={stop.id}
	data-bento={stop.bentoGridArea}
	{...(stop.photoCredit ? { title: stop.photoCredit } : {})}
	style={{
		'--stop-img': `url("${stop.image}")`,
		gridArea: stop.bentoGridArea,
	}}
>
	{stop.bracketsHref ? (
		<a class="stop-bento-link" href={stop.bracketsHref} aria-label={`${stop.eventName} brackets`}>
			<span class="visually-hidden">{stop.eventName} brackets</span>
		</a>
	) : null}
	<div class="stop-bento-bg" aria-hidden="true"></div>
	<div class="stop-bento-content">
		<span class="stop-bento-dot" aria-hidden="true"></span>
		<div class="stop-bento-text">
			<span class="stop-bento-label">{stop.label}</span>
			<span class="stop-bento-city">{stop.cityLine}</span>
			<span class="stop-bento-date">{stop.dateHint}</span>
			{stop.teaser && <p class="stop-bento-teaser">{stop.teaser}</p>}
		</div>
	</div>
</article>
