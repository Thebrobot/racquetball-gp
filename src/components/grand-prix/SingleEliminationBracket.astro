---
import type { EventBracketMatch, EventBracketRound, EventDivisionDetail } from '../../data/events';
import { getAllPlayers, getPlayerSlug } from '../../data/players';
import { resolveTeamMembers } from '../../lib/resolve-team-members';

interface Props {
	division: EventDivisionDetail;
	/** When set, disambiguates shared last names (e.g. two Jennings) using event participant rows. */
	eventName?: string;
}

const { division, eventName } = Astro.props;
const rounds = division.rounds ?? [];
const allPlayers = getAllPlayers();
const bracketTeamCtx = eventName ? { eventName, division: division.label } : undefined;
const playerIndex = new Map(allPlayers.map((player) => [player.name.toLowerCase(), player]));

const WINNER_PALETTE = [
	'#2563eb', // blue
	'#ea580c', // orange
	'#7c3aed', // violet
	'#0891b2', // cyan
	'#dc2626', // red
	'#ca8a04', // amber
	'#db2777', // rose
	'#16a34a', // green
];

function getMatchWinnerName(match: EventBracketMatch): string | null {
	if (!match.winner) return null;
	const name = match.winner === 1 ? match.player1 : match.player2;
	const t = name.trim().toUpperCase();
	return t === 'BYE' || t === 'TBD' || t === '' ? null : name;
}

const winnerColorMap = new Map<string, string>();
let _colorIdx = 0;
for (const round of rounds) {
	for (const match of round.matches) {
		const name = getMatchWinnerName(match);
		if (!name) continue;
		// Skip BYE wins — advancing past a BYE isn't a real match result
		const loser = match.winner === 1 ? match.player2 : match.player1;
		if (loser.trim().toUpperCase() === 'BYE') continue;
		if (!winnerColorMap.has(name)) {
			winnerColorMap.set(name, WINNER_PALETTE[_colorIdx++ % WINNER_PALETTE.length]!);
		}
	}
}

function getMatchWinnerColor(match: EventBracketMatch | undefined): string | null {
	if (!match) return null;
	const name = getMatchWinnerName(match);
	return name ? (winnerColorMap.get(name) ?? null) : null;
}

type Layout = {
	cardWidth: number;
	cardHeight: number;
	columnGap: number;
	roundTop: number;
	boardPaddingRight: number;
	cardTops: number[][];
	columnLefts?: number[];
};

type PathSegment = {
	d: string;
	color: string;
	strokeWidth: number;
};

type BoardView = {
	variant: 'desktop' | 'mobile';
	compact: boolean;
	layout: Layout;
	width: number;
	height: number;
	flagLeft: number;
	flagTop: number;
	flagWidth: number;
	showFlag: boolean;
	connectors: PathSegment[];
	finalColor: string;
};

type NameSegment = {
	text: string;
	href?: string;
};

type BracketSide = {
	seed?: number;
	rawName: string;
	displayName: string;
	location: string;
	winner: boolean;
	winnerColor: string | null;
	bye: boolean;
	segments: NameSegment[];
};

const desktopLayout = createLayout(rounds, {
	cardWidth: 220,
	cardHeight: 110,
	columnGap: 42,
	roundTop: 58,
	boardPaddingRight: 48,
	firstRoundGap: 34,
});

const mobileLayout = createLayout(rounds, {
	cardWidth: 232,
	cardHeight: 100,
	columnGap: 18,
	roundTop: 46,
	boardPaddingRight: 40,
	firstRoundGap: 22,
	columnLefts: [0, 250, 472, 666],
});

const boardViews: BoardView[] = [
	createBoardView('desktop', desktopLayout, false),
	createBoardView('mobile', mobileLayout, true),
];

function createLayout(
	bracketRounds: EventBracketRound[],
	options: Omit<Layout, 'cardTops'> & { firstRoundGap: number },
): Layout {
	const firstRoundStep = options.cardHeight + options.firstRoundGap;
	const cardTops: number[][] = [];
	cardTops[0] = (bracketRounds[0]?.matches ?? []).map((_, index) => index * firstRoundStep);

	for (let roundIndex = 1; roundIndex < bracketRounds.length; roundIndex++) {
		const previousTops = cardTops[roundIndex - 1] ?? [];
		const matchCount = bracketRounds[roundIndex]?.matches.length ?? 0;
		cardTops[roundIndex] = Array.from({ length: matchCount }, (_, gameIndex) => {
			const firstTop = previousTops[gameIndex * 2] ?? previousTops[previousTops.length - 1] ?? 0;
			const secondTop = previousTops[gameIndex * 2 + 1] ?? firstTop;
			const firstCenter = firstTop + options.cardHeight / 2;
			const secondCenter = secondTop + options.cardHeight / 2;
			return (firstCenter + secondCenter) / 2 - options.cardHeight / 2;
		});
	}

	return {
		cardWidth: options.cardWidth,
		cardHeight: options.cardHeight,
		columnGap: options.columnGap,
		roundTop: options.roundTop,
		boardPaddingRight: options.boardPaddingRight,
		columnLefts: options.columnLefts,
		cardTops,
	};
}

function createBoardView(variant: BoardView['variant'], layout: Layout, compact: boolean): BoardView {
	const lastRoundIndex = Math.max(rounds.length - 1, 0);
	const firstRoundTops = layout.cardTops[0] ?? [];
	const lastFirstRoundTop = firstRoundTops[firstRoundTops.length - 1] ?? 0;
	const width = getX(layout, lastRoundIndex) + layout.cardWidth + layout.boardPaddingRight;

	const finalMatch = rounds[rounds.length - 1]?.matches[0];
	const finalColor = getMatchWinnerColor(finalMatch) ?? '#1d4ed8';
	const showFlag = !!getMatchWinnerName(finalMatch ?? { player1: '', player2: '' });

	const flagWidth = compact ? 128 : 148;
	const stringHeight = compact ? 14 : 18;
	const finalLeft = getX(layout, lastRoundIndex);
	const finalTop = getY(layout, lastRoundIndex, 0);
	const flagLeft = finalLeft + (layout.cardWidth - flagWidth) / 2;
	const flagTop = finalTop + layout.cardHeight;

	const baseHeight = layout.roundTop + lastFirstRoundTop + layout.cardHeight + 44;
	const height = showFlag ? flagTop + stringHeight + (compact ? 168 : 184) : baseHeight;

	return {
		variant,
		compact,
		layout,
		width,
		height,
		flagLeft,
		flagTop,
		flagWidth,
		showFlag,
		connectors: connectorSegments(layout),
		finalColor,
	};
}

function getX(layout: Layout, roundIndex: number) {
	if (layout.columnLefts?.[roundIndex] !== undefined) return layout.columnLefts[roundIndex]!;
	return roundIndex * (layout.cardWidth + layout.columnGap);
}

function getY(layout: Layout, roundIndex: number, gameIndex: number) {
	return layout.roundTop + (layout.cardTops[roundIndex]?.[gameIndex] ?? 0);
}

function getCenterY(layout: Layout, roundIndex: number, gameIndex: number) {
	return getY(layout, roundIndex, gameIndex) + layout.cardHeight / 2;
}

function connectorSegments(layout: Layout): PathSegment[] {
	const NEUTRAL = '#cbd5e1';
	const seg = (d: string, winnerColor: string | null): PathSegment => ({
		d,
		color: winnerColor ?? NEUTRAL,
		strokeWidth: winnerColor ? 2.5 : 2,
	});

	const segs: PathSegment[] = [];

	for (let fromRound = 0; fromRound < rounds.length - 1; fromRound++) {
		const nextRound = rounds[fromRound + 1];
		if (!nextRound) continue;

		for (let pairIndex = 0; pairIndex < nextRound.matches.length; pairIndex++) {
			const firstGame = pairIndex * 2;
			const secondGame = firstGame + 1;
			if (layout.cardTops[fromRound]?.[firstGame] === undefined) continue;

			const x1 = getX(layout, fromRound) + layout.cardWidth;
			const x2 = getX(layout, fromRound + 1);
			const midX = x1 + (x2 - x1) / 2;
			const y1 = getCenterY(layout, fromRound, firstGame);
			const y2 = layout.cardTops[fromRound]?.[secondGame] === undefined
				? y1
				: getCenterY(layout, fromRound, secondGame);
			const y3 = getCenterY(layout, fromRound + 1, pairIndex);

			const c1 = getMatchWinnerColor(rounds[fromRound]?.matches[firstGame]);
			const c2 = getMatchWinnerColor(rounds[fromRound]?.matches[secondGame]);
			const ct = getMatchWinnerColor(nextRound.matches[pairIndex]);

			if (y1 === y2) {
				segs.push(seg(`M ${x1} ${y1} H ${x2}`, c1));
			} else {
				segs.push(seg(`M ${x1} ${y1} H ${midX}`, c1));      // top stub
				segs.push(seg(`M ${midX} ${y1} V ${y2}`, null));     // stem — always neutral
				segs.push(seg(`M ${midX} ${y2} H ${x1}`, c2));      // bottom stub
				segs.push(seg(`M ${midX} ${y3} H ${x2}`, ct));      // trunk
			}
		}
	}

	return segs;
}

function roundLabel(round: EventBracketRound, roundIndex: number) {
	if (roundIndex === 0 && round.matches.length === 8) return 'First Round';
	if (roundIndex === rounds.length - 1) return 'Final';
	return round.label.replace(/^Finals$/i, 'Final');
}

function isGhostName(name: string) {
	const upper = name.trim().toUpperCase();
	return upper === '' || upper === 'BYE' || upper === 'TBD';
}

function isLinkablePlayer(name: string) {
	const trimmed = name.trim();
	if (isGhostName(trimmed) || trimmed.includes('/') || trimmed.startsWith('Winner ')) return false;
	// Don't link abbreviated names (single-letter first name) — their slug won't match a player page
	const parts = trimmed.split(/\s+/);
	return parts.length >= 2 && parts[0]!.length > 1;
}

function abbreviateName(name: string) {
	if (name.includes('/')) {
		return name.split(/\s*\/\s*/).map(abbreviateNamePart).join(' / ');
	}
	return abbreviateNamePart(name);
}

function abbreviateNamePart(name: string) {
	const parts = name.trim().replace(/\./g, '').split(/\s+/).filter(Boolean);
	if (parts.length < 2) return name;
	return `${parts[0]![0]} ${parts[parts.length - 1]}`;
}

function isAbbreviatedName(name: string): boolean {
	const parts = name.trim().split(/\s+/);
	return parts.length >= 2 && parts[0]!.length === 1;
}

function fullNamePart(name: string): string {
	const trimmed = name.trim();
	if (isGhostName(trimmed)) return trimmed;

	const indexed = playerIndex.get(trimmed.toLowerCase());
	if (indexed) return indexed.name;

	if (isAbbreviatedName(trimmed)) {
		const initial = trimmed[0]!.toLowerCase();
		const last = trimmed.split(/\s+/).pop()!.toLowerCase();
		const match = allPlayers.find((player) => {
			const parts = player.name.trim().split(/\s+/);
			return (
				parts.length >= 2 &&
				parts[0]![0]!.toLowerCase() === initial &&
				parts[parts.length - 1]!.toLowerCase() === last
			);
		});
		if (match) return match.name;
	}

	return trimmed;
}

function fullNameFor(rawName: string): string {
	if (rawName.includes('/')) {
		return rawName.split(/\s*\/\s*/).map(fullNamePart).join(' / ');
	}
	return fullNamePart(rawName);
}

function championNameSegments(rawName: string, scheduledTime?: string): NameSegment[] {
	const fullName = fullNameFor(rawName);

	if (rawName.includes('/')) {
		const ctx =
			bracketTeamCtx && scheduledTime
				? { ...bracketTeamCtx, time: scheduledTime }
				: bracketTeamCtx;
		const members = resolveTeamMembers(rawName, allPlayers, ctx);
		const fullParts = fullName.split(/\s*\/\s*/);
		return members.map((member, index) => ({
			text: member.name || fullParts[index] || rawName,
			href: member.slug ? `/players/${member.slug}` : undefined,
		}));
	}

	return nameSegments(rawName, fullName, scheduledTime);
}

function feederLabel(roundIndex: number, gameIndex: number, side: 1 | 2) {
	if (roundIndex === 0) return '';
	const feederIndex = gameIndex * 2 + (side === 1 ? 0 : 1);
	const feeder = rounds[roundIndex - 1]?.matches[feederIndex];
	return feeder?.matchId ? `Winner ${feeder.matchId}` : '';
}

function displayNameFor(match: EventBracketMatch, roundIndex: number, gameIndex: number, side: 1 | 2) {
	const rawName = side === 1 ? match.player1 : match.player2;
	if (rawName.trim().toUpperCase() === 'TBD' || rawName.trim() === '') {
		return feederLabel(roundIndex, gameIndex, side) || rawName;
	}
	if (roundIndex > 0 && !isGhostName(rawName)) return abbreviateName(rawName);
	return rawName;
}

function playerLocation(rawName: string, roundIndex: number) {
	if (roundIndex > 0 || !isLinkablePlayer(rawName)) return '';
	return playerIndex.get(rawName.toLowerCase())?.city ?? '';
}

function nameSegments(rawName: string, displayName: string, scheduledTime?: string): NameSegment[] {
	if (isLinkablePlayer(rawName)) {
		return [{ text: displayName, href: `/players/${getPlayerSlug(rawName)}` }];
	}

	if (rawName.includes('/') && !displayName.startsWith('Winner ')) {
		const ctx =
			bracketTeamCtx && scheduledTime
				? { ...bracketTeamCtx, time: scheduledTime }
				: bracketTeamCtx;
		const rawMembers = resolveTeamMembers(rawName, allPlayers, ctx);
		const displayParts = displayName.split(/\s*\/\s*/);
		return rawMembers.map((member, index) => ({
			text: displayParts[index] ?? member.name,
			href: member.slug ? `/players/${member.slug}` : undefined,
		}));
	}

	return [{ text: displayName }];
}

function buildSide(match: EventBracketMatch, roundIndex: number, gameIndex: number, side: 1 | 2): BracketSide {
	const rawName = side === 1 ? match.player1 : match.player2;
	const displayName = displayNameFor(match, roundIndex, gameIndex, side);
	const seed = side === 1 ? match.seed1 : match.seed2;
	const winner = match.winner === side;
	const winnerColor = winner ? (winnerColorMap.get(rawName) ?? null) : null;

	return {
		seed,
		rawName,
		displayName,
		location: playerLocation(rawName, roundIndex),
		winner,
		winnerColor,
		bye: rawName.trim().toUpperCase() === 'BYE',
		segments: nameSegments(rawName, displayName, match.scheduledTime),
	};
}

function matchStatus(match: EventBracketMatch) {
	if (match.player1.toUpperCase() === 'BYE' || match.player2.toUpperCase() === 'BYE') return 'Bye';
	if (match.score) return match.score;
	if (!match.scheduledTime) return 'TBD';

	const [rawDay, rawTime] = match.scheduledTime.split('·').map((part) => part.trim());
	const dayMap: Record<string, string> = {
		Friday: 'Fr',
		Saturday: 'Sa',
		Sunday: 'Su',
		Monday: 'Mo',
		Tuesday: 'Tu',
		Wednesday: 'We',
		Thursday: 'Th',
	};
	const day = dayMap[rawDay ?? ''] ?? rawDay ?? '';
	const timeMatch = (rawTime ?? '').match(/^(\d{1,2}):(\d{2})\s*([AP])M$/i);
	const time = timeMatch ? `${timeMatch[1]}:${timeMatch[2]} ${timeMatch[3]!.toUpperCase()}` : rawTime ?? '';
	const courtMatch = match.court?.match(/Court\s*#?\s*(\w+)/i);
	const court = courtMatch ? ` #${courtMatch[1]}` : '';

	return `${day} ${time}${court}`.trim();
}

const lastRoundIndex = Math.max(rounds.length - 1, 0);
const finalMatch = rounds[lastRoundIndex]?.matches[0];
const championSide =
	finalMatch?.winner === 1
		? buildSide(finalMatch, lastRoundIndex, 0, 1)
		: finalMatch?.winner === 2
			? buildSide(finalMatch, lastRoundIndex, 0, 2)
			: null;
const championColor = championSide?.winnerColor ?? getMatchWinnerColor(finalMatch) ?? '#1d4ed8';
const championSegments = championSide
	? championNameSegments(championSide.rawName, finalMatch?.scheduledTime)
	: [];
---

{rounds.length > 0 && (
	<div class="gp-single-bracket-shell">
		{boardViews.map((view) => (
			<div class:list={['gp-draw-scroll', `gp-draw-scroll--${view.variant}`]}>
				<div
					class="gp-draw-board"
					style={`width: ${view.width}px; height: ${view.height}px;`}
					aria-label={`${division.label} bracket`}
				>
					<svg
						class="gp-draw-connectors"
						width={view.width}
						height={view.height}
						viewBox={`0 0 ${view.width} ${view.height}`}
						aria-hidden="true"
					>
						{view.connectors.map((seg) => (
							<path
								d={seg.d}
								fill="none"
								stroke={seg.color}
								stroke-width={seg.strokeWidth}
								stroke-linejoin="round"
							/>
						))}
					</svg>

					{rounds.map((round, roundIndex) => (
						<div
							class:list={['gp-draw-round-label', view.compact && 'gp-draw-round-label--compact']}
							style={`left: ${getX(view.layout, roundIndex)}px; top: 0; width: ${view.layout.cardWidth}px;`}
						>
							{roundLabel(round, roundIndex)}
						</div>
					))}

					{view.showFlag && championSide && (
						<div
							class:list={['gp-draw-champion-flag', view.compact && 'gp-draw-champion-flag--compact']}
							style={`left: ${view.flagLeft}px; top: ${view.flagTop}px; width: ${view.flagWidth}px; --flag-color: ${championColor};`}
						>
							<div class="gp-draw-flag-strings" aria-hidden="true">
								<span></span>
								<span></span>
							</div>
							<div class="gp-draw-flag-body">
								<div class="gp-draw-flag-year">2026</div>
								<svg class="gp-draw-flag-trophy" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
								</svg>
								<div class="gp-draw-flag-name">
									{championSegments.map((segment, segmentIndex) => (
										<>
											{segment.href ? <a href={segment.href}>{segment.text}</a> : segment.text}
											{segmentIndex < championSegments.length - 1 && ' / '}
										</>
									))}
								</div>
								<div class="gp-draw-flag-label">Champion</div>
							</div>
						</div>
					)}

					{rounds.map((round, roundIndex) =>
						round.matches.map((match, gameIndex) => {
							const sideA = buildSide(match, roundIndex, gameIndex, 1);
							const sideB = buildSide(match, roundIndex, gameIndex, 2);
							const status = matchStatus(match);

							return (
								<div
									class="gp-draw-card-slot"
									style={`left: ${getX(view.layout, roundIndex)}px; top: ${getY(view.layout, roundIndex, gameIndex)}px; width: ${view.layout.cardWidth}px; height: ${view.layout.cardHeight}px;`}
								>
									<div class:list={['gp-draw-card', view.compact && 'gp-draw-card--compact']}>
										<div class:list={['gp-draw-card-head', view.compact && 'gp-draw-card-head--compact']}>
											<div>
												<div class:list={['gp-draw-kicker', view.compact && 'gp-draw-kicker--compact']}>Match</div>
												<div class:list={['gp-draw-id', view.compact && 'gp-draw-id--compact']}>
													{match.matchId ?? `${roundIndex + 1}-${gameIndex + 1}`}
												</div>
											</div>
											<div class:list={['gp-draw-status', view.compact && 'gp-draw-status--compact']}>{status}</div>
										</div>

										<div class="gp-draw-card-body">
											{[sideA, sideB].map((side, sideIndex) => (
												<>
													<div
														class:list={[
															'gp-draw-player-row',
															view.compact && 'gp-draw-player-row--compact',
															side.winner && 'is-winner',
															side.bye && 'is-bye',
														]}
														style={side.winnerColor ? `--wc:${side.winnerColor}` : undefined}
													>
														<span
															class:list={[
																'gp-draw-seed',
																view.compact && 'gp-draw-seed--compact',
																side.winner && 'is-winner',
															]}
														>
															{side.seed ?? '-'}
														</span>
														<span class="gp-draw-player-copy">
															<span
																class:list={[
																	'gp-draw-player-name',
																	view.compact && 'gp-draw-player-name--compact',
																	side.winner && 'is-winner',
																	side.bye && 'is-bye',
																]}
															>
																{side.segments.map((segment, segmentIndex) => (
																	<>
																		{segment.href ? <a href={segment.href}>{segment.text}</a> : segment.text}
																		{segmentIndex < side.segments.length - 1 && ' / '}
																	</>
																))}
															</span>
															{side.location && (
																<span class:list={['gp-draw-player-location', view.compact && 'gp-draw-player-location--compact']}>
																	{side.location}
																</span>
															)}
														</span>
														{side.winner ? (
															<span class:list={['gp-draw-winner-arrow', view.compact && 'gp-draw-winner-arrow--compact']}>&rsaquo;</span>
														) : (
															<span class:list={['gp-draw-arrow-spacer', view.compact && 'gp-draw-arrow-spacer--compact']}></span>
														)}
													</div>
													{sideIndex === 0 && <div class="gp-draw-row-divider"></div>}
												</>
											))}
										</div>
									</div>
								</div>
							);
						})
					)}
				</div>
			</div>
		))}
	</div>
)}

<style>
.gp-single-bracket-shell {
	position: relative;
	left: 50%;
	width: min(1440px, calc(100vw - 44px));
	margin: 0;
	padding: 32px 28px 48px;
	transform: translateX(-50%);
	overflow-x: hidden;
	overflow-y: visible;
	border: 1px solid rgba(255, 255, 255, 0.72);
	border-radius: 22px;
	background: #e8eaee;
	box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.75);
	color: #0f172a;
}

.gp-draw-scroll {
	overflow-x: auto;
	overflow-y: visible;
	padding-bottom: 48px;
	-webkit-overflow-scrolling: touch;
	scrollbar-width: thin;
	scrollbar-color: #94a3b8 transparent;
}

.gp-draw-scroll--desktop {
	overflow-x: clip;
	overflow-y: visible;
}

.gp-draw-scroll--mobile {
	display: none;
}

.gp-draw-board {
	position: relative;
	margin: 0 auto;
	overflow: visible;
}

.gp-draw-connectors {
	position: absolute;
	left: 0;
	top: 0;
	z-index: 0;
	overflow: visible;
	pointer-events: none;
}

.gp-draw-round-label,
.gp-draw-champion-flag,
.gp-draw-card-slot {
	position: absolute;
}

.gp-draw-round-label {
	z-index: 2;
	border-radius: 8px;
	background: #cbd5e1;
	padding: 8px 12px;
	font-size: 12px;
	font-weight: 900;
	letter-spacing: 0.06em;
	line-height: 1.1;
	text-align: left;
	text-transform: uppercase;
	color: #334155;
}

.gp-draw-round-label--compact {
	padding: 6px 10px;
	font-size: 10px;
}

.gp-draw-champion-flag {
	z-index: 4;
	display: flex;
	flex-direction: column;
	align-items: stretch;
	overflow: visible;
	pointer-events: none;
	animation: gpFlagDrop 0.45s ease both;
	animation-delay: 0.2s;
}

.gp-draw-champion-flag--compact {
	animation-delay: 0.15s;
}

@keyframes gpFlagDrop {
	from {
		opacity: 0;
		transform: translateY(-8px);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

.gp-draw-flag-strings {
	display: flex;
	justify-content: space-between;
