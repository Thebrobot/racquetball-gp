---
/**
 * One-time welcome for signed-out gallery visitors: a few recent photos, a row
 * of player faces, and the invitation to claim a player profile. Shares the
 * dismissal key with the site-wide announcement card, so closing either hides both.
 */
import { Image } from 'astro:assets';
import type { GalleryPhoto } from '../../lib/gallery/types';
import { getAllPlayers } from '../../data/players';
import { getPlayerImageForDisplay } from '../../data/player-images';
import { createAdminClient } from '../../lib/accounts/supabase';

interface Props {
	photos: GalleryPhoto[];
	/** Skip entirely (signed in, or the page opened straight onto a shared photo). */
	show: boolean;
}
const { photos, show } = Astro.props;
const CAMPAIGN = 'accounts-2026-10';

// Most recent four. The index rarely stores dimensions, so the cards use a fixed
// 4:5 frame and let object-fit crop (the image service resizes by width only).
const picks = show ? [...photos].sort((a, b) => b.createdAt.localeCompare(a.createdAt)).slice(0, 4) : [];

// Faces: players who already claimed a profile first, then the rest, 7 in all.
let verified = new Set<string>();
if (show) {
	const admin = createAdminClient();
	if (admin) {
		const { data } = await admin.from('verified_players').select('player_slug');
		verified = new Set(((data ?? []) as { player_slug: string }[]).map((r) => r.player_slug));
	}
}
const everyone = getAllPlayers()
	.map((p) => ({ name: p.name, slug: p.slug, photo: getPlayerImageForDisplay(p.name, 56) }))
	.filter((p): p is typeof p & { photo: string } => Boolean(p.photo));
const faces = show
	? [...everyone.filter((p) => verified.has(p.slug)), ...everyone.filter((p) => !verified.has(p.slug))].slice(0, 7)
	: [];
const playerCount = getAllPlayers().length;
const claimed = verified.size;
---

{show && picks.length >= 3 && (
	<div class="gwel" id="gallery-welcome" data-campaign={CAMPAIGN} role="dialog" aria-modal="true" aria-labelledby="gwel-title" hidden>
		<div class="gwel-backdrop" data-gwel-close></div>
		<div class="gwel-card">
			<button type="button" class="gwel-close" aria-label="Not now" data-gwel-close>×</button>
			<div class="gwel-photos" aria-hidden="true">
				{picks.map((p, i) => (
					<div class={`gwel-photo gwel-photo--${i + 1}`}>
						<Image src={p.url} width={360} height={450} format="webp" quality={70} alt="" loading="eager" />
					</div>
				))}
			</div>
			<div class="gwel-body">
				<div class="gwel-faces">
					<ul class="gwel-face-row" aria-label="Players">
						{faces.map((f) => (
							<li class:list={['gwel-face', { 'gwel-face--claimed': verified.has(f.slug) }]} title={f.name}>
								<img src={f.photo} alt="" width="56" height="56" loading="eager" decoding="async" />
							</li>
						))}
					</ul>
					<p class="gwel-face-note">
						{claimed > 0 ? (
							<>
								<strong>{claimed}</strong> of {playerCount} players have claimed their profile
							</>
						) : (
							<>
								<strong>{playerCount}</strong> player profiles ready to claim
							</>
						)}
					</p>
				</div>
				<p class="gwel-kicker">Spot yourself on the court?</p>
				<h2 class="gwel-title" id="gwel-title">Claim your player profile</h2>
				<p class="gwel-text">
					Create a free account to tag yourself in gallery photos, like and comment, and have every shot of you show up on
					your player page.
				</p>
				<div class="gwel-actions">
					<a class="gwel-btn gwel-btn--primary" href="/signup">Create account</a>
					<a class="gwel-btn" href="/account">Sign in</a>
				</div>
				<button type="button" class="gwel-skip" data-gwel-close>Just browsing for now</button>
			</div>
		</div>
	</div>
)}

<script>
	const dlg = document.getElementById('gallery-welcome');
	if (dlg) {
		const key = `gp:announce:${dlg.dataset.campaign}`;
		let dismissed = false;
		try {
			dismissed = localStorage.getItem(key) === '1';
		} catch {
			/* ignore */
		}
		const close = () => {
			dlg.classList.remove('is-in');
			document.documentElement.classList.remove('gwel-open');
			setTimeout(() => (dlg.hidden = true), 300);
			try {
				localStorage.setItem(key, '1');
			} catch {
				/* ignore */
			}
		};
		if (!dismissed) {
			setTimeout(() => {
				// Don't interrupt someone who already opened a photo.
				if (document.querySelector('.gallery-lightbox:not([hidden]), .gfeed:not([hidden])')) return;
				dlg.hidden = false;
				document.documentElement.classList.add('gwel-open');
				requestAnimationFrame(() => dlg.classList.add('is-in'));
				(dlg.querySelector<HTMLElement>('.gwel-btn--primary') ?? dlg).focus();
			}, 1400);
		}
		dlg.querySelectorAll('[data-gwel-close]').forEach((el) => el.addEventListener('click', close));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !dlg.hidden) close();
		});
	}
</script>
