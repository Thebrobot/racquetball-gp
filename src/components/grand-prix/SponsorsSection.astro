---
import { ocalaSponsors, titleSponsor } from '../../data/ocala-sponsors';
---

<div id="sponsors" class="sponsors-section-page">
	<section class="sponsors-section-inner">
		<div class="section-label" style="text-align:center;">Presented by</div>
		<div class="section-title" style="text-align:center; margin-bottom:12px;">
			Our <span style="color:var(--orange)">Sponsors</span>
		</div>
		<p
			style="color:var(--muted);font-size:17px;max-width:520px;margin:0 auto 48px;line-height:1.65;text-align:center;"
		>
			The Florida Grand Prix is made possible by the generous support of our partners. From the title
			sponsor through local supporters, every partner helps us grow the game.
		</p>
		<div class="sponsors-grid">
			<a
				class="sponsor-slot filled sponsor-slot-title sponsor-card sponsor-card--title"
				href={titleSponsor.url}
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="sponsor-slot-title-kicker">Title sponsor</span>
				<img
					class="sponsor-card-logo sponsor-card-logo--title"
					src={titleSponsor.logoUrl}
					alt={`${titleSponsor.name} logo`}
					loading="lazy"
					decoding="async"
				/>
				<span class="sponsor-slot-title-name">{titleSponsor.name}</span>
				<span class="sponsor-card-blurb">{titleSponsor.blurb}</span>
			</a>
			{ocalaSponsors.map((sponsor) => {
				const Tag = sponsor.url ? 'a' : 'div';
				return (
					<Tag
						class="sponsor-slot filled sponsor-card"
						{...(sponsor.url
							? { href: sponsor.url, target: '_blank', rel: 'noopener noreferrer' }
							: {})}
					>
						<img
							class="sponsor-card-logo"
							src={sponsor.logoUrl}
							alt={`${sponsor.name} logo`}
							loading="lazy"
							decoding="async"
						/>
						<span class="sponsor-card-name">{sponsor.name}</span>
						<span class="sponsor-card-blurb">{sponsor.blurb}</span>
					</Tag>
				);
			})}
		</div>
		<p class="sponsor-cta">
			Interested in sponsoring the Florida Grand Prix? <a href="/contact">Contact us →</a>
		</p>
	</section>
</div>
