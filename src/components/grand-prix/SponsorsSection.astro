---
import { ocalaSponsors, titleSponsor } from '../../data/ocala-sponsors';
import { tournamentDirector } from '../../data/contacts';

const sponsorMailto = `mailto:${tournamentDirector.email}?subject=${encodeURIComponent('Florida Grand Prix: sponsorship inquiry')}`;

function isExternal(href?: string): boolean {
	return Boolean(href && /^https?:/i.test(href));
}
---

<div id="sponsors">
	<section class="gp-band gp-band--navy2 gp-band--tight title-band" aria-labelledby="title-sponsor-heading">
		<div class="gp-band-inner title-band-inner">
			<a
				class="title-band-logo"
				href={titleSponsor.url ?? '#'}
				{...(isExternal(titleSponsor.url) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
				aria-label={`${titleSponsor.name} website`}
			>
				<img src={titleSponsor.logoUrl} alt={`${titleSponsor.name} logo`} loading="lazy" decoding="async" />
			</a>
			<div class="title-band-copy">
				<span class="gp-pill gp-pill--champ">Title sponsor</span>
				<h2 id="title-sponsor-heading" class="title-band-name">{titleSponsor.name}</h2>
				<p class="title-band-blurb">{titleSponsor.blurb}</p>
				{titleSponsor.url && (
					<a class="gp-link" href={titleSponsor.url} target="_blank" rel="noopener noreferrer">
						Visit {titleSponsor.name} →
					</a>
				)}
			</div>
		</div>
	</section>

	<section class="gp-band gp-band--court" aria-labelledby="partners-heading">
		<div class="gp-band-inner">
			<p class="section-label">Series partners</p>
			<h2 id="partners-heading" class="gp-title partners-title">Backing every <span>stop</span></h2>
			<div class="partner-grid">
				{ocalaSponsors.map((sponsor) => {
					const Tag = sponsor.url ? 'a' : 'div';
					return (
						<Tag
							class="partner-card gp-card"
							{...(sponsor.url
								? {
										href: sponsor.url,
										...(isExternal(sponsor.url) ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
									}
								: {})}
						>
							<span class="partner-logo">
								<img src={sponsor.logoUrl} alt={`${sponsor.name} logo`} loading="lazy" decoding="async" />
							</span>
							<span class="partner-name">{sponsor.name}</span>
							<span class="partner-blurb">{sponsor.blurb}</span>
							{sponsor.url && <span class="partner-more">Visit →</span>}
						</Tag>
					);
				})}
			</div>
		</div>
	</section>

	<section class="gp-band partner-cta-band" aria-labelledby="partner-cta-heading">
		<div class="gp-band-inner partner-cta-inner">
			<div>
				<p class="section-label">Become a partner</p>
				<h2 id="partner-cta-heading" class="gp-title partner-cta-title">
					Put your brand <span>on the court</span>
				</h2>
				<p class="gp-sub">
					Four tour weekends, a statewide leaderboard, live streams and a growing player base. Sponsorship
					packages range from a single stop to the full season.
				</p>
			</div>
			<div class="partner-cta-actions">
				<a class="partner-cta-btn" href={sponsorMailto}>Email {tournamentDirector.name.split(' ')[0]}</a>
				<a class="gp-link" href="/contact">All contact options →</a>
			</div>
		</div>
	</section>
</div>

<style>
.title-band-inner {
	display: grid;
	grid-template-columns: 220px minmax(0, 1fr);
	gap: 28px 44px;
	align-items: center;
}
.title-band-logo {
	display: block;
	background: #fff;
	border-radius: 16px;
	padding: 18px;
	border: 1px solid var(--card-border);
}
.title-band-logo img {
	display: block;
	width: 100%;
	height: auto;
	max-height: 140px;
	object-fit: contain;
}
.title-band-copy {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 10px;
}
.title-band-name {
	margin: 0;
	font-family: 'Barlow Condensed', sans-serif;
	font-weight: 900;
	font-size: clamp(32px, 4vw, 48px);
	line-height: 0.95;
	text-transform: uppercase;
}
.title-band-blurb {
	margin: 0 0 4px;
	font-size: 17px;
	line-height: 1.6;
	max-width: 620px;
	color: rgba(255, 255, 255, 0.78);
}
.partners-title {
	font-size: clamp(32px, 4.5vw, 52px);
	margin-bottom: 28px;
}
.partner-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
	gap: 16px;
}
.partner-card {
	display: flex;
	flex-direction: column;
	gap: 8px;
	padding: 18px 18px 16px;
	color: var(--court-ink);
	text-decoration: none;
	transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s;
}
a.partner-card:hover {
	transform: translateY(-3px);
	border-color: rgba(240, 90, 26, 0.4);
	box-shadow: 0 16px 36px rgba(10, 22, 40, 0.12);
}
.partner-logo {
	display: flex;
	align-items: center;
	justify-content: center;
	height: 96px;
	border-radius: 10px;
	background: #f4f5f7;
	border: 1px solid var(--court-line);
	overflow: hidden;
	margin-bottom: 4px;
}
.partner-logo img {
	max-width: 85%;
	max-height: 76px;
	object-fit: contain;
}
.partner-name {
	font-family: 'Barlow Condensed', sans-serif;
	font-weight: 800;
	font-size: 20px;
	letter-spacing: 0.02em;
	text-transform: uppercase;
	line-height: 1.1;
}
.partner-blurb {
	font-size: 14px;
	line-height: 1.5;
	color: var(--court-muted);
}
.partner-more {
	margin-top: auto;
	padding-top: 6px;
	font-family: 'Barlow Condensed', sans-serif;
	font-weight: 700;
	font-size: 13px;
	letter-spacing: 0.1em;
	text-transform: uppercase;
	color: var(--orange);
}
.partner-cta-band {
	border-top: 1px solid var(--card-border);
}
.partner-cta-inner {
	display: grid;
	grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
	gap: 24px 48px;
	align-items: center;
}
.partner-cta-title {
	font-size: clamp(32px, 4.5vw, 52px);
}
.partner-cta-actions {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 14px;
}
.partner-cta-btn {
	font-family: 'Barlow Condensed', sans-serif;
	font-weight: 700;
	font-size: 17px;
	letter-spacing: 0.08em;
	text-transform: uppercase;
	padding: 14px 28px;
	border-radius: 8px;
	background: var(--orange);
	color: #fff;
	text-decoration: none;
	transition: background 0.15s, transform 0.15s;
}
.partner-cta-btn:hover {
	background: var(--orange2);
	transform: translateY(-1px);
}
@media (max-width: 760px) {
	.title-band-inner {
		grid-template-columns: 1fr;
	}
	.title-band-logo {
		max-width: 220px;
	}
	.partner-cta-inner {
		grid-template-columns: 1fr;
	}
}
</style>
