---
/**
 * Phone-first vertical feed for the gallery: opened in place of the two-pane
 * post view on narrow screens. Cards are rendered by gallery-client.ts.
 */
---

<div class="gfeed" id="gallery-feed" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Photo feed">
	<header class="gfeed-top">
		<button type="button" class="gfeed-back" id="gallery-feed-close" aria-label="Back to gallery">
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
		</button>
		<div class="gfeed-top-text">
			<span class="gfeed-title" id="gallery-feed-title">Racquetball Grand Prix</span>
			<span class="gfeed-count" id="gallery-feed-count"></span>
		</div>
	</header>
	<div class="gfeed-scroll" id="gallery-feed-scroll"></div>
</div>
