---
import { GRAND_PRIX_FULL_SCHEDULE, type SeasonStop } from '../../data/season-stops';

function itemClass(kind: SeasonStop['kind']) {
	if (kind === 'done') return 'stop-item done';
	if (kind === 'next') return 'stop-item next';
	if (kind === 'champ') return 'stop-item champ';
	return 'stop-item';
}
---

<div class="season-strip" aria-label="Season schedule">
	<div class="strip-track">
		{
			GRAND_PRIX_FULL_SCHEDULE.map((stop) => {
				const href = stop.bracketsHref ?? stop.participantsHref;
				const inner = (
					<>
						<span class="stop-dot"></span>
						<span>
							<span class="stop-num">{stop.label}</span>
							{stop.cityLine} · {stop.dateHint}
						</span>
					</>
				);
				return href ? (
					<a class={itemClass(stop.kind)} href={href} aria-label={`${stop.eventName} brackets`}>
						{inner}
					</a>
				) : (
					<div class={itemClass(stop.kind)}>{inner}</div>
				);
			})
		}
	</div>
</div>
