---
/**
 * Email-link landing for sign-up verification, magic links and password
 * resets. Handles both link styles Supabase can send: `?code=` (PKCE, same
 * browser) and `?token_hash=&type=` (works across devices). After a
 * successful sign-up, links the player pick from the form when it is still free.
 */
import { createSessionClient } from '../../lib/accounts/supabase';
import { accountAfterLink, linkPlayerToAccount } from '../../lib/accounts/player-link';

export const prerender = false;

const client = createSessionClient(Astro.request, Astro.cookies);
const params = Astro.url.searchParams;
let next = params.get('next') ?? '/account';
if (!next.startsWith('/') || next.startsWith('//')) next = '/account';

type OtpType = 'magiclink' | 'email' | 'signup' | 'recovery' | 'invite' | 'email_change';
const OTP_TYPES: OtpType[] = ['magiclink', 'email', 'signup', 'recovery', 'invite', 'email_change'];

/** Link the player picked on the sign-up form, once the email is confirmed. */
async function claimFromSignup(): Promise<string | null> {
	if (!client) return null;
	const { data } = await client.auth.getUser();
	const user = data.user;
	const slug = user?.user_metadata?.claim_player_slug as string | undefined;
	if (!user || !slug) return null;
	const result = await linkPlayerToAccount({
		userId: user.id,
		slug,
		note: 'Picked at sign-up',
		sessionClient: client,
	});
	if (result.status === 'invalid' || result.status === 'error') return null;
	return accountAfterLink(result);
}

let errorMessage: string;
if (!client) {
	errorMessage = 'Accounts are not set up yet.';
} else {
	const code = params.get('code');
	const tokenHash = params.get('token_hash');
	const type = params.get('type');
	let ok = false;
	let isRecovery = false;
	if (code) {
		const { error } = await client.auth.exchangeCodeForSession(code);
		ok = !error;
		isRecovery = ok && type === 'recovery';
	} else if (tokenHash && type && OTP_TYPES.includes(type as OtpType)) {
		const { error } = await client.auth.verifyOtp({ token_hash: tokenHash, type: type as OtpType });
		ok = !error;
		isRecovery = ok && type === 'recovery';
	}
	if (ok) {
		const linkedTo = await claimFromSignup().catch(() => null);
		return Astro.redirect(isRecovery ? '/account/password' : (linkedTo ?? next), 303);
	}
	errorMessage = code || tokenHash
		? 'That link has expired or was already used. Links work once and only in the browser that requested them.'
		: (params.get('error_description') ?? 'Missing sign-in code.');
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Sign in | Florida Racquetball Grand Prix</title>
		<style>
			body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0a1628; color: #fff; font-family: system-ui, sans-serif; }
			main { max-width: 440px; padding: 32px; text-align: center; line-height: 1.5; }
			a { color: #ff7a3d; }
		</style>
	</head>
	<body>
		<main>
			<h1>Link problem</h1>
			<p>{errorMessage}</p>
			<p><a href="/account">Sign in</a> · <a href="/account?forgot=1">Request a new link</a></p>
		</main>
	</body>
</html>
