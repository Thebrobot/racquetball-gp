---
import GrandPrixLayout from '../layouts/GrandPrixLayout.astro';
import SponsorsSection from '../components/grand-prix/SponsorsSection.astro';
import { ocalaSponsors } from '../data/ocala-sponsors';

const partnerCount = ocalaSponsors.length + 1;
---

<GrandPrixLayout
	title="Sponsors | Florida Racquetball Grand Prix"
	description="Partners and sponsors of the Florida Racquetball Grand Prix: title, presenting, and supporting brands behind Florida's statewide series."
	hideSponsorSpotlight
>
	<header class="gp-page-head">
		<div class="gp-page-head-inner">
			<div>
				<p class="section-label">Presented by</p>
				<h1 class="gp-title">Our <span>sponsors</span></h1>
				<p class="gp-sub">
					{partnerCount} partners make the Florida Grand Prix possible, from the title sponsor to the local
					businesses and players who back every stop.
				</p>
			</div>
		</div>
	</header>

	<SponsorsSection />
</GrandPrixLayout>
