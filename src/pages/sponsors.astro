---
import GrandPrixLayout from '../layouts/GrandPrixLayout.astro';
import SponsorsSection from '../components/grand-prix/SponsorsSection.astro';
import { titleSponsor } from '../data/ocala-sponsors';
---

<GrandPrixLayout
	title="Sponsors | Florida Racquetball Grand Prix"
	description="Partners and sponsors of the Florida Racquetball Grand Prix: title, presenting, and supporting brands."
	spotlightLabel="Title sponsor"
	spotlightName={titleSponsor.name}
	spotlightBlurb={titleSponsor.blurb}
	spotlightLogoUrl={titleSponsor.logoUrl}
>
	<SponsorsSection />
</GrandPrixLayout>
