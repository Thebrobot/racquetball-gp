---
import GrandPrixLayout from '../../layouts/GrandPrixLayout.astro';
import { accountsConfigured, createAdminClient, getSession } from '../../lib/accounts/supabase';
import { albumLabel } from '../../lib/gallery/albums';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

const session = accountsConfigured() ? await getSession(Astro.request, Astro.cookies) : null;
if (!session) return Astro.redirect('/account?next=/admin', 303);
if (!session.isAdmin) return Astro.redirect('/account', 303);

const admin = createAdminClient();
type HeldComment = { id: string; photo_id: string; body: string; status: string; created_at: string; profiles: { email: string; display_name: string | null; player_slug: string | null } | null; reports: number };
type Claim = { id: string; user_id: string; player_slug: string; player_name: string; note: string | null; created_at: string; status: string; profiles: { email: string; display_name: string | null } | null };
let pending: Claim[] = [];
let recent: Claim[] = [];
let counts = { profiles: 0, verified: 0, likes: 0, views: 0 };
type Submission = { id: string; album: string; caption: string | null; url: string; width: number | null; height: number | null; created_at: string; profiles: { email: string; display_name: string | null; player_slug: string | null } | null };
let submissions: Submission[] = [];
let held: HeldComment[] = [];
if (admin) {
	const { data: subs } = await admin
		.from('photo_submissions')
		.select('id, album, caption, url, width, height, created_at, profiles!photo_submissions_user_id_fkey(email, display_name, player_slug)')
		.eq('status', 'pending')
		.order('created_at')
		.limit(100);
	submissions = (subs as unknown as Submission[] | null) ?? [];
	const { data: hc } = await admin
		.from('photo_comments')
		.select('id, photo_id, body, status, created_at, profiles!photo_comments_user_id_fkey(email, display_name, player_slug)')
		.in('status', ['pending', 'hidden'])
		.order('created_at', { ascending: false })
		.limit(50);
	const rows = (hc as unknown as Omit<HeldComment, 'reports'>[] | null) ?? [];
	const ids = rows.map((r) => r.id);
	const reportCounts = new Map<string, number>();
	if (ids.length) {
		const { data: reps } = await admin.from('comment_reports').select('comment_id').in('comment_id', ids);
		for (const r of (reps ?? []) as { comment_id: string }[]) reportCounts.set(r.comment_id, (reportCounts.get(r.comment_id) ?? 0) + 1);
	}
	held = rows.map((r) => ({ ...r, reports: reportCounts.get(r.id) ?? 0 }));
	const [{ data: p }, { data: r }, prof, ver, likes, views] = await Promise.all([
		admin.from('profile_claims').select('id, user_id, player_slug, player_name, note, created_at, status, profiles(email, display_name)').eq('status', 'pending').order('created_at'),
		admin.from('profile_claims').select('id, user_id, player_slug, player_name, note, created_at, status, profiles(email, display_name)').neq('status', 'pending').order('decided_at', { ascending: false }).limit(10),
		admin.from('profiles').select('id', { count: 'exact', head: true }),
		admin.from('profiles').select('id', { count: 'exact', head: true }).not('player_slug', 'is', null),
		admin.from('photo_likes').select('photo_id', { count: 'exact', head: true }),
		admin.from('photo_views').select('photo_id', { count: 'exact', head: true }),
	]);
	pending = (p as unknown as Claim[] | null) ?? [];
	recent = (r as unknown as Claim[] | null) ?? [];
	counts = { profiles: prof.count ?? 0, verified: ver.count ?? 0, likes: likes.count ?? 0, views: views.count ?? 0 };
}
const flag = Astro.url.searchParams.get('claims') ?? '';
const commentFlag = Astro.url.searchParams.get('comments') ?? '';
const photoFlag = Astro.url.searchParams.get('photos') ?? '';
const photoFlagText: Record<string, string> = { approved: 'Photo approved and added to the gallery.', approved_all: 'Photos approved and added to the gallery.', rejected: 'Photo rejected and removed.', already: 'That photo was already decided.', error: 'Could not move the photo into the gallery. Try again.' };
const commentFlagText: Record<string, string> = { approved: 'Comment approved and visible.', deleted: 'Comment deleted.' };
const flagText: Record<string, string> = { approved: 'Claim approved and profile linked.', rejectd: 'Claim rejected.', rejected: 'Claim rejected.', already: 'That claim was already decided.' };
function when(iso: string): string {
	return new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
}
---

<GrandPrixLayout title="Admin | Florida Racquetball Grand Prix" description="Series admin." noindex hideSponsorSpotlight>
	<header class="gp-page-head">
		<div class="gp-page-head-inner gp-page-head-inner--split">
			<div>
				<p class="section-label">Signed in as {session.user.email}</p>
				<h1 class="gp-title">Admin <span>queue</span></h1>
				<p class="gp-sub">Profile claims and comments that need a look wait here. Approving a claim links the account to the player page and shows the verified badge.</p>
			</div>
			<ul class="gp-stat-row">
				<li><strong>{counts.profiles}</strong><span>Accounts</span></li>
				<li><strong>{counts.verified}</strong><span>Verified players</span></li>
				<li><strong>{counts.likes}</strong><span>Likes</span></li>
				<li><strong>{counts.views}</strong><span>Photo views</span></li>
			</ul>
		</div>
	</header>

	<section class="gp-band gp-band--tight adm">
		<div class="gp-band-inner">
			{!admin && <p class="adm-warn">The service role key is missing, so the queue cannot load.</p>}
			{flag && flagText[flag] && <p class="adm-ok">{flagText[flag]}</p>}

			<h2 class="adm-h2">Pending claims <span class="adm-count">{pending.length}</span></h2>
			{pending.length === 0 ? (
				<p class="adm-empty">Nothing waiting. New claims show up here as players sign up.</p>
			) : (
				<ul class="adm-list">
					{pending.map((c) => (
						<li class="gp-card adm-item">
							<div class="adm-item-main">
								<p class="adm-item-title">
									<a href={`/players/${c.player_slug}`} target="_blank" rel="noopener">{c.player_name}</a>
									<span class="adm-item-arrow" aria-hidden="true">←</span>
									<span>{c.profiles?.display_name ?? 'Unnamed'}</span>
								</p>
								<p class="adm-item-meta">{c.profiles?.email ?? 'unknown email'} · requested {when(c.created_at)}</p>
								{c.note && <p class="adm-item-note">“{c.note}”</p>}
							</div>
							<form class="adm-item-actions" method="post" action="/api/admin/claims">
								<input type="hidden" name="id" value={c.id} />
								<label class="adm-check"><input type="checkbox" name="junior" /> Junior (comments need approval)</label>
								<button class="btn-main adm-btn" type="submit" name="action" value="approve">Approve</button>
								<button class="btn-ghost adm-btn" type="submit" name="action" value="reject">Reject</button>
							</form>
						</li>
					))}
				</ul>
			)}

			<div class="adm-photos-head">
				<h2 class="adm-h2" id="photos">Photos to review <span class="adm-count">{submissions.length}</span></h2>
				{session.isAdmin && submissions.length > 0 && (
					<form method="post" action="/api/admin/submissions">
						<button class="btn-main adm-btn" type="submit" name="action" value="approve_all">Approve all</button>
					</form>
				)}
			</div>
			{photoFlag && photoFlagText[photoFlag] && <p class="adm-ok">{photoFlagText[photoFlag]}</p>}
			{submissions.length === 0 ? (
				<p class="adm-empty">Nothing waiting. Photos people send from the gallery show up here.</p>
			) : (
				<ul class="adm-list">
					{submissions.map((s) => (
						<li class="gp-card adm-item adm-item--photo">
							<a class="adm-thumb" href={s.url} target="_blank" rel="noopener">
								<img src={`/_image?href=${encodeURIComponent(s.url)}&w=320&h=320&fit=cover&f=webp&q=70`} alt="" width="160" height="160" loading="lazy" />
							</a>
							<div class="adm-item-main">
								<p class="adm-item-title">
									<span class="gp-pill gp-pill--next">{albumLabel(s.album)}</span>
									<span>{s.profiles?.display_name ?? 'Unnamed'}</span>
									{s.profiles?.player_slug && <a href={`/players/${s.profiles.player_slug}`} target="_blank" rel="noopener">Verified player ↗</a>}
								</p>
								{s.caption && <p class="adm-comment-body">“{s.caption}”</p>}
								<p class="adm-item-meta">{s.profiles?.email ?? ''} · {when(s.created_at)}{s.width && s.height ? ` · ${s.width}×${s.height}` : ''}</p>
							</div>
							<form class="adm-item-actions" method="post" action="/api/admin/submissions">
								<input type="hidden" name="id" value={s.id} />
								<input class="acct-input adm-note" name="note" maxlength="300" placeholder="Note to the uploader (optional)" />
								<button class="btn-main adm-btn" type="submit" name="action" value="approve">Approve</button>
								<button class="btn-ghost adm-btn" type="submit" name="action" value="reject">Reject</button>
							</form>
						</li>
					))}
				</ul>
			)}

			<h2 class="adm-h2" id="comments">Comments to review <span class="adm-count">{held.length}</span></h2>
			{commentFlag && commentFlagText[commentFlag] && <p class="adm-ok">{commentFlagText[commentFlag]}</p>}
			{held.length === 0 ? (
				<p class="adm-empty">Nothing to review. Comments on junior photos and reported comments show up here.</p>
			) : (
				<ul class="adm-list">
					{held.map((c) => (
						<li class="gp-card adm-item">
							<div class="adm-item-main">
								<p class="adm-item-title">
									<span class:list={['gp-pill', c.status === 'pending' ? 'gp-pill--next' : 'gp-pill--champ']}>{c.status === 'pending' ? 'Junior photo' : `Reported${c.reports > 1 ? ` ×${c.reports}` : ''}`}</span>
									<span>{c.profiles?.display_name ?? 'Unnamed'}</span>
									<a href={`/gallery?photo=${c.photo_id}`} target="_blank" rel="noopener">View photo ↗</a>
								</p>
								<p class="adm-comment-body">“{c.body}”</p>
								<p class="adm-item-meta">{c.profiles?.email ?? ''} · {when(c.created_at)}</p>
							</div>
							<form class="adm-item-actions" method="post" action="/api/admin/comments">
								<input type="hidden" name="id" value={c.id} />
								<button class="btn-main adm-btn" type="submit" name="action" value="approve">Approve</button>
								<button class="btn-ghost adm-btn" type="submit" name="action" value="delete">Delete</button>
							</form>
						</li>
					))}
				</ul>
			)}

			{recent.length > 0 && (
				<>
					<h2 class="adm-h2 adm-h2--sub">Recently decided</h2>
					<ul class="adm-recent">
						{recent.map((c) => (
							<li>
								<span class:list={['gp-pill', c.status === 'approved' ? 'gp-pill--done' : 'gp-pill--next']}>{c.status}</span>
								<span>{c.player_name}</span>
								<span class="adm-recent-email">{c.profiles?.email ?? ''}</span>
							</li>
						))}
					</ul>
				</>
			)}

			<div class="adm-links">
				<a class="gp-link" href="/gallery/admin">Gallery uploads →</a>
				<a class="gp-link gp-link--muted" href="/account">Your account →</a>
			</div>
		</div>
	</section>
</GrandPrixLayout>

<style>
	.adm-photos-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 0 0 14px; }
	.adm-photos-head .adm-h2 { margin: 0; }
	.adm-h2 { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 28px; text-transform: uppercase; margin: 0 0 14px; display: flex; align-items: center; gap: 10px; }
	.adm-h2--sub { margin-top: 32px; font-size: 22px; }
	.adm-count { font-size: 14px; background: var(--orange); color: #fff; border-radius: 999px; padding: 2px 10px; }
	.adm-empty, .adm-warn, .adm-ok { font-size: 15px; color: var(--muted); }
	.adm-warn { color: #ffd166; }
	.adm-ok { color: var(--green); }
	.adm-list, .adm-recent { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
	.adm-item { padding: 16px 18px; display: flex; justify-content: space-between; gap: 16px; align-items: center; flex-wrap: wrap; }
	.adm-item-title { margin: 0 0 4px; font-weight: 700; font-size: 17px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
	.adm-item-title a { color: var(--orange2); text-decoration: none; }
	.adm-item-arrow { color: var(--muted); }
	.adm-item-meta { margin: 0; font-size: 13.5px; color: var(--muted); }
	.adm-item-note { margin: 6px 0 0; font-size: 14px; color: rgba(255,255,255,0.8); font-style: italic; }
	.adm-comment-body { margin: 6px 0; font-size: 15px; color: #fff; }
	.adm-item-title a { color: var(--orange2); text-decoration: none; font-size: 13px; }
	.adm-item-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
	.adm-check { font-size: 13px; color: var(--muted); display: inline-flex; gap: 6px; align-items: center; margin-right: 6px; }
	.adm-btn { padding: 10px 16px; font-size: 14px; }
	.adm-recent li { display: flex; gap: 12px; align-items: center; font-size: 14.5px; }
	.adm-recent-email { color: var(--muted); font-size: 13px; }
	.adm-links { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 32px; }
</style>
