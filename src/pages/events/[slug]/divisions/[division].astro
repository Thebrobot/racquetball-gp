---
import GrandPrixLayout from '../../../../layouts/GrandPrixLayout.astro';
import { EVENTS } from '../../../../data/events';
import { getAllPlayers, getPlayerSlug } from '../../../../data/players';
import { titleSponsor } from '../../../../data/ocala-sponsors';

export async function getStaticPaths() {
	return EVENTS.flatMap((event) =>
		(event.divisionDetails ?? []).map((division) => ({
			params: { slug: event.slug, division: division.id },
			props: { event, division },
		})),
	);
}

const { event, division } = Astro.props;
const divisionBase = `/events/${event.slug}/divisions`;
const players = division.roundRobinPlayers ?? [];
const rounds = division.rounds ?? [];
const rrMatches = division.roundRobinMatches ?? [];

const finalMatch = rounds[rounds.length - 1]?.matches?.[0];
const champName = finalMatch?.winner === 1 ? finalMatch.player1
	: finalMatch?.winner === 2 ? finalMatch.player2
	: null;

const isLinkablePlayer = (name: string) => {
	const trimmed = name.trim();
	if (!trimmed) return false;
	const upper = trimmed.toUpperCase();
	return upper !== 'BYE' && upper !== 'TBD' && !trimmed.includes('/');
};

// Resolve "LastA / LastB" or "M. Huyke / O. Huyke" to full names + profile slugs.
const allPlayers = getAllPlayers();
function resolveTeamMembers(teamStr: string): { name: string; slug?: string }[] {
	return teamStr.split(/\s*\/\s*/).map((part) => {
		part = part.trim();
		const partLower = part.toLowerCase();
		const initMatch = part.match(/^([A-Za-z])\.\s+(.+)$/);
		if (initMatch) {
			const [, init, lastName] = initMatch;
			const lnLower = lastName.toLowerCase();
			const found = allPlayers.find(
				(p) =>
					p.name.toLowerCase().endsWith(lnLower) &&
					p.name[0].toLowerCase() === init.toLowerCase(),
			);
			if (found) return { name: found.name, slug: found.slug };
		}
		const found = allPlayers.find(
			(p) => p.name.toLowerCase().endsWith(partLower),
		);
		if (found) return { name: found.name, slug: found.slug };
		return { name: part };
	});
}
/** Full display string for a doubles team (used where a plain string is needed). */
function resolveTeamDisplay(name: string): string {
	if (!name.includes('/')) return name;
	return resolveTeamMembers(name).map((m) => m.name).join(' / ');
}

// ── Round-robin standings (computed from match results) ───────────────────────
type StandingRow = { name: string; w: number; l: number; played: number };
const standingsMap = new Map<string, StandingRow>();
for (const p of players) {
	standingsMap.set(p, { name: p, w: 0, l: 0, played: 0 });
}
for (const m of rrMatches) {
	if (!m.winner) continue;
	const winner = m.winner === 1 ? m.team1 : m.team2;
	const loser  = m.winner === 1 ? m.team2 : m.team1;
	const ws = standingsMap.get(winner);
	const ls = standingsMap.get(loser);
	if (ws) { ws.w++; ws.played++; }
	if (ls) { ls.l++; ls.played++; }
}
const standings = Array.from(standingsMap.values()).sort((a, b) =>
	b.w - a.w || a.l - b.l
);
const allMatchesComplete = rrMatches.length > 0 && rrMatches.every((m) => m.winner);
const poolWinner = allMatchesComplete ? standings[0]?.name : null;
---

<GrandPrixLayout
	title={`${division.label} | ${event.name}`}
	description={`${division.label} division details for ${event.name}.`}
	spotlightLabel="Title sponsor"
	spotlightName={titleSponsor.name}
	spotlightBlurb={titleSponsor.blurb}
	spotlightLogoUrl={titleSponsor.logoUrl}
>
	<section class="event-hero">
		<div class="section-label">{event.name}</div>
		<h1 class="section-title">{division.label}</h1>
		<p class="section-sub">
			{division.format === 'single' ? 'Single elimination bracket' : 'Round robin'}
		</p>
		<div class="event-section-cta">
			<a class="btn-ghost" href={`/events/${event.slug}#brackets`}>Brackets</a>
			<a class="btn-ghost" href={`/events/${event.slug}#participants`}>Participants</a>
		</div>
	</section>

	{division.format === 'single' ? (
		<section class="event-section">
			<div class="bracket-shell">
				<header class="bracket-header">
					<div class="bracket-header-title-row">
						<span class="bracket-brand-badge">Grand Prix</span>
						<h2 class="bracket-heading">{division.label}</h2>
					</div>
					<div class="bracket-header-actions">
						<a class="bracket-cta" href="/leaderboard">View full standings</a>
					</div>
				</header>
				{rounds.length > 1 && (
					<nav class="bracket-tab-nav" aria-label="Bracket rounds">
						{rounds.map((round, idx) => (
							<button
								class:list={['bracket-tab-btn', idx === 0 ? 'active' : '']}
								type="button"
								data-round-idx={idx}
							>
								{round.label}
							</button>
						))}
						{champName && (
							<button class="bracket-tab-btn bracket-tab-btn--champ" type="button" data-round-idx={rounds.length}>
								Champion
							</button>
						)}
					</nav>
				)}
				<div class="bracket-grid bracket-grid--styled">
					{rounds.map((round) => {
						const matches = round.matches ?? [];
						return (
						<div class="bracket-round">
							<div class="bracket-round-title">{round.label}</div>
							<div class="bracket-matches">
								{matches.map((match) => {
									const isBye = match.player1.toUpperCase() === 'BYE' || match.player2.toUpperCase() === 'BYE';
									const advancer = isBye
										? (match.player1.toUpperCase() !== 'BYE' ? match.player1 : match.player2)
										: null;
									const advancerSeed = isBye
										? (match.player1.toUpperCase() !== 'BYE' ? match.seed1 : match.seed2)
										: null;

									if (isBye) {
										return (
											<div class="bracket-match bracket-match--bye">
												<div class="bracket-player bracket-player--bye-advancer">
													{advancerSeed && <span class="bracket-seed" data-seed={advancerSeed}>{advancerSeed}</span>}
													{advancer!.includes('/') ? (
														<span class="bracket-name">
															{resolveTeamMembers(advancer!).map((mem, j, arr) => (
																<>
																	{mem.slug ? <a class="bracket-name-link" href={`/players/${mem.slug}`}>{mem.name}</a> : mem.name}
																	{j < arr.length - 1 && ' / '}
																</>
															))}
														</span>
													) : isLinkablePlayer(advancer!) ? (
														<a class="bracket-name bracket-name-link" href={`/players/${getPlayerSlug(advancer!)}`}>
															{advancer}
														</a>
													) : (
														<span class="bracket-name">{advancer}</span>
													)}
													<span class="bracket-bye-badge">BYE</span>
												</div>
											</div>
										);
									}

									const hasWinner = !!match.winner;
									return (
										<div class:list={['bracket-match', hasWinner && 'bracket-match--complete']}>
											{match.matchId && <div class="bracket-match-id">{match.matchId}</div>}
											<div class:list={['bracket-player', match.winner === 1 ? 'bracket-winner' : '']}>
												{match.seed1 ? <span class="bracket-seed" data-seed={match.seed1}>{match.seed1}</span> : <span class="bracket-seed bracket-seed--empty"></span>}
												{match.player1.includes('/') ? (
													<span class="bracket-name">
														{resolveTeamMembers(match.player1).map((mem, j, arr) => (
															<>
																{mem.slug ? <a class="bracket-name-link" href={`/players/${mem.slug}`}>{mem.name}</a> : mem.name}
																{j < arr.length - 1 && ' / '}
															</>
														))}
													</span>
												) : isLinkablePlayer(match.player1) ? (
													<a class="bracket-name bracket-name-link" href={`/players/${getPlayerSlug(match.player1)}`}>
														{match.player1}
													</a>
												) : (
													<span class:list={['bracket-name', match.player1 === 'TBD' && 'bracket-name--tbd']}>{match.player1}</span>
												)}
											</div>
											<div class="bracket-vs-divider"><span>vs</span></div>
											<div class:list={['bracket-player', match.winner === 2 ? 'bracket-winner' : '']}>
												{match.seed2 ? <span class="bracket-seed" data-seed={match.seed2}>{match.seed2}</span> : <span class="bracket-seed bracket-seed--empty"></span>}
												{match.player2.includes('/') ? (
													<span class="bracket-name">
														{resolveTeamMembers(match.player2).map((mem, j, arr) => (
															<>
																{mem.slug ? <a class="bracket-name-link" href={`/players/${mem.slug}`}>{mem.name}</a> : mem.name}
																{j < arr.length - 1 && ' / '}
															</>
														))}
													</span>
												) : isLinkablePlayer(match.player2) ? (
													<a class="bracket-name bracket-name-link" href={`/players/${getPlayerSlug(match.player2)}`}>
														{match.player2}
													</a>
												) : (
													<span class:list={['bracket-name', match.player2 === 'TBD' && 'bracket-name--tbd']}>{match.player2}</span>
												)}
											</div>
											{match.score && <div class="bracket-match-score">{match.score}</div>}
											{match.scheduledTime && (
												<div class="bracket-match-time">
													<svg class="bracket-time-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
														<circle cx="8" cy="8" r="6.25"/><path d="M8 4.5V8l2.5 1.5"/>
													</svg>
													{match.scheduledTime}{match.court ? ` · ${match.court}` : ''}
												</div>
											)}
										</div>
									);
								})}
							</div>
						</div>
						);
					})}
					{champName && (
						<div class="bracket-champion">
							<div class="bracket-champion-card">
								<svg class="bracket-champion-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
								</svg>
								<div class="bracket-champion-label">Champion</div>
								<div class="bracket-champion-name">{champName ? resolveTeamDisplay(champName) : ''}</div>
							</div>
						</div>
					)}
				</div>
			</div>
		</section>
	) : (
		<section class="event-section rr-section">

			{/* ── Pool winner banner ── */}
			{poolWinner && (
				<div class="rr-champion-banner">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
					</svg>
					<span class="rr-champion-label">Pool Champion</span>
				{poolWinner.includes('/') ? (
					<span class="rr-champion-name">
						{resolveTeamMembers(poolWinner).map((m, j, arr) => (
							<>
								{m.slug ? <a class="rr-champion-name-link" href={`/players/${m.slug}`}>{m.name}</a> : m.name}
								{j < arr.length - 1 && ' / '}
							</>
						))}
					</span>
				) : isLinkablePlayer(poolWinner) ? (
					<a class="rr-champion-name" href={`/players/${getPlayerSlug(poolWinner)}`}>{poolWinner}</a>
				) : (
					<span class="rr-champion-name">{poolWinner}</span>
				)}
				</div>
			)}

			{/* ── Standings ── */}
			{standings.some((s) => s.played > 0) && (
				<div class="rr-standings">
					<div class="rr-standings-head">
						<span class="rr-standings-rank">#</span>
						<span>Player</span>
						<span class="rr-standings-stat">W</span>
						<span class="rr-standings-stat">L</span>
						<span class="rr-standings-stat rr-standings-played">Played</span>
					</div>
					{standings.map((s, i) => (
						<div class:list={['rr-standings-row', i === 0 && allMatchesComplete && 'rr-standings-row--winner']}>
							<span class="rr-standings-rank">{i + 1}</span>
						<span class="rr-standings-name">
							{s.name.includes('/') ? (
								resolveTeamMembers(s.name).map((m, j, arr) => (
									<>
										{m.slug ? <a href={`/players/${m.slug}`}>{m.name}</a> : <span>{m.name}</span>}
										{j < arr.length - 1 && ' / '}
									</>
								))
							) : isLinkablePlayer(s.name) ? (
								<a href={`/players/${getPlayerSlug(s.name)}`}>{s.name}</a>
							) : s.name}
							{i === 0 && allMatchesComplete && (
								<svg class="rr-standings-trophy" viewBox="0 0 16 16" fill="currentColor" aria-label="Champion">
									<path d="M8 1l2.06 4.17 4.6.67-3.33 3.24.79 4.58L8 11.5l-4.12 2.16.79-4.58L1.34 5.84l4.6-.67L8 1z"/>
								</svg>
							)}
						</span>
							<span class="rr-standings-stat rr-standings-w">{s.w}</span>
							<span class="rr-standings-stat rr-standings-l">{s.l}</span>
							<span class="rr-standings-stat rr-standings-played">{s.played}</span>
						</div>
					))}
				</div>
			)}

			{/* ── Match cards ── */}
			<div class="rr-matches">
				<div class="rr-matches-label">Match Results</div>
				{rrMatches.length > 0 ? rrMatches.map((m) => {
					const isComplete = !!m.winner;
					const t1Wins = m.winner === 1;
					const t2Wins = m.winner === 2;
					return (
						<div class:list={['rr-card', isComplete && 'rr-card--complete']}>
							<div class="rr-card-meta">
								<span class="rr-card-round">{m.round}</span>
								<span class="rr-card-time">
									{m.scheduledTime}{m.court ? ` · ${m.court}` : ''}
								</span>
							</div>
							<div class="rr-card-matchup">
							<div class:list={['rr-card-player', t1Wins && 'rr-card-player--winner']}>
								{m.team1.includes('/') ? (
									<span class="rr-card-name">
										{resolveTeamMembers(m.team1).map((mem, j, arr) => (
											<>
												{mem.slug ? <a href={`/players/${mem.slug}`}>{mem.name}</a> : mem.name}
												{j < arr.length - 1 && ' / '}
											</>
										))}
									</span>
								) : isLinkablePlayer(m.team1) ? (
									<a class="rr-card-name" href={`/players/${getPlayerSlug(m.team1)}`}>{m.team1}</a>
								) : (
									<span class="rr-card-name">{m.team1}</span>
								)}
								{t1Wins && (
									<span class="rr-card-w-badge">W</span>
								)}
							</div>
								<div class="rr-card-center">
									{m.score ? (
										<span class="rr-card-score">{m.score}</span>
									) : (
										<span class="rr-card-vs">vs</span>
									)}
								</div>
							<div class:list={['rr-card-player rr-card-player--right', t2Wins && 'rr-card-player--winner']}>
								{t2Wins && (
									<span class="rr-card-w-badge">W</span>
								)}
								{m.team2.includes('/') ? (
									<span class="rr-card-name">
										{resolveTeamMembers(m.team2).map((mem, j, arr) => (
											<>
												{mem.slug ? <a href={`/players/${mem.slug}`}>{mem.name}</a> : mem.name}
												{j < arr.length - 1 && ' / '}
											</>
										))}
									</span>
								) : isLinkablePlayer(m.team2) ? (
									<a class="rr-card-name" href={`/players/${getPlayerSlug(m.team2)}`}>{m.team2}</a>
								) : (
									<span class="rr-card-name">{m.team2}</span>
								)}
							</div>
							</div>
						</div>
					);
				}) : (
					players.length > 0 && (
						<p class="rr-no-schedule">Match schedule not yet published.</p>
					)
				)}
			</div>

			{/* ── Pool roster (always shown) ── */}
			{players.length > 0 && (
				<div class="rr-pool-roster">
					<div class="rr-matches-label">Pool Roster</div>
					<div class="rr-roster-list">
				{players.map((p) => (
						<div class="rr-roster-item">
							{p.includes('/') ? (
								<span class="rr-roster-name">
									{resolveTeamMembers(p).map((m, j, arr) => (
										<>
											{m.slug ? <a href={`/players/${m.slug}`}>{m.name}</a> : m.name}
											{j < arr.length - 1 && ' / '}
										</>
									))}
								</span>
							) : isLinkablePlayer(p) ? (
								<a class="rr-roster-name" href={`/players/${getPlayerSlug(p)}`}>{p}</a>
							) : (
								<span class="rr-roster-name">{p}</span>
							)}
						</div>
					))}
					</div>
				</div>
			)}
		</section>
	)}
</GrandPrixLayout>

<style>
/* ── Round-robin section wrapper ── */
.rr-section {
	max-width: 680px;
	margin-left: auto;
	margin-right: auto;
}

/* ── Pool champion banner ── */
.rr-champion-banner {
	display: flex;
	align-items: center;
	gap: 12px;
	background: linear-gradient(135deg, rgba(240,90,26,0.18) 0%, rgba(240,90,26,0.06) 100%);
	border: 1px solid rgba(240,90,26,0.4);
	border-radius: 14px;
	padding: 16px 20px;
	margin-bottom: 24px;
}
.rr-champion-banner svg {
	width: 28px;
	height: 28px;
	color: var(--orange);
	flex-shrink: 0;
}
.rr-champion-label {
	font-size: 0.7rem;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	color: rgba(255,255,255,0.6);
	display: block;
}
.rr-champion-name {
	font-family: 'Barlow Condensed', sans-serif;
	font-size: 1.4rem;
	font-weight: 800;
	color: #fff;
	text-decoration: none;
	text-transform: uppercase;
	letter-spacing: 0.04em;
	line-height: 1;
	transition: color 0.15s;
}
.rr-champion-name:hover { color: var(--orange); }
.rr-champion-name-link {
	color: #fff;
	text-decoration: none;
	font-family: 'Barlow Condensed', sans-serif;
	font-size: 1.4rem;
	font-weight: 800;
	text-transform: uppercase;
	letter-spacing: 0.04em;
	transition: color 0.15s;
}
.rr-champion-name-link:hover { color: var(--orange); }

/* ── Standings table ── */
.rr-standings {
	border: 1px solid rgba(255,255,255,0.08);
	border-radius: 12px;
	overflow: hidden;
	margin-bottom: 28px;
}
.rr-standings-head {
	display: grid;
	grid-template-columns: 32px 1fr 40px 40px 60px;
	padding: 8px 16px;
	background: rgba(255,255,255,0.04);
	border-bottom: 1px solid rgba(255,255,255,0.07);
	font-size: 0.68rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	color: rgba(255,255,255,0.5);
}
.rr-standings-row {
	display: grid;
	grid-template-columns: 32px 1fr 40px 40px 60px;
	padding: 12px 16px;
	align-items: center;
	border-bottom: 1px solid rgba(255,255,255,0.05);
	transition: background 0.15s;
}
.rr-standings-row:last-child { border-bottom: none; }
.rr-standings-row:hover { background: rgba(255,255,255,0.03); }
.rr-standings-row--winner {
	background: rgba(240,90,26,0.07);
}
.rr-standings-row--winner:hover { background: rgba(240,90,26,0.1); }
.rr-standings-rank {
	font-size: 0.85rem;
	color: rgba(255,255,255,0.4);
	font-weight: 700;
	text-align: center;
}
.rr-standings-name {
	display: flex;
	align-items: center;
	gap: 8px;
	font-weight: 600;
	font-size: 0.95rem;
	color: #fff;
}
.rr-standings-name a {
	color: inherit;
	text-decoration: none;
	transition: color 0.15s;
}
.rr-standings-name a:hover { color: var(--orange); }
.rr-roster-name a {
	color: inherit;
	text-decoration: none;
	transition: color 0.15s;
}
.rr-roster-name a:hover { color: var(--orange); }
.rr-standings-trophy {
	width: 13px;
	height: 13px;
	color: var(--orange);
	flex-shrink: 0;
}
.rr-standings-stat {
	text-align: center;
	font-size: 0.9rem;
	font-weight: 700;
}
.rr-standings-w { color: #6ee7b7; }
.rr-standings-l { color: rgba(255,255,255,0.45); }
.rr-standings-played { color: rgba(255,255,255,0.4); font-weight: 400; }

/* ── Match cards ── */
.rr-matches-label {
	font-size: 0.68rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.12em;
	color: rgba(255,255,255,0.4);
	margin-bottom: 10px;
}
.rr-matches {
	margin-bottom: 28px;
}
.rr-card {
	background: rgba(255,255,255,0.03);
	border: 1px solid rgba(255,255,255,0.08);
	border-radius: 12px;
	padding: 14px 18px;
	margin-bottom: 10px;
	transition: border-color 0.2s;
}
.rr-card--complete {
	border-color: rgba(255,255,255,0.1);
}
.rr-card-meta {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 12px;
}
.rr-card-round {
	font-size: 0.7rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	color: var(--orange);
}
.rr-card-time {
	font-size: 0.75rem;
