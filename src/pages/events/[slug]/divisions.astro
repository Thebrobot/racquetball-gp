---
import GrandPrixLayout from '../../../layouts/GrandPrixLayout.astro';
import OfficialBallChip from '../../../components/grand-prix/OfficialBallChip.astro';
import { getEventStatus } from '../../../data/events';
import { applyLiveCacheHeaders, resolveLiveEvent } from '../../../lib/live/event';

export const prerender = false;

const event = await resolveLiveEvent(Astro.params.slug);
if (!event) return Astro.redirect('/tournaments');
applyLiveCacheHeaders(Astro.response, event);
const eventHref = `/events/${event.slug}`;
const divisions = event.divisionDetails ?? [];
const singleCount = divisions.filter((d) => d.format === 'single').length;
const rrCount = divisions.length - singleCount;

const entrantsByDivision = new Map<string, number>();
for (const profile of event.profiles ?? []) {
	entrantsByDivision.set(profile.division, (entrantsByDivision.get(profile.division) ?? 0) + 1);
}

const eventStatus = getEventStatus(event);
const statusPill =
	eventStatus === 'live'
		? { cls: 'gp-pill--live', label: 'Live now' }
		: eventStatus === 'recent'
			? { cls: 'gp-pill--done', label: 'Completed' }
			: { cls: 'gp-pill--next', label: 'Upcoming' };
---

<GrandPrixLayout
	title={`${event.name} Divisions | Florida Racquetball Grand Prix 2026`}
	description={`Division list for ${event.name}. Choose a bracket to view the draw or round robin.`}
>
	<header class="gp-page-head">
		<div class="gp-page-head-inner gp-page-head-inner--split">
			<div class="divisions-head-copy">
				<p class="section-label divisions-head-label">
					<span class:list={['gp-pill', statusPill.cls]}>{statusPill.label}</span>
					<a class="divisions-head-event" href={eventHref}>{event.name}</a>
				</p>
				<h1 class="gp-title">Every <span>division</span></h1>
				<p class="gp-sub">
					<strong>{event.dateRange}</strong>
					<span aria-hidden="true"> · </span>
					{event.cityLine}. Pick a division to open its single-elimination draw or round-robin grid.
				</p>
				<OfficialBallChip />
			</div>
			<div class="gp-card divisions-head-card">
				<ul class="gp-stat-row">
					<li><strong>{divisions.length}</strong><span>Divisions</span></li>
					{singleCount > 0 && <li><strong>{singleCount}</strong><span>Brackets</span></li>}
					{rrCount > 0 && <li><strong>{rrCount}</strong><span>Round robins</span></li>}
				</ul>
				<div class="divisions-head-links">
					<a class="gp-link" href={`${eventHref}#brackets`}>Event hub →</a>
					<a class="gp-link gp-link--muted" href={`${eventHref}/participants`}>Participants →</a>
				</div>
			</div>
		</div>
	</header>

	<section class="gp-band gp-band--tight" aria-labelledby="division-list-title">
		<div class="gp-band-inner">
			<h2 id="division-list-title" class="visually-hidden">Division list</h2>
			<div class="division-list divisions-grid">
				{divisions.map((division) => {
					const entrants = entrantsByDivision.get(division.label) ?? division.roundRobinPlayers?.length ?? 0;
					return (
						<a class="division-card" href={`${eventHref}/divisions/${division.id}`}>
							<div>
								<div class="division-name">{division.label}</div>
								<div class="division-meta">
									{division.format === 'single' ? 'Single elimination' : 'Round robin'}
									{entrants > 0 && (
										<>
											<span aria-hidden="true"> · </span>
											{entrants}{' '}{entrants === 1 ? 'entrant' : 'entrants'}
										</>
									)}
								</div>
							</div>
							<span class:list={['division-badge', division.format === 'single' ? 'badge-single' : 'badge-rr']}>
								{division.format === 'single' ? 'Bracket' : 'Round robin'}
							</span>
						</a>
					);
				})}
			</div>
		</div>
	</section>
</GrandPrixLayout>

<style>
.divisions-head-label {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 10px 12px;
}
.divisions-head-event {
	color: inherit;
	text-decoration: none;
}
.divisions-head-event:hover {
	color: #fff;
}
.divisions-head-copy .gp-sub strong {
	color: #fff;
	font-weight: 600;
}
.divisions-head-copy :global(.official-ball-chip) {
	margin-left: 0;
	margin-right: 0;
	margin-top: 18px;
}
.divisions-head-card {
	padding: 18px 22px;
}
.divisions-head-links {
	display: flex;
	flex-wrap: wrap;
	gap: 8px 22px;
	margin-top: 16px;
}
.divisions-grid {
	grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
}
@media (max-width: 600px) {
	.divisions-head-card {
		padding: 14px 16px;
	}
}
</style>
