---
import GrandPrixLayout from '../../../layouts/GrandPrixLayout.astro';
import OfficialBallChip from '../../../components/grand-prix/OfficialBallChip.astro';
import { EVENTS, getEventStatus } from '../../../data/events';
import { getPlayerSlug, getPlayerImageForDisplay, getPlayerScheduleEntries } from '../../../data/players';
import { formatPlayerInitials } from '../../../data/leaderboard';

export async function getStaticPaths() {
	return EVENTS.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

const { event: routeEvent } = Astro.props;
const event = EVENTS.find((e) => e.slug === routeEvent.slug) ?? routeEvent;

// Build a map: division label → sorted list of unique participants
const divisionOrder = event.divisions; // preserves intended display order
const byDivision = new Map<string, { name: string; time: string; court: string | null; done: boolean }[]>();

for (const div of divisionOrder) {
	byDivision.set(div, []);
}

// Past events keep their original call times; live/upcoming events advance
// each row to the player's next pending match as results come in.
const eventStatus = getEventStatus(event);
const isPastEvent = eventStatus === 'recent';

for (const profile of event.profiles ?? []) {
	const list = byDivision.get(profile.division);
	if (!list) continue;
	// Pull the live-enriched schedule for this player+division: it advances to
	// the next pending match as results come in, and returns no entries once
	// every match in the division is decided.
	const liveEntries = isPastEvent
		? [profile]
		: getPlayerScheduleEntries(profile.name, [{ ...profile, eventName: event.name }]);
	const next = liveEntries[0];
	const done = liveEntries.length === 0;
	const time = next?.time ?? profile.time;
	const note = next?.note ?? profile.note ?? '';
	// Extract court from note (e.g. "Court 2")
	let court: string | null = null;
	const courtMatch = note.match(/court\s*#?\s*(\w+)/i);
	if (courtMatch) {
		court = courtMatch[1];
	}
	list.push({ name: profile.name, time: done ? 'Complete' : time, court: done ? null : court, done });
}

// Sort each division alphabetically by last name
for (const [, list] of byDivision) {
	list.sort((a, b) => {
		const lastA = a.name.trim().split(' ').pop()!.toLowerCase();
		const lastB = b.name.trim().split(' ').pop()!.toLowerCase();
		return lastA.localeCompare(lastB);
	});
}

// Unique player count
const uniqueNames = new Set((event.profiles ?? []).map((p) => p.name));
const totalParticipants = uniqueNames.size;
const divisionsWithPlayers = divisionOrder.filter((d) => (byDivision.get(d)?.length ?? 0) > 0).length;

const eventHref = `/events/${event.slug}`;
const bracketsHref = `${eventHref}#brackets`;

const statusPill =
	eventStatus === 'live'
		? { cls: 'gp-pill--live', label: 'Live now' }
		: eventStatus === 'recent'
			? { cls: 'gp-pill--done', label: 'Completed' }
			: { cls: 'gp-pill--next', label: 'Upcoming' };
---

<GrandPrixLayout
	title={`${event.name} Participants | Florida Racquetball Grand Prix 2026`}
	description={`Full participant list for the ${event.name}. See who is competing, which divisions they entered, and their next call times.`}
>
	<!-- ── PAGE HEAD ── -->
	<header class="gp-page-head">
		<div class="gp-page-head-inner gp-page-head-inner--split">
			<div class="participants-head-copy">
				<p class="section-label participants-head-label">
					<span class:list={['gp-pill', statusPill.cls]}>{statusPill.label}</span>
					<a class="participants-head-event" href={eventHref}>{event.name}</a>
				</p>
				<h1 class="gp-title">Who is <span>playing</span></h1>
				<p class="gp-sub">
					<strong>{event.dateRange}</strong>
					<span aria-hidden="true"> · </span>
					{event.cityLine}
					{event.spotlightVenue && (
						<>
							<span aria-hidden="true"> · </span>
							{event.spotlightVenue}
						</>
					)}
				</p>
				<OfficialBallChip />
			</div>
			<div class="gp-card participants-head-card">
				<ul class="gp-stat-row">
					<li><strong>{totalParticipants}</strong><span>Players</span></li>
					<li><strong>{divisionsWithPlayers}</strong><span>Divisions</span></li>
				</ul>
				<div class="participants-head-links">
					<a class="gp-link" href={bracketsHref}>Brackets →</a>
					<a class="gp-link gp-link--muted" href={`${eventHref}/divisions`}>Division list →</a>
				</div>
			</div>
		</div>
	</header>

	<!-- ── DIVISION TABLES ── -->
	<section class="gp-band gp-band--tight" aria-label="Participants by division">
		<div class="gp-band-inner">
			{divisionOrder.map((divLabel) => {
				const players = byDivision.get(divLabel) ?? [];
				if (!players.length) return null;
				const headingId = `div-${divLabel.replace(/[^a-z0-9]/gi, '-').toLowerCase()}`;
				return (
					<section class="participants-division-section" aria-labelledby={headingId}>
						<header class="event-section-header participants-division-header">
							<h2 id={headingId}>{divLabel}</h2>
							<p>{players.length} player{players.length !== 1 ? 's' : ''}</p>
						</header>
						<div class="participants-table">
							<div class="participants-table-head">
								<span>Name</span>
								<span>Next call</span>
								<span>Court</span>
							</div>
							{players.map((p) => {
								const imgUrl = getPlayerImageForDisplay(p.name, 40);
								const initials = formatPlayerInitials(p.name);
								return (
									<a class="participants-row" href={`/players/${getPlayerSlug(p.name)}`}>
										<span class="participants-row-identity">
											{imgUrl ? (
												<img
													class="participants-avatar"
													src={imgUrl}
													alt={p.name}
													width="40"
													height="40"
													loading="lazy"
													decoding="async"
												/>
											) : (
												<span class="participants-avatar participants-avatar--fallback" aria-hidden="true">
													{initials}
												</span>
											)}
											<span class="participants-row-name">{p.name}</span>
										</span>
										<span class={`participants-row-time${p.done ? ' participants-row-time--done' : ''}`}>{p.time}</span>
										<span class="participants-row-court">{p.done ? '—' : p.court ? `Court ${p.court}` : 'TBD'}</span>
									</a>
								);
							})}
						</div>
					</section>
				);
			})}
		</div>
	</section>
</GrandPrixLayout>

<style>
/* ── Page head ── */
.participants-head-label {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 10px 12px;
}
.participants-head-event {
	color: inherit;
	text-decoration: none;
}
.participants-head-event:hover {
	color: #fff;
}
.participants-head-copy .gp-sub strong {
	color: #fff;
	font-weight: 600;
}
.participants-head-copy :global(.official-ball-chip) {
	margin-left: 0;
	margin-right: 0;
	margin-top: 18px;
}
.participants-head-card {
	padding: 18px 22px;
}
.participants-head-links {
	display: flex;
	flex-wrap: wrap;
	gap: 8px 22px;
	margin-top: 16px;
}

/* ── Division sections (generic `section` box rules do not apply inside the band) ── */
.participants-division-section {
	max-width: none;
	margin: 0 0 28px;
	padding: 0;
}
.participants-division-section:last-child {
	margin-bottom: 0;
}
.participants-division-header {
	flex-direction: row;
	align-items: baseline;
	gap: 12px;
	margin-bottom: 12px;
}
.participants-division-header h2 {
	font-family: 'Barlow Condensed', sans-serif;
	font-weight: 900;
	text-transform: uppercase;
	letter-spacing: 0.02em;
}
.participants-division-header p {
	font-size: 14px;
	color: rgba(255, 255, 255, 0.55);
}

/* ── Division table ── */
.participants-table {
	border: 1px solid rgba(255,255,255,0.08);
	border-radius: 12px;
	overflow: hidden;
	background: var(--card-bg);
}
.participants-table-head {
	display: grid;
	grid-template-columns: 1fr 180px 90px;
	padding: 10px 20px;
	background: rgba(255,255,255,0.04);
	font-size: 0.7rem;
	text-transform: uppercase;
	letter-spacing: 0.08em;
	color: rgba(255,255,255,0.4);
	font-weight: 600;
	border-bottom: 1px solid rgba(255,255,255,0.07);
}
.participants-row {
	display: grid;
	grid-template-columns: 1fr 180px 90px;
	padding: 10px 20px;
	border-bottom: 1px solid rgba(255,255,255,0.05);
	text-decoration: none;
	color: inherit;
	transition: background 0.15s ease;
	align-items: center;
	gap: 0;
}
.participants-row:last-child {
	border-bottom: none;
}
.participants-row:hover {
	background: rgba(240, 90, 26, 0.07);
}
.participants-row:hover .participants-row-name {
	color: var(--orange);
}
.participants-row-identity {
	display: flex;
	align-items: center;
	gap: 12px;
	min-width: 0;
}
.participants-avatar {
	width: 40px;
	height: 40px;
	border-radius: 50%;
	object-fit: cover;
	flex-shrink: 0;
	border: 1px solid rgba(255,255,255,0.12);
}
.participants-avatar--fallback {
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(240, 90, 26, 0.18);
	color: var(--orange);
	font-size: 0.7rem;
	font-weight: 700;
	letter-spacing: 0.04em;
}
.participants-row-name {
	font-weight: 500;
	font-size: 0.95rem;
	transition: color 0.15s ease;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}
.participants-row-time {
	font-size: 0.85rem;
	color: rgba(255,255,255,0.65);
}
.participants-row-time--done {
	color: rgba(255,255,255,0.35);
	font-style: italic;
}
.participants-row-court {
	font-size: 0.85rem;
	color: rgba(255,255,255,0.5);
}

@media (max-width: 600px) {
	.participants-head-card {
		padding: 14px 16px;
	}
	.participants-table-head {
		grid-template-columns: 1fr 1fr;
	}
	.participants-table-head span:last-child {
		display: none;
	}
	.participants-row {
		grid-template-columns: 1fr 1fr;
	}
	.participants-row-court {
		display: none;
	}
}
</style>
