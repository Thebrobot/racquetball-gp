---
import GrandPrixLayout from '../../layouts/GrandPrixLayout.astro';
import { accountsConfigured, getSession } from '../../lib/accounts/supabase';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

const session = accountsConfigured() ? await getSession(Astro.request, Astro.cookies) : null;
if (!session) return Astro.redirect('/account?next=/account/password', 303);

const error = Astro.url.searchParams.get('error') ?? '';
const errorText: Record<string, string> = {
	short: 'Password must be at least 8 characters.',
	match: 'The two passwords do not match.',
	same: 'Choose a password you have not used here before.',
	failed: 'Could not save the password. Try again.',
};
---

<GrandPrixLayout title="Set your password | Florida Racquetball Grand Prix" description="Choose a password for your account." noindex hideSponsorSpotlight>
	<header class="gp-page-head">
		<div class="gp-page-head-inner">
			<div>
				<p class="section-label">Your account</p>
				<h1 class="gp-title">Set a <span>password</span></h1>
				<p class="gp-sub">Signed in as {session.user.email}. Pick a password of at least 8 characters.</p>
			</div>
		</div>
	</header>

	<section class="gp-band gp-band--tight acct">
		<div class="gp-band-inner gp-band-inner--narrow">
			<div class="gp-card acct-card">
				<form class="acct-form" method="post" action="/api/auth/set-password">
					<label class="acct-label" for="pw-new">New password</label>
					<input class="acct-input" id="pw-new" name="password" type="password" minlength="8" required autocomplete="new-password" />
					<label class="acct-label" for="pw-confirm">Confirm password</label>
					<input class="acct-input" id="pw-confirm" name="confirm" type="password" minlength="8" required autocomplete="new-password" />
					{error && errorText[error] && <p class="acct-p acct-error-text">{errorText[error]}</p>}
					<button class="btn-main acct-btn" type="submit">Save password</button>
				</form>
			</div>
			<p class="acct-p acct-p--muted"><a class="acct-link" href="/account">Back to your account →</a></p>
		</div>
	</section>
</GrandPrixLayout>
