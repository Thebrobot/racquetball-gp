---
import LeaderboardPage from '../../components/grand-prix/LeaderboardPage.astro';
import {
	LB_CATEGORY_HEADING,
	getCategoryForDivision,
	getDivisionDisplayMeta,
} from '../../data/leaderboard';

export const prerender = false;

const { division } = Astro.params;
const category = getCategoryForDivision(division!);
const meta = getDivisionDisplayMeta(division!);
if (!category || !meta) return new Response('Not found', { status: 404 });
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<LeaderboardPage
	initialCategory={category}
	initialDivision={division!}
	pageTitle={`${LB_CATEGORY_HEADING[meta.category]} · ${meta.divisionLabel} | Leaderboard | Florida Racquetball Grand Prix 2026`}
	pageDescription={`${LB_CATEGORY_HEADING[meta.category]} ${meta.divisionLabel} standings for the Florida Racquetball Grand Prix 2026 season.`}
/>
