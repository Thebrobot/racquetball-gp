---
import GrandPrixLayout from '../layouts/GrandPrixLayout.astro';
import TitleSponsorIntro from '../components/grand-prix/TitleSponsorIntro.astro';
import PuppySponsorIntro from '../components/grand-prix/PuppySponsorIntro.astro';
import GuestProSpotlight from '../components/grand-prix/GuestProSpotlight.astro';
import PlayerSpotlight from '../components/grand-prix/PlayerSpotlight.astro';
import SeasonStopsBar from '../components/grand-prix/SeasonStopsBar.astro';
import SeasonStopsBento from '../components/grand-prix/SeasonStopsBento.astro';
import { HOME_SPOTLIGHT_TRACKS, getTopN, leaderboardDivisionHref } from '../data/leaderboard';
import { getFeaturedEvent } from '../data/events';
import { getNextSeasonStop } from '../data/season-stops';
import { dlrSpotlight } from '../data/guest-spotlight/dlr';
import { titleSponsor } from '../data/ocala-sponsors';
import HeroMediaCredit from '../components/grand-prix/HeroMediaCredit.astro';
import { heroVideoCredit } from '../data/hero-video-credit';
import heroVideo from '../partials/grand-prix-hero-video.html?raw';

const spotlightSpots = HOME_SPOTLIGHT_TRACKS.map((t) => ({
	trackLabel: t.label,
	leader: getTopN(t.category, t.division, 1)[0],
	standingsHref: leaderboardDivisionHref(t.division),
}));

const featured = getFeaturedEvent();
const liveEvent = featured?.status === 'live' ? featured.event : null;
const nextStop = getNextSeasonStop();
const eventPage = liveEvent ? `/events/${liveEvent.slug}` : '';
const spotlightImage = liveEvent?.spotlightImage ?? nextStop?.image;
---

<GrandPrixLayout
	title="Florida Racquetball Grand Prix 2026"
	description="The premier racquetball tournament series in Florida. Compete for prizes, points, and the Grand Prix title."
	spotlightLabel="Title sponsor"
	spotlightName={titleSponsor.name}
	spotlightBlurb={titleSponsor.blurb}
	spotlightLogoUrl={titleSponsor.logoUrl}
	imagePreloads={[
		...(spotlightImage ? [spotlightImage] : []),
		'/images/website-logo.webp',
		'/images/series-logo.webp',
		'/images/spotlight/dlr-action.webp',
	]}
>
	<div class="hero-viewport">
		<div class="hero">
			<div set:html={heroVideo} />
			<div
				style="position:absolute;inset:0;z-index:1;background:linear-gradient(180deg, rgba(10,22,40,0.48) 0%, rgba(10,22,40,0.36) 40%, rgba(10,22,40,0.52) 80%, rgba(10,22,40,0.68) 100%);"
				aria-hidden="true"
			>
			</div>
			<div class="hero-grid" style="z-index:2;" aria-hidden="true"></div>
			<HeroMediaCredit credit={heroVideoCredit} />
			<div class="hero-layout" style="z-index:3;">
				<div class="hero-copy">
					<div class="hero-eyebrow">Season 1 · Florida Statewide Series</div>
					<h1 class="hero-title">
						Racquetball
						<span class="line2">Grand Prix</span>
						<span class="line3">Florida · 2026</span>
					</h1>
					<p class="hero-sub">
						Four tour stops across Florida. The first-ever racquetball Grand Prix in the state. Earn
						points at every stop, from Ocala in May through the outdoor event in Eustis in December, and
						chase the statewide leaderboard. A series championship is planned for early 2027 (dates TBD,
						pending USA Racquetball approval).
					</p>
					<div class="hero-ctas">
						<a class="btn-main" href="/leaderboard">View Standings</a>
						<a class="btn-ghost" href="/tournaments">See Schedule</a>
						<a class="btn-guest" href={dlrSpotlight.pageHref}>See special guest</a>
					</div>
				</div>
				<div class="hero-series">
					<img
						class="hero-series-img"
						src="/images/series-logo.webp"
						alt="Florida Racquetball Grand Prix 2026 series emblem"
						width="1080"
						height="1350"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
			</div>
		</div>

		<SeasonStopsBar />
	</div>

	{
		/* TEMPORARY: Rogue Ranch K9 is filling the title-sponsor slot for a few weeks
		   while Rapha International's placement is paused. To revert, swap
		   <PuppySponsorIntro /> back to <TitleSponsorIntro />. */
	}
	<PuppySponsorIntro />

	{(liveEvent || nextStop) && (
		<section
			class:list={['event-spotlight', liveEvent ? 'event-spotlight--live' : 'event-spotlight--upcoming']}
			aria-labelledby="event-spotlight-title"
		>
			<div
				class:list={[
					'event-spotlight-inner',
					spotlightImage && 'event-spotlight-inner--media',
				]}
			>
				{
					spotlightImage && (
						<div
							class="event-spotlight-visual"
							style={{ '--es-img': `url("${spotlightImage}")` }}
							aria-hidden="true"
						>
							<div class="event-spotlight-media" />
						</div>
					)
				}
				<div class="event-spotlight-body">
					{liveEvent ? (
						<>
							<span class="event-spotlight-pill event-spotlight-pill--live">Live now</span>
							<h2 id="event-spotlight-title" class="event-spotlight-title">{liveEvent.name}</h2>
							<p class="event-spotlight-meta">
								<span class="event-spotlight-meta-strong">{liveEvent.dateRange}</span>
								<span class="event-spotlight-meta-sep" aria-hidden="true"> · </span>
								<span>{liveEvent.cityLine}</span>
							</p>
							{liveEvent.spotlightVenue && (
								<p class="event-spotlight-venue">{liveEvent.spotlightVenue}</p>
							)}
							<div class="event-spotlight-ctas">
								<a class="event-spotlight-cta event-spotlight-cta--primary" href={`${eventPage}#brackets`}>
									View brackets
								</a>
								<a class="event-spotlight-cta event-spotlight-cta--participants" href={`${eventPage}#participants`}>
									View participants
								</a>
								{liveEvent.spotlightWatchLiveUrl && (
									<a
										class="event-spotlight-cta event-spotlight-cta--watch"
										href={liveEvent.spotlightWatchLiveUrl}
										target="_blank"
										rel="noopener noreferrer"
									>
										Watch live
									</a>
								)}
							</div>
						</>
					) : (
						nextStop && (
							<>
								<span class="event-spotlight-pill event-spotlight-pill--upcoming">Next stop</span>
								<h2 id="event-spotlight-title" class="event-spotlight-title">{nextStop.eventName}</h2>
								<p class="event-spotlight-meta">
									<span class="event-spotlight-meta-strong">{nextStop.dateHint}, 2026</span>
									<span class="event-spotlight-meta-sep" aria-hidden="true"> · </span>
									<span>{nextStop.cityLine}</span>
								</p>
								<p class="event-spotlight-venue">{nextStop.venue}</p>
								{nextStop.teaser && <p class="event-spotlight-teaser">{nextStop.teaser}</p>}
								{nextStop.id === 'stop-2' && (
									<p class="event-spotlight-teaser">
										Featuring pro guest{' '}
										<a class="event-spotlight-guest-link" href={dlrSpotlight.pageHref}>
											{dlrSpotlight.name} ({dlrSpotlight.nickname}) →
										</a>
									</p>
								)}
								<div class="event-spotlight-ctas">
									<a
										class="event-spotlight-cta event-spotlight-cta--primary"
										href={nextStop.registerUrl}
										target="_blank"
										rel="noopener noreferrer"
									>
										Register on R2
									</a>
									<a class="event-spotlight-cta event-spotlight-cta--schedule" href="/tournaments">
										See schedule
									</a>
								</div>
							</>
						)
					)}
				</div>
			</div>
		</section>
	)}

	<GuestProSpotlight />

	<div class="home-bento-shell">
		<div class="home-bento-shell-inner">
			<SeasonStopsBento />
		</div>
	</div>

	<PlayerSpotlight spots={spotlightSpots} />

	<section class="site-explore">
		<div class="section-label">Explore</div>
		<div class="section-title">The <span style="color:var(--orange)">Grand Prix</span></div>
		<p class="section-sub">
			Everything you need (schedule, points rules, live standings, and partners) lives on its own page.
		</p>
		<div class="site-explore-grid">
			<a class="site-explore-card" href="/tournaments">
				<span class="site-explore-card-kicker">Schedule</span>
				<span class="site-explore-card-title">Tournaments</span>
				<span class="site-explore-card-desc">All stops in tiles: dates, venues, and registration.</span>
			</a>
			<a class="site-explore-card" href="/points">
				<span class="site-explore-card-kicker">Rules</span>
				<span class="site-explore-card-title">How points work</span>
				<span class="site-explore-card-desc">Singles, doubles, and partnership bonuses explained.</span>
			</a>
			<a class="site-explore-card" href="/leaderboard">
				<span class="site-explore-card-kicker">Live</span>
				<span class="site-explore-card-title">Leaderboard</span>
				<span class="site-explore-card-desc">Season standings updated after every stop.</span>
			</a>
			<a class="site-explore-card" href="/sponsors">
				<span class="site-explore-card-kicker">Partners</span>
				<span class="site-explore-card-title">Sponsors</span>
				<span class="site-explore-card-desc">Brands backing Florida racquetball.</span>
			</a>
		</div>
	</section>
</GrandPrixLayout>
