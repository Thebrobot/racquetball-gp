---
import GrandPrixLayout from '../layouts/GrandPrixLayout.astro';
import { accountsConfigured, getSession } from '../lib/accounts/supabase';
import { claimPlayerOptions } from '../lib/accounts/player-search';
import { loadClaimedSlugs } from '../lib/accounts/player-link';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

const configured = accountsConfigured();
const session = configured ? await getSession(Astro.request, Astro.cookies) : null;
if (session) return Astro.redirect('/account', 303);

let next = Astro.url.searchParams.get('next') ?? '/account';
if (!next.startsWith('/') || next.startsWith('//')) next = '/account';
const sent = Astro.url.searchParams.get('sent') === '1';
const sentPlayer = (Astro.url.searchParams.get('player') ?? '').trim();
const claimed = await loadClaimedSlugs();
const players = claimPlayerOptions(claimed);
---

<GrandPrixLayout title="Create an account | Florida Racquetball Grand Prix" description="Create a free account to like photos, follow players and claim your player profile." noindex hideSponsorSpotlight>
	<header class="gp-page-head">
		<div class="gp-page-head-inner">
			<div>
				<p class="section-label">Players and fans</p>
				<h1 class="gp-title">Create an <span>account</span></h1>
				<p class="gp-sub">Free, takes a minute. If you play in the Grand Prix, we will link this account to your player profile.</p>
			</div>
		</div>
	</header>

	<section class="gp-band gp-band--tight acct">
		<div class="gp-band-inner gp-band-inner--narrow">
			{!configured && (
				<div class="gp-card acct-card"><p class="acct-msg acct-msg--warn">Accounts are not set up on this deployment yet.</p></div>
			)}

			{configured && sent && (
				<div class="gp-card acct-card">
					<h2 class="acct-h2">Check your email</h2>
					<p class="acct-p">We sent a verification link. Tap it to activate your account; it works once and expires in an hour.</p>
					{sentPlayer ? (
						<p class="acct-p acct-ok">After you confirm, your account will be linked to <strong>{sentPlayer}</strong>.</p>
					) : (
						<p class="acct-p acct-p--muted">You signed up as a spectator. You can claim a player profile later from your account page.</p>
					)}
					<p class="acct-p acct-p--muted">Nothing there? Check spam. Already verified? <a class="acct-link" href="/account">Sign in</a>.</p>
				</div>
			)}

			{configured && !sent && (
				<div class="gp-card acct-card">
					<form class="acct-form" id="signup-form" novalidate>
						<input type="hidden" name="next" value={next} />
						<label class="acct-label" for="su-name">Your name</label>
						<input class="acct-input" id="su-name" name="display_name" type="text" minlength="2" maxlength="60" required autocomplete="name" placeholder="How it should appear on the site" />

						<label class="acct-label" for="su-email">Email</label>
						<input class="acct-input" id="su-email" name="email" type="email" inputmode="email" required autocomplete="email" placeholder="you@example.com" />

						<label class="acct-label" for="su-password">Password</label>
						<input class="acct-input" id="su-password" name="password" type="password" minlength="8" required autocomplete="new-password" />
						<p class="acct-hint">At least 8 characters.</p>

						<div class="su-claim" id="su-claim">
							<p class="acct-label" id="su-player-label">Your player profile</p>
							<p class="acct-hint">We look up existing Grand Prix profiles from the name you typed. Confirm it is you, or skip if you are here as family or a fan.</p>
							<label class="acct-label" for="su-player-search">Find your name</label>
							<div class="su-claim-combo">
								<input
									class="acct-input"
									id="su-player-search"
									type="text"
									role="combobox"
									placeholder="Start typing your name…"
									autocomplete="off"
									autocapitalize="words"
									spellcheck="false"
									inputmode="search"
									aria-autocomplete="list"
									aria-expanded="false"
									aria-controls="su-player-listbox"
									aria-labelledby="su-player-label"
								/>
								<ul class="su-claim-list" id="su-player-listbox" role="listbox" hidden></ul>
								<p class="acct-p acct-p--muted su-claim-empty" id="su-player-empty" hidden>No matching player profile.</p>
							</div>
							<div class="su-pick" id="su-pick" hidden>
								<p class="su-pick-name" id="su-pick-name"></p>
								<p class="su-pick-meta" id="su-pick-meta"></p>
								<p class="acct-p acct-error-text" id="su-pick-taken" hidden>This profile is already claimed by another account.</p>
								<div class="su-pick-actions">
									<button class="btn-main acct-btn" type="button" id="su-this-is-me">This is me</button>
									<button class="btn-ghost acct-btn" type="button" id="su-not-me">Not this person</button>
								</div>
							</div>
							<p class="acct-p acct-ok" id="su-confirmed" hidden></p>
							<button class="acct-textbtn" type="button" id="su-skip">I'm not a player (spectator / family)</button>
							<p class="acct-p acct-p--muted" id="su-skip-note" hidden>You can claim a player profile later from your account page.</p>
							<input type="hidden" name="player_slug" id="su-player-slug" value="" />
						</div>

						<label class="acct-check">
							<input type="checkbox" name="marketing_opt_in" value="1" />
							<span>Email me Grand Prix news, results and upcoming stops. Optional, unsubscribe any time.</span>
						</label>
						<p class="acct-hint">By creating an account you agree to how we handle your details in our <a class="acct-link" href="/privacy">privacy notice</a>.</p>
						<button class="btn-main acct-btn acct-btn--full" type="submit" id="su-submit">Create account</button>
						<p class="acct-p acct-p--muted acct-error" id="su-error" hidden></p>
					</form>
					<div class="acct-divider">Already have an account</div>
					<p class="acct-p acct-p--muted" style="margin:0;"><a class="acct-link" href={`/account?next=${encodeURIComponent(next)}`}>Sign in →</a></p>
				</div>
			)}
		</div>
	</section>
</GrandPrixLayout>

<script is:inline type="application/json" id="su-players" set:html={JSON.stringify(players).replace(/</g, '\\u003c')}></script>
<script>
	import { matchClaimPlayers, playerIdentifyLine, type ClaimPlayerOption } from '../lib/accounts/player-search';

	const form = document.getElementById('signup-form') as HTMLFormElement | null;
	const nameEl = document.getElementById('su-name') as HTMLInputElement | null;
	const search = document.getElementById('su-player-search') as HTMLInputElement | null;
	const slugEl = document.getElementById('su-player-slug') as HTMLInputElement | null;
	const listbox = document.getElementById('su-player-listbox');
	const emptyEl = document.getElementById('su-player-empty');
	const pickEl = document.getElementById('su-pick');
	const pickName = document.getElementById('su-pick-name');
	const pickMeta = document.getElementById('su-pick-meta');
	const pickTaken = document.getElementById('su-pick-taken');
	const thisIsMe = document.getElementById('su-this-is-me') as HTMLButtonElement | null;
	const notMe = document.getElementById('su-not-me');
	const confirmed = document.getElementById('su-confirmed');
	const skipBtn = document.getElementById('su-skip');
	const skipNote = document.getElementById('su-skip-note');
	const players: ClaimPlayerOption[] = (() => {
		try {
			return JSON.parse(document.getElementById('su-players')?.textContent ?? '[]') as ClaimPlayerOption[];
		} catch {
			return [];
		}
	})();

	let matches: ClaimPlayerOption[] = [];
	let active = -1;
	let open = false;
	let preview: ClaimPlayerOption | null = null;

	function setOpen(next: boolean) {
		if (!search || !listbox) return;
		open = next;
		listbox.hidden = !next;
		search.setAttribute('aria-expanded', next ? 'true' : 'false');
		if (!next) {
			search.removeAttribute('aria-activedescendant');
			active = -1;
		}
	}

	function paintList() {
		if (!listbox) return;
		listbox.innerHTML = matches
			.map((p, i) => {
				const meta = playerIdentifyLine(p);
				const taken = p.claimed ? ' · already claimed' : '';
				return `<li role="none"><button type="button" class="su-claim-opt${p.claimed ? ' is-claimed' : ''}" role="option" id="su-opt-${i}" data-slug="${p.slug}" aria-selected="${i === active ? 'true' : 'false'}">${p.name.replace(/</g, '&lt;')}${meta ? `<span class="su-opt-meta">${meta.replace(/</g, '&lt;')}${taken}</span>` : taken ? `<span class="su-opt-meta">Already claimed</span>` : ''}</button></li>`;
			})
			.join('');
	}

	function setActive(index: number) {
		if (!search || !listbox) return;
		active = matches.length ? ((index % matches.length) + matches.length) % matches.length : -1;
		[...listbox.querySelectorAll<HTMLElement>('.su-claim-opt')].forEach((el, i) => {
			el.setAttribute('aria-selected', i === active ? 'true' : 'false');
			if (i === active) {
				search.setAttribute('aria-activedescendant', el.id);
				el.scrollIntoView({ block: 'nearest' });
			}
		});
	}

	function syncList(query: string) {
		if (!emptyEl) return;
		const typed = query.trim();
		if (!typed || slugEl?.value) {
			matches = [];
			emptyEl.hidden = true;
			setOpen(false);
			paintList();
			return;
		}
		matches = matchClaimPlayers(players, query);
		emptyEl.hidden = matches.length > 0;
		if (!matches.length) {
			setOpen(false);
			paintList();
			return;
		}
		active = 0;
		setOpen(true);
		paintList();
		setActive(0);
	}

	function showPreview(player: ClaimPlayerOption) {
		preview = player;
		setOpen(false);
		if (search) search.value = player.name;
		if (pickName) pickName.textContent = player.name;
		if (pickMeta) pickMeta.textContent = playerIdentifyLine(player) || 'Grand Prix player';
		if (pickTaken) pickTaken.hidden = !player.claimed;
		if (thisIsMe) thisIsMe.disabled = player.claimed;
		if (pickEl) pickEl.hidden = false;
		if (confirmed) confirmed.hidden = true;
		if (skipNote) skipNote.hidden = true;
	}

	function clearPick() {
		preview = null;
		if (slugEl) slugEl.value = '';
		if (pickEl) pickEl.hidden = true;
		if (confirmed) confirmed.hidden = true;
		if (thisIsMe) thisIsMe.disabled = false;
	}

	function confirmPlayer(player: ClaimPlayerOption) {
		if (player.claimed) {
			showPreview(player);
			return;
		}
		if (slugEl) slugEl.value = player.slug;
		if (search) search.value = player.name;
		if (confirmed) {
			confirmed.textContent = `This is you: ${player.name}. Your account will be linked to that profile.`;
			confirmed.hidden = false;
		}
		if (pickEl) pickEl.hidden = true;
		if (skipNote) skipNote.hidden = true;
		if (emptyEl) emptyEl.hidden = true;
		setOpen(false);
	}

	function skipPlayer() {
		clearPick();
		if (search) search.value = '';
		if (emptyEl) emptyEl.hidden = true;
		if (skipNote) skipNote.hidden = false;
		setOpen(false);
	}

	search?.addEventListener('input', () => {
		clearPick();
		if (skipNote) skipNote.hidden = true;
		syncList(search.value);
		if (search.value.trim()) search.scrollIntoView({ block: 'center', behavior: 'smooth' });
	});
	nameEl?.addEventListener('input', () => {
		if (slugEl?.value || (search?.value.trim() && search.value.trim() !== nameEl.value.trim())) return;
		if (search && !search.value.trim()) syncList(nameEl.value);
	});
	nameEl?.addEventListener('blur', () => {
		if (slugEl?.value || !search) return;
		if (!search.value.trim() && nameEl.value.trim().length >= 3) {
			search.value = nameEl.value;
			syncList(nameEl.value);
		}
	});
	search?.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowDown') {
			e.preventDefault();
			if (!open && search.value.trim()) syncList(search.value);
			else if (open) setActive(active + 1);
		} else if (e.key === 'ArrowUp') {
			e.preventDefault();
			if (open) setActive(active - 1);
		} else if (e.key === 'Enter' && open) {
			e.preventDefault();
			const hit = matches[active];
			if (hit) showPreview(hit);
		} else if (e.key === 'Escape' && open) {
			e.preventDefault();
			setOpen(false);
		}
	});
	listbox?.addEventListener('mousedown', (e) => e.preventDefault());
	listbox?.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.su-claim-opt');
		if (!btn?.dataset.slug) return;
		const hit = matches.find((p) => p.slug === btn.dataset.slug);
		if (hit) showPreview(hit);
	});
	thisIsMe?.addEventListener('click', () => {
		if (preview) confirmPlayer(preview);
	});
	notMe?.addEventListener('click', () => {
		clearPick();
		search?.focus();
		syncList(search?.value ?? '');
	});
	skipBtn?.addEventListener('click', skipPlayer);

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const errEl = document.getElementById('su-error')!;
		const btn = document.getElementById('su-submit') as HTMLButtonElement;
		errEl.hidden = true;
		if (!form.reportValidity()) return;
		const skipped = Boolean(skipNote && !skipNote.hidden);
		if (search?.value.trim() && !slugEl?.value && !skipped) {
			errEl.textContent = 'Confirm “This is me”, or choose “I’m not a player” if you are a spectator.';
			errEl.hidden = false;
			return;
		}
		btn.disabled = true;
		const fd = new FormData(form);
		const res = await fetch('/api/auth/signup', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({
				display_name: fd.get('display_name'),
				marketing_opt_in: fd.get('marketing_opt_in') === '1',
				email: fd.get('email'),
				password: fd.get('password'),
				player_slug: fd.get('player_slug'),
				next: fd.get('next'),
			}),
		});
		const data = (await res.json().catch(() => ({}))) as {
			ok?: boolean;
			needsVerification?: boolean;
			next?: string;
			error?: string;
			playerName?: string | null;
		};
		if (res.ok && data.ok) {
			if (data.needsVerification) {
				const q = new URLSearchParams({ sent: '1' });
				if (data.playerName) q.set('player', data.playerName);
				window.location.href = `/signup?${q.toString()}`;
				return;
			}
			window.location.href = data.next ?? '/account';
			return;
		}
		errEl.textContent = data.error ?? 'Something went wrong.';
		errEl.hidden = false;
		btn.disabled = false;
	});
</script>
