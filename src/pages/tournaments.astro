---
import GrandPrixLayout from '../layouts/GrandPrixLayout.astro';
import TournamentStopCards from '../components/grand-prix/TournamentStopCards.astro';
import { titleSponsor } from '../data/ocala-sponsors';
---

<GrandPrixLayout
	title="Tournaments | Florida Racquetball Grand Prix 2026"
	description="2026 Grand Prix stops across Florida: dates, R2 registration, and season points at every stop."
	spotlightLabel="Title sponsor"
	spotlightName={titleSponsor.name}
	spotlightBlurb={titleSponsor.blurb}
	spotlightLogoUrl={titleSponsor.logoUrl}
>
	<div class="page-hero">
		<div class="section-label">2026 Schedule</div>
		<h1 class="section-title">Tournament <span style="color:var(--orange)">Stops</span></h1>
		<p class="section-sub" style="margin-bottom:0;">
			Four Grand Prix tour stops across Florida from May through December—full brackets in every skill
			division—with Grand Prix points on the line at each host venue.
		</p>
	</div>

	<div class="tournaments-page-wrap">
		<TournamentStopCards />
	</div>
</GrandPrixLayout>
