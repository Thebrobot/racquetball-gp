---
import GrandPrixLayout from '../../layouts/GrandPrixLayout.astro';
import GalleryFeed from '../../components/grand-prix/GalleryFeed.astro';
import { GALLERY_ALBUMS, albumById, albumBySlug } from '../../lib/gallery/albums';
import { readGalleryIndex } from '../../lib/gallery/store';
import type { GalleryClientConfig } from '../../lib/gallery/types';
import { GRAND_PRIX_FACEBOOK_URL } from '../../data/social';

import { getGallerySocial } from '../../lib/accounts/photo-stats';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');

const index = await readGalleryIndex();
const siteOrigin = Astro.site?.origin ?? 'https://www.racquetballgp.com';
const eventParam = Astro.url.searchParams.get('event') ?? '';
const initialEvent = albumBySlug(eventParam) ?? albumById(eventParam);
const openId = Astro.url.searchParams.get('photo') ?? undefined;
const eventCount = GALLERY_ALBUMS.length;
const photoCount = index.photos.length;

const social = await getGallerySocial(Astro.request, Astro.cookies);
const clientConfig: GalleryClientConfig = {
	...social,
	photos: index.photos,
	albums: GALLERY_ALBUMS,
	initialAlbum: initialEvent?.id ?? 'all',
	initialOpenId: openId,
	siteOrigin,
	mode: 'browse',
};
---

<GrandPrixLayout
	title="Gallery | Racquetball Grand Prix 2026"
	description="Photos from the Florida Racquetball Grand Prix tour stops across the state."
	ogImage="/images/og-default.webp"
	hideSponsorSpotlight
>
	<section class="gallery-page" aria-labelledby="gallery-heading">
		<div class="gallery-page-inner">
			<header class="gallery-profile">
				<div class="gallery-avatar-ring">
					<img class="gallery-avatar" src="/images/series-logo.webp" alt="" width="132" height="132" />
				</div>
				<div class="gallery-name-row">
					<h1 id="gallery-heading" class="gallery-name">Racquetball Grand Prix</h1>
					<div class="gallery-name-actions">
						<button type="button" class="gallery-share-btn gallery-add-btn" id="gallery-add-btn">+ Add photos</button>
						<button type="button" class="gallery-share-btn" id="gallery-share-profile">Share</button>
						<a
							class="gallery-social"
							href={GRAND_PRIX_FACEBOOK_URL}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Racquetball Grand Prix on Facebook"
						>
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
								<path
									fill="currentColor"
									d="M14.2 8.5V6.9c0-.8.4-1.2 1.3-1.2H17V3.2h-2.2C12.1 3.2 11 4.5 11 6.7v1.8H9v2.6h2V20h3.2v-8.9h2.2l.3-2.6h-2.5z"
								></path>
							</svg>
						</a>
					</div>
				</div>
				<p class="gallery-handle">Season 1 · 2026</p>
				<p class="gallery-stats">
					<span>
						<strong id="gallery-stat-events">{eventCount.toLocaleString('en-US')}</strong>
						<span class="gallery-stat-label">Events</span>
					</span>
					<span>
						<strong id="gallery-stat-photos">{photoCount.toLocaleString('en-US')}</strong>
						<span class="gallery-stat-label">Photos</span>
					</span>
				</p>
				<p class="gallery-bio">
					🏆 Florida's 1st Racquetball Grand Prix<br />
					📍 4 stops. 1 leaderboard. Racquetball Grand Prix.<br />
					🔥 Ocala → Sarasota → PSL → Eustis → More to come...<br />
					👇 See all the fun!
				</p>
			</header>

			<div class="gallery-tabs-wrap">
				<div class="gallery-tabs" id="gallery-tabs" role="tablist" aria-label="Events"></div>
			</div>

			<div class="gallery-toolbar" id="gallery-toolbar">
				<div class="gallery-filter-group">
					<span class="gallery-toolbar-label">Filters</span>
					<label class="gallery-select-label">
						<span class="gallery-visually-hidden">Year</span>
						<select id="gallery-filter-year">
							<option value="">All years</option>
						</select>
					</label>
					<label class="gallery-select-label" id="gallery-filter-division-label" hidden>
						<span class="gallery-visually-hidden">Division</span>
						<select id="gallery-filter-division">
							<option value="">All divisions</option>
						</select>
					</label>
					<label class="gallery-select-label" id="gallery-filter-photographer-label" hidden>
						<span class="gallery-visually-hidden">Photographer</span>
						<select id="gallery-filter-photographer">
							<option value="">All photographers</option>
						</select>
					</label>
				</div>
				<label class="gallery-select-label">
					<span class="gallery-toolbar-label">Sort by</span>
					<select id="gallery-sort">
						<option value="newest">Newest</option>
						<option value="oldest">Oldest</option>
						<option value="liked">Most liked</option>
					</select>
				</label>
				<button type="button" class="gallery-select-toggle" id="gallery-select-toggle" aria-pressed="false">
					Select
				</button>
			</div>

			<div class="gallery-select-bar" id="gallery-select-bar" hidden>
				<span id="gallery-select-count">0 selected</span>
				<button type="button" class="gallery-share-selected" id="gallery-share-selected" disabled>
					Share selected
				</button>
				<button type="button" class="gallery-cancel-select" id="gallery-cancel-select">Cancel</button>
			</div>

			<p class="gallery-empty" id="gallery-empty" hidden></p>
			<div class="gallery-covers" id="gallery-covers"></div>
			<div class="gallery-grid" id="gallery-grid" hidden></div>
			<div class="gallery-more-wrap" id="gallery-more-wrap" hidden>
				<button type="button" class="gallery-load-more" id="gallery-load-more">Load more</button>
			</div>
		</div>
	</section>

	<div class="gsub" id="gallery-submit" role="dialog" aria-modal="true" aria-labelledby="gsub-title" hidden>
		<div class="gsub-backdrop" data-gsub-close></div>
		<form class="gsub-card" id="gsub-form">
			<button type="button" class="gwel-close" aria-label="Close" data-gsub-close>×</button>
			<p class="gwel-kicker">From your phone or camera</p>
			<h2 class="gsub-title" id="gsub-title">Add your photos</h2>
			<p class="gsub-text">Kyle reviews every photo before it appears in the gallery. Approved photos also land on your player profile if you are verified.</p>
			<label class="acct-label" for="gsub-album">Which event</label>
			<select class="acct-input" id="gsub-album" name="album" required>
				{GALLERY_ALBUMS.map((a) => <option value={a.id} selected={a.id === (initialEvent?.id ?? '')}>{a.label}</option>)}
			</select>
			<label class="acct-label" for="gsub-caption">Caption (optional)</label>
			<input class="acct-input" id="gsub-caption" name="caption" maxlength="200" placeholder="Who, what, which court…" autocomplete="off" />
			<label class="gsub-drop" for="gsub-files">
				<input type="file" id="gsub-files" name="files" accept="image/*" multiple />
				<span class="gsub-drop-text"><strong>Choose photos</strong><span>JPG, PNG or HEIC, up to 12MB each</span></span>
			</label>
			<ul class="gsub-list" id="gsub-list"></ul>
			<p class="acct-p acct-p--muted acct-error" id="gsub-error" hidden></p>
			<div class="gwel-actions">
				<button class="gwel-btn gwel-btn--primary" type="submit" id="gsub-send">Send for review</button>
				<button class="gwel-btn" type="button" data-gsub-close>Done</button>
			</div>
		</form>
	</div>
	<GalleryFeed />
	<div
		class="gallery-lightbox glb"
		id="gallery-lightbox"
		hidden
		aria-hidden="true"
		role="dialog"
		aria-modal="true"
		aria-label="Expanded photo"
	>
		<button type="button" class="glb-close" id="gallery-lb-close" aria-label="Close">×</button>
		<div class="glb-post">
			<div class="glb-media" id="gallery-lb-media">
				<button type="button" class="glb-nav glb-prev" id="gallery-lb-prev" aria-label="Previous photo">‹</button>
				<span class="glb-frame">
					<img id="gallery-lb-img" class="glb-photo" src="" alt="" />
					<img class="gallery-watermark gallery-watermark--gp" src="/images/website-logo.webp" alt="" />
					<img class="gallery-watermark gallery-watermark--credit" src="/images/daniel-bray-photography.png" alt="" />
				</span>
				<button type="button" class="glb-nav glb-next" id="gallery-lb-next" aria-label="Next photo">›</button>
			</div>
			<aside class="glb-side">
				<header class="glb-head">
					<img class="glb-brand" src="/images/series-logo.webp" alt="" width="40" height="50" />
					<div class="glb-head-text">
						<span class="glb-album" id="gallery-lb-album">Racquetball Grand Prix</span>
						<span class="glb-date" id="gallery-lb-date"></span>
					</div>
					<div class="glb-admin" id="gallery-lb-admin" hidden></div>
				</header>
				<div class="glb-people" id="gallery-lb-people" hidden></div>
				<div class="glb-body" id="gallery-lb-body">
					<p class="glb-caption" id="gallery-lb-caption"></p>
					<div class="glb-comments" id="gallery-lb-comments"></div>
				</div>
				<div class="glb-actions">
					<div class="glb-action-row">
						<button type="button" class="glb-act glb-act--like" id="gallery-lb-like" aria-pressed="false">Like</button>
						<button type="button" class="glb-act" id="gallery-lb-comment-btn">Comment</button>
						<button type="button" class="glb-act" id="gallery-lb-share">Share</button>
						<button type="button" class="glb-act" id="gallery-lb-download">Download</button>
					</div>
					<div class="glb-likers" id="gallery-lb-likers"></div>
					<span class="glb-views" id="gallery-lb-views" aria-live="polite"></span>
				</div>
				<form class="glb-compose" id="gallery-lb-compose">
					<input class="glb-input" id="gallery-lb-input" name="body" maxlength="500" placeholder="Add a comment…" autocomplete="off" />
					<button class="glb-post-btn" type="submit">Post</button>
					<p class="glb-compose-note" id="gallery-lb-compose-note" hidden></p>
				</form>
			</aside>
		</div>
	</div>

	<div class="gallery-share-menu" id="gallery-share-menu" hidden role="dialog" aria-label="Share options">
		<button type="button" data-share="facebook">Facebook</button>
		<button type="button" data-share="x">X</button>
		<button type="button" data-share="copy">Copy link</button>
		<button type="button" data-share="close">Close</button>
	</div>

	<script is:inline define:vars={{ clientConfig }}>
		window.__GP_GALLERY__ = clientConfig;
	</script>
	<script src="../../scripts/gallery-client.ts"></script>
</GrandPrixLayout>

<script>
	const sheet = document.getElementById('gallery-submit');
	const openBtn = document.getElementById('gallery-add-btn');
	const form = document.getElementById('gsub-form') as HTMLFormElement | null;
	const files = document.getElementById('gsub-files') as HTMLInputElement | null;
	const list = document.getElementById('gsub-list');
	const err = document.getElementById('gsub-error');
	const send = document.getElementById('gsub-send') as HTMLButtonElement | null;
	if (sheet && openBtn && form && files && list && err && send) {
		const signedIn = () => Boolean((window as Window & { __GP_GALLERY__?: { viewer?: { signedIn?: boolean } } }).__GP_GALLERY__?.viewer?.signedIn);
		const open = () => {
			if (!signedIn()) {
				window.location.href = `/account?next=${encodeURIComponent(window.location.pathname + window.location.search)}`;
				return;
			}
			sheet.hidden = false;
			document.documentElement.classList.add('gwel-open');
			requestAnimationFrame(() => sheet.classList.add('is-in'));
		};
		const close = () => {
			sheet.classList.remove('is-in');
			document.documentElement.classList.remove('gwel-open');
			setTimeout(() => (sheet.hidden = true), 250);
		};
		openBtn.addEventListener('click', open);
		if (location.hash === '#add') setTimeout(open, 300);
		sheet.querySelectorAll('[data-gsub-close]').forEach((el) => el.addEventListener('click', close));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !sheet.hidden) close();
		});
		const row = (name: string) => {
			const li = document.createElement('li');
			li.className = 'gsub-file';
			li.innerHTML = `<span class="gsub-file-name"></span><span class="gsub-file-state">Waiting</span>`;
			li.querySelector('.gsub-file-name')!.textContent = name;
			list.append(li);
			return li.querySelector<HTMLElement>('.gsub-file-state')!;
		};
		files.addEventListener('change', () => {
			list.innerHTML = '';
			err.hidden = true;
			for (const f of Array.from(files.files ?? [])) row(f.name);
		});
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			err.hidden = true;
			const chosen = Array.from(files.files ?? []);
			if (!chosen.length) {
				err.textContent = 'Choose at least one photo.';
				err.hidden = false;
				return;
			}
			send.disabled = true;
			list.innerHTML = '';
			const states = chosen.map((f) => row(f.name));
			let sent = 0;
			for (let i = 0; i < chosen.length; i++) {
				states[i].textContent = 'Uploading…';
				const fd = new FormData();
				fd.set('album', (document.getElementById('gsub-album') as HTMLSelectElement).value);
				fd.set('caption', (document.getElementById('gsub-caption') as HTMLInputElement).value);
				fd.set('file', chosen[i]);
				try {
					const res = await fetch('/api/photos/submit', { method: 'POST', body: fd });
					const data = (await res.json().catch(() => ({}))) as { error?: string };
					if (res.ok) {
						states[i].textContent = 'Sent for review';
						states[i].classList.add('is-ok');
						sent += 1;
					} else {
						states[i].textContent = data.error ?? 'Failed';
						states[i].classList.add('is-bad');
					}
				} catch {
					states[i].textContent = 'Failed';
					states[i].classList.add('is-bad');
				}
			}
			send.disabled = false;
			if (sent) {
				files.value = '';
				send.textContent = sent === chosen.length ? 'Sent. Add more?' : 'Send for review';
			}
		});
	}
</script>
