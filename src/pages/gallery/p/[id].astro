---
import GrandPrixLayout from '../../../layouts/GrandPrixLayout.astro';
import { GALLERY_ALBUMS, albumLabel } from '../../../lib/gallery/albums';
import { getPhotoById, readGalleryIndex } from '../../../lib/gallery/store';
import type { GalleryClientConfig } from '../../../lib/gallery/types';

import { getGallerySocial } from '../../../lib/accounts/photo-stats';

export const prerender = false;

const { id } = Astro.params;
const photo = id ? await getPhotoById(id) : undefined;

if (!photo) {
	return Astro.redirect('/gallery');
}

const index = await readGalleryIndex();
const siteOrigin = Astro.site?.origin ?? 'https://www.racquetballgp.com';
const titleBit = photo.caption || albumLabel(photo.album);
const description = `${titleBit} — Florida Racquetball Grand Prix 2026 photo gallery.`;
// Same-origin preview URL — Messages/Facebook often ignore cross-origin Blob og:image
const ogImage = `${siteOrigin}/api/gallery/og/${photo.id}`;

const social = await getGallerySocial(Astro.request, Astro.cookies);
const clientConfig: GalleryClientConfig = {
	...social,
	photos: index.photos.filter((p) => p.album === photo.album),
	albums: GALLERY_ALBUMS,
	initialOpenId: photo.id,
	initialAlbum: photo.album,
	siteOrigin,
	mode: 'collection',
};
---

<GrandPrixLayout
	title={`${titleBit} | Gallery`}
	description={description}
	ogImage={ogImage}
	ogImageWidth={1200}
	ogImageHeight={630}
	hideSponsorSpotlight
>
	<section class="gallery-page" aria-labelledby="gallery-heading">
		<div class="gallery-page-inner">
			<header class="gallery-subhead">
				<p class="gallery-kicker">Shared photo</p>
				<h1 id="gallery-heading" class="gallery-title">{titleBit}</h1>
				<p class="gallery-sub">
					<a href="/gallery">Back to full gallery</a>
				</p>
			</header>

			<div class="gallery-toolbar">
				<button type="button" class="gallery-select-toggle" id="gallery-select-toggle" aria-pressed="false">
					Select
				</button>
			</div>

			<div class="gallery-select-bar" id="gallery-select-bar" hidden>
				<span id="gallery-select-count">0 selected</span>
				<button type="button" class="gallery-share-selected" id="gallery-share-selected" disabled>
					Share selected
				</button>
				<button type="button" class="gallery-cancel-select" id="gallery-cancel-select">Cancel</button>
			</div>

			<p class="gallery-empty" id="gallery-empty" hidden></p>
			<div class="gallery-grid" id="gallery-grid"></div>
			<div class="gallery-more-wrap" id="gallery-more-wrap" hidden>
				<button type="button" class="gallery-load-more" id="gallery-load-more">Load more</button>
			</div>
		</div>
	</section>

	<div
		class="gallery-lightbox glb"
		id="gallery-lightbox"
		hidden
		aria-hidden="true"
		role="dialog"
		aria-modal="true"
		aria-label="Expanded photo"
	>
		<button type="button" class="glb-close" id="gallery-lb-close" aria-label="Close">×</button>
		<div class="glb-post">
			<div class="glb-media" id="gallery-lb-media">
				<button type="button" class="glb-nav glb-prev" id="gallery-lb-prev" aria-label="Previous photo">‹</button>
				<span class="glb-frame">
					<img id="gallery-lb-img" class="glb-photo" src="" alt="" />
					<img class="gallery-watermark gallery-watermark--gp" src="/images/website-logo.webp" alt="" />
					<img class="gallery-watermark gallery-watermark--credit" src="/images/daniel-bray-photography.png" alt="" />
				</span>
				<button type="button" class="glb-nav glb-next" id="gallery-lb-next" aria-label="Next photo">›</button>
			</div>
			<aside class="glb-side">
				<header class="glb-head">
					<img class="glb-brand" src="/images/series-logo.webp" alt="" width="40" height="50" />
					<div class="glb-head-text">
						<span class="glb-album" id="gallery-lb-album">Racquetball Grand Prix</span>
						<span class="glb-date" id="gallery-lb-date"></span>
					</div>
					<div class="glb-admin" id="gallery-lb-admin" hidden></div>
				</header>
				<div class="glb-people" id="gallery-lb-people" hidden></div>
				<div class="glb-body" id="gallery-lb-body">
					<p class="glb-caption" id="gallery-lb-caption"></p>
					<div class="glb-comments" id="gallery-lb-comments"></div>
				</div>
				<div class="glb-actions">
					<div class="glb-action-row">
						<button type="button" class="glb-act glb-act--like" id="gallery-lb-like" aria-pressed="false">Like</button>
						<button type="button" class="glb-act" id="gallery-lb-comment-btn">Comment</button>
						<button type="button" class="glb-act" id="gallery-lb-share">Share</button>
						<button type="button" class="glb-act" id="gallery-lb-download">Download</button>
					</div>
					<div class="glb-likers" id="gallery-lb-likers"></div>
					<span class="glb-views" id="gallery-lb-views" aria-live="polite"></span>
				</div>
				<form class="glb-compose" id="gallery-lb-compose">
					<input class="glb-input" id="gallery-lb-input" name="body" maxlength="500" placeholder="Add a comment…" autocomplete="off" />
					<button class="glb-post-btn" type="submit">Post</button>
					<p class="glb-compose-note" id="gallery-lb-compose-note" hidden></p>
				</form>
			</aside>
		</div>
	</div>

	<div class="gallery-share-menu" id="gallery-share-menu" hidden role="dialog" aria-label="Share options">
		<button type="button" data-share="facebook">Facebook</button>
		<button type="button" data-share="x">X</button>
		<button type="button" data-share="copy">Copy link</button>
		<button type="button" data-share="close">Close</button>
	</div>

	<script is:inline define:vars={{ clientConfig }}>
		window.__GP_GALLERY__ = clientConfig;
	</script>
	<script src="../../../scripts/gallery-client.ts"></script>
</GrandPrixLayout>
