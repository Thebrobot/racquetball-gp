---
import GrandPrixLayout from '../layouts/GrandPrixLayout.astro';
import { accountsConfigured, createSessionClient, getSession } from '../lib/accounts/supabase';
import { eventFollowPlayers } from '../lib/accounts/follow-players';
import { getAllPlayers } from '../data/players';
import { EVENTS } from '../data/events';
import { albumLabel } from '../lib/gallery/albums';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

const configured = accountsConfigured();
const session = configured ? await getSession(Astro.request, Astro.cookies) : null;
const params = Astro.url.searchParams;
let next = params.get('next') ?? '/account';
if (!next.startsWith('/') || next.startsWith('//')) next = '/account';
const sent = params.get('sent') === '1';
const resetSent = params.get('reset') === '1';
const showForgot = params.get('forgot') === '1';
const saved = params.get('saved') === '1';
const passwordSaved = params.get('password') === 'saved';
const notifySaved = params.get('notify') === 'saved';
const notifyEmail = session?.profile?.notify_email ?? true;
const marketingOptIn = session?.profile?.marketing_opt_in ?? false;
const notifyResults = session?.profile?.notify_results ?? true;
// The tournament to offer for following: the one on now (with a day either side), else the next one.
const today = new Date();
const dayMs = 86_400_000;
const liveEvent = EVENTS.find((e) => {
	const start = new Date(`${e.startDate}T00:00:00-04:00`).getTime() - dayMs;
	const end = new Date(`${e.endDate}T23:59:59-04:00`).getTime() + dayMs;
	return today.getTime() >= start && today.getTime() <= end;
});
const followEvent = liveEvent ?? [...EVENTS].filter((e) => new Date(`${e.startDate}T00:00:00-04:00`).getTime() > today.getTime()).sort((a, b) => a.startDate.localeCompare(b.startDate))[0] ?? null;
const claimFlag = params.get('claim') ?? '';

type Claim = { id: string; player_slug: string; player_name: string; status: string; created_at: string };
let claims: Claim[] = [];
if (session) {
	const client = createSessionClient(Astro.request, Astro.cookies)!;
	const { data } = await client
		.from('profile_claims')
		.select('id, player_slug, player_name, status, created_at')
		.eq('user_id', session.user.id)
		.order('created_at', { ascending: false })
		.limit(5);
	claims = (data as Claim[] | null) ?? [];
}
type Submission = { id: string; album: string; caption: string | null; url: string; status: string; note: string | null; photo_id: string | null; created_at: string };
let mySubmissions: Submission[] = [];
if (session) {
	const client = createSessionClient(Astro.request, Astro.cookies)!;
	const { data } = await client.from('photo_submissions').select('id, album, caption, url, status, note, photo_id, created_at').eq('user_id', session.user.id).order('created_at', { ascending: false }).limit(30);
	mySubmissions = (data as Submission[] | null) ?? [];
}
const pendingClaim = claims.find((c) => c.status === 'pending') ?? null;
const rejectedClaim = !pendingClaim && !session?.profile?.player_slug ? claims.find((c) => c.status === 'rejected') : null;
const players = getAllPlayers();
const followPlayers = followEvent ? eventFollowPlayers(followEvent) : players.map((p) => ({ name: p.name, slug: p.slug }));
const linkedPlayer = session?.profile?.player_slug ? players.find((p) => p.slug === session.profile!.player_slug) : null;
const displayName = session?.profile?.display_name ?? session?.user.email?.split('@')[0] ?? '';

const linkedJustNow = params.get('linked');
const linkedJustNowPlayer = linkedJustNow ? players.find((p) => p.slug === linkedJustNow) : null;
const claimMessages: Record<string, string> = {
	sent: 'Claim sent. Kyle will review it and you will see the badge here once it is approved.',
	pending: 'You already have a claim waiting for review.',
	invalid: 'That player was not found. Pick a name from the list.',
	error: 'Could not send the claim. Try again in a moment.',
	taken: 'That player profile is already claimed by another account. Pick a different name, or stay set up as a fan.',
};
---

<GrandPrixLayout title="Your account | Florida Racquetball Grand Prix" description="Sign in to like photos and claim your player profile." noindex hideSponsorSpotlight>
	<header class="gp-page-head">
		<div class="gp-page-head-inner">
			<div>
				<p class="section-label">Players and fans</p>
				<h1 class="gp-title">{session ? 'Your ' : 'Sign '}<span>{session ? 'account' : 'in'}</span></h1>
				<p class="gp-sub">
					{session
						? 'Like photos, keep your name on them, and link this account to your player profile.'
						: 'Sign in with your email and password, or create a free account in a minute.'}
				</p>
			</div>
		</div>
	</header>

	<section class="gp-band gp-band--tight acct">
		<div class="gp-band-inner gp-band-inner--narrow">
			{!configured && (
				<div class="gp-card acct-card">
					<p class="acct-msg acct-msg--warn">Accounts are not set up on this deployment yet.</p>
				</div>
			)}

			{configured && !session && (
				<div class="gp-card acct-card">
					{sent ? (
						<>
							<h2 class="acct-h2">Check your email</h2>
							<p class="acct-p">We sent a sign-in link. Open it on this device to finish signing in. It works once and expires in an hour.</p>
							<p class="acct-p acct-p--muted">Nothing there? Check spam, or <a class="acct-link" href="/account">try again</a>.</p>
						</>
					) : resetSent ? (
						<>
							<h2 class="acct-h2">Check your email</h2>
							<p class="acct-p">If that address has an account, a password reset link is on its way. Open it on this device and choose a new password.</p>
							<p class="acct-p acct-p--muted"><a class="acct-link" href="/account">Back to sign in</a></p>
						</>
					) : showForgot ? (
						<form class="acct-form" id="acct-forgot" novalidate>
							<h2 class="acct-h2">Forgot password</h2>
							<p class="acct-p acct-p--muted">Enter your email and we will send a link to set a new one.</p>
							<label class="acct-label" for="acct-forgot-email">Email address</label>
							<input class="acct-input" id="acct-forgot-email" name="email" type="email" inputmode="email" autocomplete="email" required placeholder="you@example.com" />
							<button class="btn-main acct-btn acct-btn--full" type="submit">Send reset link</button>
							<p class="acct-p acct-p--muted acct-error" id="acct-forgot-error" hidden></p>
							<p class="acct-p acct-p--muted"><a class="acct-link" href="/account">Back to sign in</a></p>
						</form>
					) : (
						<>
							<form class="acct-form" id="acct-password-signin" novalidate>
								<input type="hidden" name="next" value={next} />
								<label class="acct-label" for="acct-email">Email address</label>
								<input class="acct-input" id="acct-email" name="email" type="email" inputmode="email" autocomplete="email" required placeholder="you@example.com" />
								<label class="acct-label" for="acct-password">Password</label>
								<input class="acct-input" id="acct-password" name="password" type="password" autocomplete="current-password" required />
								<button class="btn-main acct-btn acct-btn--full" type="submit">Sign in</button>
								<p class="acct-p acct-p--muted acct-error" id="acct-error" hidden></p>
								<p class="acct-row-links acct-row-links--center">
									<a href={`/account?forgot=1`}>Forgot password?</a>
								</p>
							</form>
							<div class="acct-divider">New here?</div>
							<a class="btn-ghost acct-btn acct-btn--full acct-btn--create" href={`/signup?next=${encodeURIComponent(next)}`}>Create an account</a>
							<form class="acct-form acct-form--alt" id="acct-signin" novalidate>
								<input type="hidden" name="next" value={next} />
								<p class="acct-p acct-p--muted" style="margin:0;">
									Have an account but no password handy? Enter your email above and we will send a one-time sign-in link for this device.
								</p>
								<button class="acct-textbtn" type="submit" id="acct-magic-btn">Email me a sign-in link</button>
								<p class="acct-p acct-p--muted acct-error" id="acct-magic-error" hidden></p>
							</form>
						</>
					)}
				</div>
			)}

			{configured && session && (
				<>
					<div class="gp-card acct-card">
						<div class="acct-row">
							<div>
								<h2 class="acct-h2">{displayName}</h2>
								<p class="acct-p acct-p--muted">{session.user.email}</p>
							</div>
							<div class="acct-badges">
								{linkedPlayer && <span class="gp-pill gp-pill--done">Verified player</span>}
								{!linkedPlayer && !pendingClaim && <span class="gp-pill">Fan</span>}
								{!linkedPlayer && pendingClaim && <span class="gp-pill gp-pill--next">Claim pending</span>}
								{session.isAdmin && <span class="gp-pill gp-pill--champ">Admin</span>}
							</div>
						</div>
						<form class="acct-form acct-form--inline" method="post" action="/api/account">
							<label class="acct-label" for="acct-name">Display name</label>
							<div class="acct-inline">
								<input class="acct-input" id="acct-name" name="display_name" type="text" maxlength="60" minlength="2" required value={displayName} />
								<button class="btn-ghost acct-btn" type="submit">Save</button>
							</div>
							{saved && <p class="acct-p acct-ok">Saved.</p>}
							{passwordSaved && <p class="acct-p acct-ok">Password updated.</p>}
						</form>
						<p class="acct-p acct-p--muted" style="margin:12px 0 0;"><a class="acct-link" href="/account/password">Change password →</a></p>
					</div>

					<div class="gp-card acct-card" id="notifications">
						<h2 class="acct-h2">Notifications</h2>
						<p class="acct-p acct-p--muted">When someone tags you, comments on your photo, or your claim is approved, you hear right away. Likes arrive as one roll-up at the end of the day, only on days you got some.</p>
						<form class="acct-form acct-form--inline" method="post" action="/api/account/notify">
							<label class="acct-switch">
								<input type="checkbox" name="notify_email" checked={notifyEmail} />
								<span class="acct-switch-track" aria-hidden="true"></span>
								<span class="acct-switch-text"><strong>Activity email</strong><span>Tags, comments, claim approvals and the likes roll-up, to {session.user.email}</span></span>
							</label>
							{linkedPlayer && (
								<label class="acct-switch" style="margin-top:10px;">
									<input type="checkbox" name="notify_results" checked={notifyResults} />
									<span class="acct-switch-track" aria-hidden="true"></span>
									<span class="acct-switch-text"><strong>My results</strong><span>Each of your match results as it is posted during a tournament.</span></span>
								</label>
							)}
							<label class="acct-switch" style="margin-top:10px;">
								<input type="checkbox" name="marketing_opt_in" checked={marketingOptIn} />
								<span class="acct-switch-track" aria-hidden="true"></span>
								<span class="acct-switch-text"><strong>Grand Prix news</strong><span>Results, upcoming stops and announcements. Optional.</span></span>
							</label>
							<div class="acct-inline" style="margin-top:8px;">
								<button class="btn-ghost acct-btn" type="submit">Save</button>
								{notifySaved && <p class="acct-p acct-ok" style="margin:0;align-self:center;">Saved.</p>}
							</div>
						</form>
						<div class="acct-push" id="acct-push" hidden>
							<div class="acct-switch-text acct-push-text"><strong>Browser notifications</strong><span id="acct-push-status">Checking…</span></div>
							<button class="btn-ghost acct-btn" type="button" id="acct-push-btn">Turn on</button>
							<p class="acct-p acct-p--muted acct-error" id="acct-push-error" hidden></p>
						</div>
					</div>

					<div class="gp-card acct-card" id="photos">
						<div class="acct-row">
							<h2 class="acct-h2">Your photos</h2>
							<a class="btn-ghost acct-btn" href="/gallery#add">Add photos</a>
						</div>
						{mySubmissions.length === 0 ? (
							<p class="acct-p acct-p--muted">Send photos from the gallery with "+ Add photos". Each one is reviewed before it appears{linkedPlayer ? ', then it also shows on your player profile' : ''}.</p>
						) : (
							<ul class="acct-subs">
								{mySubmissions.map((s) => (
									<li class="acct-sub">
										<img src={`/_image?href=${encodeURIComponent(s.url)}&w=160&h=160&fit=cover&f=webp&q=70`} alt="" width="56" height="56" loading="lazy" />
										<div class="acct-sub-main">
											<span class="acct-sub-title">{albumLabel(s.album)}{s.caption ? ` · ${s.caption}` : ''}</span>
											<span class="acct-sub-meta">
												{s.status === 'approved' && s.photo_id ? <a href={`/gallery/p/${s.photo_id}`}>In the gallery ↗</a> : s.status === 'rejected' ? `Not added${s.note ? `: ${s.note}` : ''}` : 'Waiting for review'}
											</span>
										</div>
										<span class:list={['gp-pill', s.status === 'approved' ? 'gp-pill--done' : s.status === 'rejected' ? 'gp-pill--champ' : 'gp-pill--next']}>{s.status}</span>
									</li>
								))}
							</ul>
						)}
					</div>

					<div class="gp-card acct-card" id="follow">
						<h2 class="acct-h2">Live results</h2>
						<p class="acct-p acct-p--muted">Follow players to hear each of their results as the brackets update, by push and email. Follow a tournament to get every result from it as a push notification.</p>
						{followEvent && (
							<label class="acct-switch">
								<input type="checkbox" id="acct-follow-event" data-kind="event" data-key={followEvent.slug} />
								<span class="acct-switch-track" aria-hidden="true"></span>
								<span class="acct-switch-text"><strong>{followEvent.name}</strong><span>{liveEvent ? 'On now' : 'Next stop'} · every result, push only</span></span>
							</label>
						)}
						<div class="acct-follow" style="margin-top:14px;">
							<label class="acct-label" for="acct-follow-input">Follow players{followEvent ? ` in ${followEvent.name}` : ''}</label>
							<div class="acct-follow-combo" id="acct-follow-combo">
								<div class="acct-inline">
									<input
										class="acct-input"
										id="acct-follow-input"
										type="text"
										role="combobox"
										placeholder="Start typing a name…"
										autocomplete="off"
										autocapitalize="words"
										spellcheck="false"
										inputmode="search"
										aria-autocomplete="list"
										aria-expanded="false"
										aria-controls="acct-follow-listbox"
										aria-haspopup="listbox"
									/>
									<button class="btn-ghost acct-btn" type="button" id="acct-follow-add">Follow</button>
								</div>
								<ul class="acct-follow-list" id="acct-follow-listbox" role="listbox" hidden></ul>
								<p class="acct-p acct-p--muted acct-follow-empty" id="acct-follow-empty" hidden>No matching player{followEvent ? ' in this tournament' : ''}.</p>
							</div>
							<div class="acct-chips" id="acct-follow-chips" aria-live="polite"></div>
							<p class="acct-p acct-ok" id="acct-follow-ok" hidden></p>
							<p class="acct-p acct-p--muted acct-error" id="acct-follow-error" hidden></p>
							<script is:inline type="application/json" id="acct-follow-players" set:html={JSON.stringify(followPlayers).replace(/</g, '\\u003c')}></script>
						</div>
					</div>

					<div class="gp-card acct-card">
						<h2 class="acct-h2">Player profile</h2>
						{linkedJustNowPlayer && (
							<p class="acct-p acct-ok">Your account is linked to <a href={`/players/${linkedJustNowPlayer.slug}`}>{linkedJustNowPlayer.name}</a>.</p>
						)}
						{linkedPlayer ? (
							<>
								{!linkedJustNowPlayer && (
									<p class="acct-p">This account is linked to <a href={`/players/${linkedPlayer.slug}`}>{linkedPlayer.name}</a>. Your profile shows a verified badge.</p>
								)}
								{linkedJustNowPlayer && (
									<p class="acct-p">Your profile shows a verified badge. Results, photos and standings use this name.</p>
								)}
							</>
						) : pendingClaim ? (
							<p class="acct-p">
								Your claim for <strong>{pendingClaim.player_name}</strong> is waiting for review. You will see the badge here once it is approved.
							</p>
						) : (
							<>
								<p class="acct-p">You are set up as a fan: you can like photos and follow the season. Play in the Grand Prix? Pick your name and we will link this account to that player profile.</p>
								{claimFlag && claimMessages[claimFlag] && <p class:list={['acct-p', claimFlag === 'sent' ? 'acct-ok' : 'acct-error-text']}>{claimMessages[claimFlag]}</p>}
								{rejectedClaim && <p class="acct-p acct-p--muted">A previous claim for {rejectedClaim.player_name} was not approved. If that was a mistake, send it again with a note.</p>}
								<form class="acct-form" method="post" action="/api/claims">
									<label class="acct-label" for="acct-player">Your name in the player list</label>
									<input class="acct-input" id="acct-player" list="acct-player-list" name="player_name_lookup" placeholder="Start typing your name…" autocomplete="off" />
									<datalist id="acct-player-list">
										{players.map((p) => <option value={p.name} data-slug={p.slug} />)}
									</datalist>
									<input type="hidden" name="player_slug" id="acct-player-slug" value="" />
									<label class="acct-label" for="acct-note">Anything that helps us confirm it is you (optional)</label>
									<input class="acct-input" id="acct-note" name="note" type="text" maxlength="300" placeholder="Club, city, or the division you played" />
									<button class="btn-main acct-btn" type="submit" id="acct-claim-btn" disabled>Link this profile</button>
								</form>
							</>
						)}
					</div>

					<div class="acct-actions">
						{session.isAdmin && <a class="gp-link" href="/admin">Open the admin queue →</a>}
						<a class="gp-link gp-link--muted" href="/gallery">Back to the gallery →</a>
						<form method="post" action="/api/auth/signout"><button class="acct-signout" type="submit">Sign out</button></form>
					</div>
				</>
			)}
		</div>
	</section>
</GrandPrixLayout>

<script>
	// eslint-disable-next-line no-unused-vars
	type BuildBody = (formData: FormData) => unknown;
	// eslint-disable-next-line no-unused-vars
	type OnOk = (payload: Record<string, unknown>) => void;
	function wireJsonForm(formId: string, errorId: string, url: string, build: BuildBody, onOk: OnOk) {
		const form = document.getElementById(formId) as HTMLFormElement | null;
		if (!form) return;
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const errEl = document.getElementById(errorId)!;
			const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
			errEl.hidden = true;
			if (!form.reportValidity()) return;
			if (formId === 'acct-signin') {
				const emailEl = document.getElementById('acct-email') as HTMLInputElement | null;
				if (!emailEl || !emailEl.checkValidity() || !emailEl.value) {
					errEl.textContent = 'Type your email in the field above first.';
					errEl.hidden = false;
					emailEl?.focus();
					return;
				}
			}
			btn.disabled = true;
			const res = await fetch(url, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(build(new FormData(form))),
			});
			const data = (await res.json().catch(() => ({}))) as Record<string, unknown>;
			if (res.ok) {
				onOk(data);
				return;
			}
			errEl.textContent = String(data.message ?? data.error ?? 'Something went wrong.');
			if (data.code === 'no-account') {
				// Point newcomers at sign-up instead of a dead end.
				const a = document.createElement('a');
				a.className = 'acct-link';
				a.href = `/signup?next=${encodeURIComponent(String(new FormData(form).get('next') ?? '/account'))}`;
				a.textContent = 'Create one';
				errEl.append(' ', a, '.');
			}
			errEl.hidden = false;
			btn.disabled = false;
		});
	}

	// Email + password sign-in.
	wireJsonForm(
		'acct-password-signin',
		'acct-error',
		'/api/auth/password-signin',
		(fd) => ({ email: fd.get('email'), password: fd.get('password'), next: fd.get('next') }),
		(data) => {
			window.location.href = String(data.next ?? '/account');
		},
	);

	// One-time link fallback: reuses the email typed above when present.
	wireJsonForm(
		'acct-signin',
		'acct-magic-error',
		'/api/auth/signin',
		(fd) => ({ email: (document.getElementById('acct-email') as HTMLInputElement | null)?.value ?? '', next: fd.get('next') }),
		() => {
			window.location.href = '/account?sent=1';
		},
	);

	// Forgot password.
	wireJsonForm(
		'acct-forgot',
		'acct-forgot-error',
		'/api/auth/forgot',
		(fd) => ({ email: fd.get('email') }),
		() => {
			window.location.href = '/account?reset=1';
		},
	);

	// Claim: resolve the typed name to a slug from the datalist.
	const lookup = document.getElementById('acct-player') as HTMLInputElement | null;
	const slugEl = document.getElementById('acct-player-slug') as HTMLInputElement | null;
	const claimBtn = document.getElementById('acct-claim-btn') as HTMLButtonElement | null;
	const list = document.getElementById('acct-player-list');
	if (lookup && slugEl && claimBtn && list) {
		const sync = () => {
			const typed = lookup.value.trim().toLowerCase();
			const opt = Array.from(list.querySelectorAll('option')).find((o) => o.value.toLowerCase() === typed);
			slugEl.value = opt?.getAttribute('data-slug') ?? '';
			claimBtn.disabled = !slugEl.value;
		};
		lookup.addEventListener('input', sync);
		lookup.addEventListener('change', sync);
	}
</script>

<script>
	import { getPushState, enablePush, disablePush, isIosBrowserTab, pushSupported } from '../scripts/push-client';
	const box = document.getElementById('acct-push');
	const status = document.getElementById('acct-push-status');
	const btn = document.getElementById('acct-push-btn') as HTMLButtonElement | null;
	const err = document.getElementById('acct-push-error');
	if (box && status && btn && err) {
		box.hidden = false;
		const paint = (state: string) => {
			btn.hidden = false;
			if (state === 'on') {
				status.textContent = 'On in this browser';
				btn.textContent = 'Turn off';
			} else if (state === 'denied') {
				status.textContent = 'Blocked in your browser settings';
				btn.hidden = true;
			} else if (state === 'unsupported') {
				status.textContent = isIosBrowserTab() ? 'On iPhone, add this site to your Home Screen first (Share → Add to Home Screen), then turn these on from there.' : 'Not supported in this browser';
				btn.hidden = true;
			} else {
				status.textContent = 'Off in this browser';
				btn.textContent = 'Turn on';
			}
		};
		fetch('/api/push/config', { cache: 'no-store' })
			.then((r) => r.json())
			.then(async (cfg: { enabled?: boolean }) => {
				if (!cfg?.enabled) {
					status.textContent = 'Not available yet';
					btn.hidden = true;
					return;
				}
				paint(pushSupported() ? await getPushState() : 'unsupported');
			})
			.catch(() => (status.textContent = 'Not available yet'));
		btn.addEventListener('click', async () => {
			btn.disabled = true;
			err.hidden = true;
			const current = await getPushState();
			if (current === 'on') {
				paint(await disablePush(true));
			} else {
				const r = await enablePush();
				paint(r.state);
				if (r.error) {
					err.textContent = r.error;
					err.hidden = false;
				}
			}
			btn.disabled = false;
		});
	}
</script>

<script>
	import { exactFollowPlayer, matchFollowPlayers, type FollowPlayer } from '../lib/accounts/follow-players';

	type Follow = { kind: 'player' | 'event'; key: string; name: string };
	const chips = document.getElementById('acct-follow-chips');
	const input = document.getElementById('acct-follow-input') as HTMLInputElement | null;
	const addBtn = document.getElementById('acct-follow-add') as HTMLButtonElement | null;
	const errEl = document.getElementById('acct-follow-error');
	const okEl = document.getElementById('acct-follow-ok');
	const eventBox = document.getElementById('acct-follow-event') as HTMLInputElement | null;
	const listbox = document.getElementById('acct-follow-listbox');
	const emptyEl = document.getElementById('acct-follow-empty');
	const combo = document.getElementById('acct-follow-combo');
	const players: FollowPlayer[] = (() => {
		try {
			return JSON.parse(document.getElementById('acct-follow-players')?.textContent ?? '[]') as FollowPlayer[];
		} catch {
			return [];
		}
	})();
	if (chips && input && addBtn && errEl && listbox && emptyEl) {
		const showErr = (msg: string) => {
			if (okEl) okEl.hidden = true;
			errEl.textContent = msg;
			errEl.hidden = false;
		};
		const showOk = (msg: string) => {
			errEl.hidden = true;
			if (!okEl) return;
			okEl.textContent = msg;
			okEl.hidden = false;
		};
		const post = (body: Record<string, string>) =>
			fetch('/api/follows', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(async (r) => ({ ok: r.ok, data: (await r.json().catch(() => ({}))) as { error?: string } }));
		const paint = (follows: Follow[]) => {
			const playersFollowed = follows.filter((f) => f.kind === 'player');
			chips.innerHTML = playersFollowed.length
				? playersFollowed.map((f) => `<span class="acct-chip"><a href="/players/${encodeURIComponent(f.key)}">${f.name.replace(/</g, '&lt;')}</a><button type="button" class="acct-chip-x" data-key="${f.key}" aria-label="Unfollow ${f.name.replace(/"/g, '&quot;')}">×</button></span>`).join('')
				: '<span class="acct-p acct-p--muted" style="margin:0;">Not following anyone yet.</span>';
			if (eventBox) eventBox.checked = follows.some((f) => f.kind === 'event' && f.key === eventBox.dataset.key);
		};
		const load = () =>
			fetch('/api/follows', { cache: 'no-store' })
				.then((r) => (r.ok ? r.json() : { follows: [] }))
				.then((d: { follows?: Follow[] }) => paint(d.follows ?? []))
				.catch(() => undefined);
		void load();

		let matches: FollowPlayer[] = [];
		let active = -1;
		let open = false;

		const setOpen = (next: boolean) => {
			open = next;
			listbox.hidden = !next;
			input.setAttribute('aria-expanded', next ? 'true' : 'false');
			if (!next) {
				input.removeAttribute('aria-activedescendant');
				active = -1;
			}
		};
		const paintList = () => {
			listbox.innerHTML = matches
				.map((p, i) => `<li role="none"><button type="button" class="acct-follow-opt" role="option" id="acct-follow-opt-${i}" data-slug="${p.slug.replace(/"/g, '&quot;')}" aria-selected="${i === active ? 'true' : 'false'}">${p.name.replace(/</g, '&lt;')}</button></li>`)
				.join('');
		};
		const setActive = (index: number) => {
			active = matches.length ? ((index % matches.length) + matches.length) % matches.length : -1;
			[...listbox.querySelectorAll<HTMLElement>('.acct-follow-opt')].forEach((el, i) => {
				el.setAttribute('aria-selected', i === active ? 'true' : 'false');
				if (i === active) {
					input.setAttribute('aria-activedescendant', el.id);
					el.scrollIntoView({ block: 'nearest' });
				}
			});
		};
		const syncList = () => {
			const q = input.value;
			const typed = q.trim();
			errEl.hidden = true;
			if (!typed) {
				matches = [];
				emptyEl.hidden = true;
				setOpen(false);
				paintList();
				return;
			}
			matches = matchFollowPlayers(players, q);
			emptyEl.hidden = matches.length > 0;
			if (!matches.length) {
				setOpen(false);
				paintList();
				return;
			}
			active = 0;
			setOpen(true);
			paintList();
			setActive(0);
		};
		const keepAboveKeyboard = () => {
			const vv = window.visualViewport;
			if (!combo || !vv) return;
			const covered = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
			combo.style.setProperty('--acct-kb', covered > 80 ? `${Math.round(Math.min(covered, 240))}px` : '0px');
			if (document.activeElement === input && covered > 80) input.scrollIntoView({ block: 'start', behavior: 'auto' });
		};
		const followPlayer = async (player: FollowPlayer | undefined) => {
			errEl.hidden = true;
			if (!player) {
				showErr(emptyEl.textContent || 'No matching player.');
				emptyEl.hidden = false;
				setOpen(false);
				return;
			}
			addBtn.disabled = true;
			const r = await post({ kind: 'player', key: player.slug, action: 'add' });
			addBtn.disabled = false;
			if (!r.ok) {
				showErr(r.data.error ?? 'Could not follow.');
				return;
			}
			input.value = '';
			matches = [];
			emptyEl.hidden = true;
			setOpen(false);
			paintList();
			showOk(`Now following ${player.name}.`);
			void load();
		};
		const chosen = (): FollowPlayer | undefined => {
			if (active >= 0 && matches[active]) return matches[active];
			return exactFollowPlayer(players, input.value) ?? (matches.length === 1 ? matches[0] : undefined);
		};

		input.addEventListener('input', syncList);
		input.addEventListener('focus', () => {
			input.scrollIntoView({ block: 'start', behavior: 'smooth' });
			if (input.value.trim()) syncList();
			keepAboveKeyboard();
		});
		input.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowDown') {
				e.preventDefault();
				if (!open && input.value.trim()) syncList();
				else if (open) setActive(active + 1);
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				if (open) setActive(active - 1);
			} else if (e.key === 'Enter') {
				e.preventDefault();
				void followPlayer(chosen());
			} else if (e.key === 'Escape') {
				if (open) {
					e.preventDefault();
					setOpen(false);
				}
			}
		});
		listbox.addEventListener('mousedown', (e) => e.preventDefault());
		listbox.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.acct-follow-opt');
			if (!btn?.dataset.slug) return;
			const player = matches.find((p) => p.slug === btn.dataset.slug) ?? players.find((p) => p.slug === btn.dataset.slug);
			void followPlayer(player);
		});
		document.addEventListener('pointerdown', (e) => {
			if (!open) return;
			if (combo?.contains(e.target as Node)) return;
			setOpen(false);
		});
		window.visualViewport?.addEventListener('resize', keepAboveKeyboard);
		window.visualViewport?.addEventListener('scroll', keepAboveKeyboard);

		addBtn.addEventListener('click', () => {
			void followPlayer(chosen());
		});
		chips.addEventListener('click', async (e) => {
			const x = (e.target as HTMLElement).closest<HTMLElement>('.acct-chip-x');
			if (!x?.dataset.key) return;
			await post({ kind: 'player', key: x.dataset.key, action: 'remove' });
			if (okEl) okEl.hidden = true;
			void load();
		});
		eventBox?.addEventListener('change', async () => {
			const r = await post({ kind: 'event', key: eventBox.dataset.key ?? '', action: eventBox.checked ? 'add' : 'remove' });
			if (!r.ok) {
				eventBox.checked = !eventBox.checked;
				showErr(r.data.error ?? 'Could not save.');
			}
		});
	}
</script>
