---
import GrandPrixLayout from '../../layouts/GrandPrixLayout.astro';
import { getAllPlayers, getPlayerMatchHistory, getPlayerScheduleEntries, getPlayerGrandPrixStandings, GP_SERIES_POSTS, getPlayerImageSrcSet } from '../../data/players';
import { resolveTeamMembers, type TeamResolveCtx } from '../../lib/resolve-team-members';

export async function getStaticPaths() {
	return getAllPlayers().map((player) => ({ params: { slug: player.slug }, props: { player } }));
}

const { player: routePlayer } = Astro.props;

// Resolve fresh profile data on each render (props from getStaticPaths can be stale in dev).
const allPlayers = getAllPlayers();
const player = allPlayers.find((p) => p.slug === routePlayer.slug) ?? routePlayer;

const bio =
	player.bio ||
	`Grand Prix competitor from ${player.city || 'Florida'}. Focused on steady finishes and building points across every stop.`;
const matchHistory = getPlayerMatchHistory(player.name);
const gpStandings = getPlayerGrandPrixStandings(player.name);
const scheduleEntries = getPlayerScheduleEntries(player.name, player.events ?? []);
const profilePhoto = getPlayerImageSrcSet(player.name, 140);

const wins = matchHistory.filter((m) => m.result === 'win').length;
const losses = matchHistory.filter((m) => m.result === 'loss').length;
const pending = matchHistory.filter((m) => m.result === 'pending').length;

// Best season standing (highest total) for the head card.
const bestStanding = gpStandings[0] ?? null;
const eventsPlayed = new Set(matchHistory.map((m) => m.eventSlug)).size;

// ── Hierarchy split ──────────────────────────────────────────────────────────
// Upcoming/live entries → full ticket cards (current stop)
const upcomingEntries = scheduleEntries.filter(
	(e) => e.eventStatus === 'live' || e.eventStatus === 'upcoming',
);
// Group past match history by event for the Tournament History section
type HistoryGroup = { eventName: string; eventSlug: string; eventDateRange: string; records: typeof matchHistory };
const historyGroupMap = new Map<string, HistoryGroup>();
for (const row of matchHistory) {
	if (!historyGroupMap.has(row.eventSlug)) {
		historyGroupMap.set(row.eventSlug, {
			eventName: row.eventName,
			eventSlug: row.eventSlug,
			eventDateRange: row.eventDateRange,
			records: [],
		});
	}
	historyGroupMap.get(row.eventSlug)!.records.push(row);
}
const historyGroups = Array.from(historyGroupMap.values());

const primaryDivision = player.divisions?.[0] ?? null;
const recordStr = matchHistory.length > 0 ? ` · ${wins}W–${losses}L` : '';
const metaDescription = [
	player.name,
	player.city ?? 'Florida',
	primaryDivision,
	`2026 Florida Racquetball Grand Prix${recordStr}`,
].filter(Boolean).join(' · ');

function parseCourtFromNote(note?: string): { court: string | null; rest: string } {
	if (!note) return { court: null, rest: '' };
	const m = note.match(/\bcourt\s*#?\s*(\w+)/i);
	if (m) {
		const court = m[1];
		const rest = note.replace(m[0], '').replace(/^[,;\s]+|[,;\s]+$/g, '').trim();
		return { court, rest };
	}
	return { court: null, rest: note };
}

function ordinal(n: number): string {
	const s = ['th', 'st', 'nd', 'rd'];
	const v = n % 100;
	return `${n}${s[(v - 20) % 10] ?? s[v] ?? s[0]}`;
}
---

<GrandPrixLayout
	title={`${player.name} | Florida Racquetball Grand Prix 2026`}
	description={metaDescription}
>
	<!-- ── PAGE HEAD ── -->
	<header class="gp-page-head player-head">
		<div class="gp-page-head-inner gp-page-head-inner--split player-head-inner">
			<div class="player-head-copy">
				<p class="section-label">Player profile</p>
				<h1 class="gp-title player-head-name">{player.name} <span class="player-verified" id="player-verified" data-slug={player.slug} hidden title="This player has claimed their profile">✓ Verified</span></h1>
				{player.city && <p class="gp-sub player-head-city">{player.city}</p>}
				<p class="player-bio player-head-bio">{bio}</p>
				{(player.divisions ?? []).length > 0 && (
					<div class="player-divisions-inline player-head-divisions" aria-label="Divisions entered">
						{(player.divisions ?? []).map((division) => (
							<span class="player-div-tag">{division}</span>
						))}
					</div>
				)}
			</div>

			<div class="gp-card player-head-card">
				<div class="player-head-media">
					{profilePhoto ? (
						<img
							class="player-avatar"
							src={profilePhoto.src}
							srcset={profilePhoto.srcSet}
							sizes="140px"
							alt={`${player.name} profile photo`}
							width="140"
							height="140"
							loading="eager"
							decoding="async"
						/>
					) : (
						<div class="player-avatar player-avatar--fallback" aria-hidden="true">
							{player.name
								.split(' ')
								.slice(0, 2)
								.map((part) => part[0])
								.join('')
								.toUpperCase()}
						</div>
					)}
				</div>
				<div class="player-head-facts">
					{matchHistory.length > 0 ? (
						<div class="player-record-row player-head-record" aria-label="Season record">
							<span class="player-record-chip player-record-chip--win">
								<span class="player-record-num">{wins}</span>
								<span class="player-record-label">Win{wins !== 1 ? 's' : ''}</span>
							</span>
							<span class="player-record-chip player-record-chip--loss">
								<span class="player-record-num">{losses}</span>
								<span class="player-record-label">Loss{losses !== 1 ? 'es' : ''}</span>
							</span>
							{pending > 0 && (
								<span class="player-record-chip player-record-chip--pending">
									<span class="player-record-num">{pending}</span>
									<span class="player-record-label">Pending</span>
								</span>
							)}
						</div>
					) : (
						<p class="player-head-norecord">No matches on record yet.</p>
					)}
					{bestStanding ? (
						<a class="player-head-standing" href={`/leaderboard/${bestStanding.divisionId}`}>
							<span class="player-head-standing-label">Season standing · {bestStanding.divisionLabel}</span>
							<span class="player-head-standing-value">
								<strong>{ordinal(bestStanding.place)}</strong>
								<span class="player-head-standing-pts">{bestStanding.total} pts</span>
							</span>
							<span class="player-head-standing-link">View division standings →</span>
						</a>
					) : (
						<p class="player-head-norecord">Not yet on the season leaderboard.</p>
					)}
					{eventsPlayed > 0 && (
						<p class="player-head-events">
							{eventsPlayed}{' '}Grand Prix{' '}{eventsPlayed === 1 ? 'stop' : 'stops'} played
						</p>
					)}
				</div>
			</div>
		</div>
	</header>

	<!-- ── GRAND PRIX POINTS ── -->
	{gpStandings.length > 0 && (
		<section class="gp-band gp-band--court player-band" aria-labelledby="player-gp-points-title">
			<div class="gp-band-inner">
				<header class="player-band-head">
					<p class="section-label">Season points</p>
					<h2 id="player-gp-points-title" class="player-band-title">Grand Prix <span>points</span></h2>
					<p class="gp-sub">Points per lap in every division entered, with the current season finish.</p>
				</header>
				<div class="player-gp-points-grid">
					{gpStandings.map((entry) => (
						<article class="player-gp-points-card">
							<div class="player-gp-points-division">{entry.divisionLabel}</div>
							<dl class="player-gp-points-stats">
								<div class="player-gp-points-stat">
									<dt>Finish</dt>
									<dd>#{entry.place}</dd>
								</div>
								<div class="player-gp-points-stat">
									<dt>Lap 1</dt>
									<dd>{entry.s1}</dd>
								</div>
								<div class="player-gp-points-stat">
									<dt>Lap 2</dt>
									<dd>{entry.s2}</dd>
								</div>
								<div class="player-gp-points-stat player-gp-points-stat--total">
									<dt>Total</dt>
									<dd>{entry.total}</dd>
								</div>
							</dl>
						</article>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- ── UPCOMING SCHEDULE ── -->
	{upcomingEntries.length > 0 && (
	<section class="gp-band player-band" aria-labelledby="player-events-title">
		<div class="gp-band-inner">
			<header class="player-band-head">
				<p class="section-label">Next up</p>
				<h2 id="player-events-title" class="player-band-title">
					{upcomingEntries[0]?.eventName ?? 'Upcoming'}
				</h2>
				{upcomingEntries[0]?.eventDateRange && (
					<p class="gp-sub">{upcomingEntries[0].eventDateRange}</p>
				)}
			</header>
			<div class="player-ticket-grid">
				{upcomingEntries.map((entry) => {
					const { court, rest } = parseCourtFromNote(entry.note);
					const bracketHref = entry.eventSlug && entry.divisionId
						? `/events/${entry.eventSlug}/divisions/${entry.divisionId}`
						: null;
					const teamResolveCtx: TeamResolveCtx = {
						eventName: entry.eventName,
						division: entry.division,
						time: entry.time,
					};
					return (
						<article class="player-ticket">
							<div class="player-ticket-top">
								<div class="player-ticket-time-block">
									<svg class="player-ticket-clock" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"/>
										<path d="M12 7v5l3 3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
									</svg>
									<span class="player-ticket-time">{entry.time}</span>
								</div>
								{court && (
									<span class="player-ticket-court">Court {court}</span>
								)}
							</div>
						<div class="player-ticket-body">
							<div class="player-ticket-division">
								{bracketHref ? (
									<a class="player-ticket-division-link" href={bracketHref}>{entry.division}</a>
								) : entry.division}
							</div>
							<div class="player-ticket-event">
								{entry.eventName}
								{entry.round && <span class="player-ticket-round">{entry.round}</span>}
							</div>
						</div>
						{entry.isRoundRobin && entry.opponents && entry.opponents.length > 0 && (
							<div class="player-ticket-pool">
								<span class="player-ticket-pool-label">Pool</span>
								<ul class="player-ticket-pool-list">
									{entry.opponents.map((opp, i) => {
										const slug = entry.opponentSlugs?.[i];
										if (opp.includes('/')) {
											const members = resolveTeamMembers(opp, allPlayers, teamResolveCtx);
											return (
												<li>
													<span class="player-ticket-team">
														{members.map((m, j) => (
															<>
																{m.slug ? (
																	<a class="player-ticket-opponent-link" href={`/players/${m.slug}`}>{m.name}</a>
																) : (
																	<span>{m.name}</span>
																)}
																{j < members.length - 1 && <span class="player-ticket-team-sep"> / </span>}
															</>
														))}
													</span>
												</li>
											);
										}
										return (
											<li>
												{slug ? (
													<a class="player-ticket-opponent-link" href={`/players/${slug}`}>{opp}</a>
												) : (
													<span class="player-ticket-team">{opp}</span>
												)}
											</li>
										);
									})}
								</ul>
							</div>
						)}
						{!entry.isRoundRobin && entry.opponent && (
							<div class="player-ticket-opponent">
								<span class="player-ticket-vs">vs</span>
								{entry.opponent.includes('/') ? (
									<span class="player-ticket-team">
										{resolveTeamMembers(entry.opponent, allPlayers, teamResolveCtx).map((m, j, arr) => (
											<>
												{m.slug ? (
													<a class="player-ticket-opponent-link" href={`/players/${m.slug}`}>{m.name}</a>
												) : (
													<span>{m.name}</span>
												)}
												{j < arr.length - 1 && <span class="player-ticket-team-sep"> / </span>}
											</>
										))}
									</span>
								) : entry.opponentSlug ? (
									<a class="player-ticket-opponent-link" href={`/players/${entry.opponentSlug}`}>
										{entry.opponent}
									</a>
								) : (
									<span class="player-ticket-team">{entry.opponent}</span>
								)}
							</div>
						)}
							{rest && (
								<div class="player-ticket-note">
									<svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="player-ticket-note-icon">
										<circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5"/>
										<path d="M8 7v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
										<circle cx="8" cy="5.5" r=".75" fill="currentColor"/>
									</svg>
									{rest}
								</div>
							)}
						</article>
					);
				})}
			</div>
		</div>
	</section>
	)}

	<!-- ── TOURNAMENT HISTORY ── -->
	{historyGroups.length > 0 && (
	<section class="gp-band gp-band--navy2 player-band" aria-labelledby="player-matches-title">
		<div class="gp-band-inner">
			<header class="player-band-head player-band-head--row">
				<div>
					<p class="section-label">Results</p>
					<h2 id="player-matches-title" class="player-band-title">Tournament <span>history</span></h2>
				</div>
				{(wins > 0 || losses > 0) && (
					<span class="player-record-summary-inline">
						<strong class="player-record-summary-w">{wins}W</strong>
						{' – '}
						<strong class="player-record-summary-l">{losses}L</strong>
						{pending > 0 && <span class="player-record-summary-p"> · {pending} pending</span>}
					</span>
				)}
			</header>
			{historyGroups.map((group) => (
				<div class="player-history-event-group">
					<div class="player-history-event-group-header">
						<a class="player-history-event-link" href={`/events/${group.eventSlug}`}>
							{group.eventName}
						</a>
						{group.eventDateRange && (
							<span class="player-history-event-date">· {group.eventDateRange}</span>
						)}
					</div>
					<div class="player-history-stack">
						{group.records.map((row) => (
							<article class="player-history-row">
								<div class="player-history-content">
									<div class="player-history-meta">
										<a class="player-history-division-link" href={`/events/${row.eventSlug}/divisions/${row.divisionId}`}>
											{row.divisionLabel}
										</a>
										<span class="player-history-meta-sep">·</span>
										<span>{row.roundLabel}</span>
									</div>
									<div class="player-history-opponent">
										vs <strong>{row.opponent}</strong>
										{row.score && <span class="player-history-score">{row.score}</span>}
									</div>
								</div>
								<div
									class:list={[
										'player-history-badge',
										row.result === 'win' ? 'player-history-badge--win' : '',
										row.result === 'loss' ? 'player-history-badge--loss' : '',
										row.result === 'pending' ? 'player-history-badge--pending' : '',
										row.result === 'bye' ? 'player-history-badge--bye' : '',
										row.result === 'walkover' ? 'player-history-badge--walkover' : '',
									]}
									title={
										row.result === 'bye'
											? 'Bye (does not count as a match win)'
											: row.result === 'walkover'
												? 'Opponent no-show (does not count as a match win)'
												: undefined
									}
								>
									{row.result === 'win'
										? 'W'
										: row.result === 'loss'
											? 'L'
											: row.result === 'bye'
												? 'Bye'
												: row.result === 'walkover'
													? 'WBF'
													: row.result === 'pending'
														? 'P'
														: 'TBD'}
								</div>
							</article>
						))}
					</div>
				</div>
			))}
		</div>
	</section>
	)}

	<!-- ── SERIES WIRE ── -->
	<section class="gp-band player-band" aria-labelledby="player-series-title">
		<div class="gp-band-inner">
			<header class="player-band-head">
				<p class="section-label">Around the series</p>
				<h2 id="player-series-title" class="player-band-title">Series <span>news</span></h2>
			</header>
			<div class="player-series-list">
				{GP_SERIES_POSTS.map((post) => (
					<article class="player-series-card">
						<div class="player-series-date">{post.date}</div>
						{post.href ? (
							<h3 class="player-series-title">
								<a class="player-series-link" href={post.href}>
									{post.title}
								</a>
							</h3>
						) : (
							<h3 class="player-series-title">{post.title}</h3>
						)}
						<p class="player-series-excerpt">{post.excerpt}</p>
					</article>
				))}
			</div>
		</div>
	</section>
</GrandPrixLayout>

<script>
	// Verified badge: profiles are prerendered, so ask the server whether this slug is claimed.
	const badge = document.getElementById('player-verified');
	const slug = badge?.getAttribute('data-slug');
	if (badge && slug) {
		fetch(`/api/players/verified?slug=${encodeURIComponent(slug)}`)
			.then((r) => (r.ok ? r.json() : null))
			.then((d) => {
				if (d?.verified) badge.hidden = false;
			})
			.catch(() => undefined);
	}
</script>

<script type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Person",
	"name": player.name,
	...(player.city ? { "address": { "@type": "PostalAddress", "addressLocality": player.city } } : {}),
	"url": `https://www.racquetballgp.com/players/${player.slug}`,
	"sport": "Racquetball",
	"memberOf": {
		"@type": "SportsOrganization",
		"name": "Florida Racquetball Grand Prix",
		"url": "https://www.racquetballgp.com"
	}
})} />

<style>
/* ── Page head ── */
.player-head-inner {
	align-items: start;
}
.player-head-name {
	overflow-wrap: anywhere;
}
.player-head-city {
	font-size: 18px;
	color: #fff;
	font-weight: 500;
}
.player-head-bio {
	margin: 14px 0 0;
	max-width: 560px;
	color: var(--muted);
}
.player-head-divisions {
	justify-content: flex-start;
	margin-top: 18px;
}

.player-head-card {
	display: grid;
	grid-template-columns: auto minmax(0, 1fr);
	gap: 18px 22px;
	align-items: center;
	padding: 20px 22px;
}
.player-head-media {
	display: flex;
	justify-content: center;
}
.player-head-card :global(.player-avatar) {
	width: 120px;
	height: 120px;
}
.player-head-facts {
	display: flex;
	flex-direction: column;
	gap: 14px;
	min-width: 0;
}
.player-head-record {
	display: flex;
	flex-wrap: wrap;
	gap: 8px;
	margin: 0;
}
.player-head-norecord {
	margin: 0;
	font-size: 14px;
	color: var(--muted);
}
.player-head-standing {
	display: flex;
	flex-direction: column;
	gap: 4px;
	text-decoration: none;
	color: inherit;
	padding: 12px 14px;
	border-radius: 12px;
	background: rgba(255, 255, 255, 0.04);
	border: 1px solid var(--card-border);
	transition: border-color 0.15s, background 0.15s;
}
.player-head-standing:hover {
	border-color: rgba(240, 90, 26, 0.5);
	background: rgba(240, 90, 26, 0.07);
}
.player-head-standing-label {
	font-family: 'Barlow Condensed', sans-serif;
	font-weight: 700;
	font-size: 12px;
	letter-spacing: 0.12em;
	text-transform: uppercase;
	color: var(--muted);
}
.player-head-standing-value {
	display: flex;
	align-items: baseline;
	gap: 10px;
}
.player-head-standing-value strong {
	font-family: 'Barlow Condensed', sans-serif;
	font-weight: 900;
	font-size: 34px;
	line-height: 1;
	color: var(--orange);
}
.player-head-standing-pts {
	font-weight: 600;
	font-size: 15px;
	color: #fff;
}
.player-head-standing-link {
	font-family: 'Barlow Condensed', sans-serif;
	font-weight: 700;
	font-size: 13px;
	letter-spacing: 0.08em;
	text-transform: uppercase;
	color: var(--orange);
}
.player-head-events {
	margin: 0;
	font-size: 13.5px;
	color: var(--muted);
}

/* ── Bands ── */
.player-band-head {
	margin-bottom: clamp(20px, 3vw, 30px);
}
.player-band-head--row {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: 12px 24px;
	flex-wrap: wrap;
}
.player-band-title {
	font-family: 'Barlow Condensed', sans-serif;
	font-weight: 900;
	font-size: clamp(30px, 4vw, 44px);
	line-height: 0.95;
	text-transform: uppercase;
	margin: 0 0 10px;
}
.player-band-title span {
	color: var(--orange);
}
.player-band :global(.player-history-event-group) {
	margin-top: 0;
}
.player-band :global(.player-record-summary-inline) {
	padding-bottom: 12px;
}

@media (max-width: 640px) {
	.player-head-card {
		grid-template-columns: 1fr;
		justify-items: center;
		text-align: center;
		padding: 18px 16px;
	}
	.player-head-record {
		justify-content: center;
	}
	.player-head-standing {
		width: 100%;
		align-items: center;
	}
	.player-head-divisions {
		justify-content: flex-start;
	}
}
	.player-verified {
		display: inline-flex; align-items: center; vertical-align: middle;
		font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 0.26em; letter-spacing: 0.12em;
		color: var(--green); background: rgba(132, 204, 22, 0.12); border: 1px solid rgba(132, 204, 22, 0.4);
		border-radius: 999px; padding: 4px 10px; margin-left: 8px; text-transform: uppercase;
	}
	.player-verified[hidden] { display: none; }
</style>
