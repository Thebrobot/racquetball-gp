---
import GrandPrixLayout from '../layouts/GrandPrixLayout.astro';
import HowItWorksSection from '../components/grand-prix/HowItWorksSection.astro';
import PointsSystemSection from '../components/grand-prix/PointsSystemSection.astro';
import { titleSponsor } from '../data/ocala-sponsors';
---

<GrandPrixLayout
	title="How Points Work | Florida Racquetball Grand Prix"
	description="Grand Prix points for singles, doubles, and mixed doubles: finish positions, team splits, and season standings."
	spotlightLabel="Title sponsor"
	spotlightName={titleSponsor.name}
	spotlightBlurb={titleSponsor.blurb}
	spotlightLogoUrl={titleSponsor.logoUrl}
>
	<div class="page-hero">
		<div class="section-label">Season format</div>
		<h1 class="section-title">Points &amp; <span style="color:var(--orange)">qualification</span></h1>
		<p class="section-sub" style="margin-bottom:0;">
			How the season works from registration through the four tour stops and the tentative early-2027 series
			championship (dates TBD, pending USA Racquetball approval), and exactly how points are awarded at every
			stop.
		</p>
	</div>

	<HowItWorksSection />
	<PointsSystemSection />
</GrandPrixLayout>
